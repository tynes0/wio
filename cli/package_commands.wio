use argonaut;
use common;
use std::console as console;
use std::environment as environment;
use std::fs as fs;
use std::path as path;
use std::platform as platform;
use std::process as process;
use std::result as result;
use std::serialization as serialization;
use std::time as time;

realm SelfHostedPackage {
    fn AddOption(
        parser: ref Argonaut::Parser,
        id: string,
        alias: string,
        fallback: string,
        description: string
    ) -> std::Result<std::ResultUnit> {
        mut argument = Argonaut::Argument(id);
        argument.AddAlias(alias).SetDefaultValue(fallback).SetDescription(description);
        parser.Add?(argument);
        return std::OkUnit();
    }

    fn AddFlag(parser: ref Argonaut::Parser, id: string, alias: string, description: string)
        -> std::Result<std::ResultUnit> {
        mut argument = Argonaut::Argument(id);
        argument.AddAlias(alias).SetDescription(description);
        parser.Add?(argument.Flag?());
        return std::OkUnit();
    }

    fn Parser() -> std::Result<Argonaut::Parser> {
        mut parser = Argonaut::Parser();
        AddOption?(
            ref parser,
            "BUILD-DIR",
            "--build-dir",
            "build",
            "Repo build directory used to configure and stage the package."
        );
        AddOption?(ref parser, "CONFIG", "--config", "Release", "Build configuration used for the package.");
        AddOption?(
            ref parser,
            "OUTPUT-DIR",
            "--output-dir",
            "artifacts\\packages",
            "Directory where the versioned package folder will be written."
        );
        AddOption?(
            ref parser,
            "VERSION-SUFFIX",
            "--version-suffix",
            "",
            "Optional suffix appended to the package name."
        );
        AddOption?(ref parser, "GENERATOR", "--generator", "", "Optional CMake generator override.");
        AddFlag?(
            ref parser,
            "VISUAL-INSTALLER",
            "--visual-installer",
            "Build the Windows visual installer .exe when supported."
        );
        AddFlag?(
            ref parser,
            "NO-VISUAL-INSTALLER",
            "--no-visual-installer",
            "Skip building the Windows visual installer .exe."
        );
        AddOption?(
            ref parser,
            "INNO-COMPILER",
            "--inno-compiler",
            "",
            "Optional path to ISCC.exe used for the Windows visual installer."
        );
        AddFlag?(ref parser, "NO-ZIP", "--no-zip", "Skip creating the .zip archive.");
        AddFlag?(ref parser, "CLEAN", "--clean", "Replace previous package outputs.");
        AddFlag?(ref parser, "HELP", "--help", "Show this help menu.");
        AddFlag?(ref parser, "HELP-SHORT", "-h", "Show this help menu.");
        AddFlag?(ref parser, "VERSION", "--version", "Show the Wio version.");
        AddFlag?(ref parser, "VERSION-SHORT", "-v", "Show the Wio version.");
        return std::Ok<Argonaut::Parser>(parser);
    }

    fn CommandArgs(args: string[]) -> string[] {
        mut values: string[] = ["wio package"];
        mut index = 2usize;
        while (index < args.Count()) {
            values.Push(args[index]);
            index += 1usize;
        }
        return values;
    }

    fn Failure<T>(message: string) -> std::Result<T> {
        return SelfHostedCli::Failure<T>($"Package creation failed: ${message}");
    }

    fn Version(repositoryRoot: string) -> std::Result<string> {
        for line in fs::ReadLines(path::Join(repositoryRoot, "CMakeLists.txt")) {
            let trimmed = line.Trim();
            if (trimmed.StartsWith("VERSION ")) {
                return std::Ok<string>(trimmed.Slice(8usize).Trim());
            }
        }
        return Failure<string>("Could not resolve the Wio version from CMakeLists.txt.");
    }

    fn NormalizeTag(value: string) -> string {
        mut normalized = "";
        mut index = 0usize;
        while (index < value.Count()) {
            let ch = value[index];
            let alphaNumeric = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or
                (ch >= '0' and ch <= '9');
            normalized.Append(alphaNumeric or ch == '.' or ch == '_' or ch == '-' ? value.Slice(index, 1usize) : "-");
            index += 1usize;
        }
        return normalized;
    }

    fn PlatformTag() -> string {
        return platform::OperatingSystemName(platform::CurrentOperatingSystem());
    }

    fn ArchitectureTag() -> string {
        return platform::ArchitectureName(platform::CurrentArchitecture());
    }

    fn PortableBackendRoot() -> string {
        let explicitRoot = environment::Get("WIO_PORTABLE_BACKEND_ROOT", "");
        if (explicitRoot != "" and fs::IsDirectory(path::Join(explicitRoot, "bin"))) {
            return path::Absolute(explicitRoot);
        }
        let compiler = process::FindExecutable(platform::IsWindows() ? "g++.exe" : "g++");
        let archiver = process::FindExecutable(platform::IsWindows() ? "ar.exe" : "ar");
        if (compiler == "" or archiver == "") { return ""; }
        let compilerRoot = path::ParentPath(path::ParentPath(compiler));
        let archiverRoot = path::ParentPath(path::ParentPath(archiver));
        return path::Equivalent(compilerRoot, archiverRoot) ? compilerRoot : "";
    }

    fn CopyPortableBackend(packageRoot: string) -> std::Result<string> {
        let sourceRoot = PortableBackendRoot();
        if (sourceRoot == "") {
            return Failure<string>("Could not resolve a portable backend compiler root. Ensure g++ and ar are on PATH or set WIO_PORTABLE_BACKEND_ROOT.");
        }
        let targetRoot = path::JoinAll([
            packageRoot,
            "toolchains",
            platform::IsWindows() ? "windows-x64-mingw" : "host-backend"
        ]);
        if (fs::Exists(targetRoot) and not fs::RemoveAll(targetRoot)) {
            return Failure<string>($"Could not replace bundled backend: ${targetRoot}");
        }
        if (not fs::EnsureDirectory(targetRoot)) {
            return Failure<string>($"Could not create bundled backend: ${targetRoot}");
        }
        for name in ["bin", "include", "lib", "libexec", "x86_64-w64-mingw32"] {
            let source = path::Join(sourceRoot, name);
            if (fs::Exists(source) and not fs::CopyRecursive(source, path::Join(targetRoot, name))) {
                return Failure<string>($"Could not copy backend subtree: ${source}");
            }
        }
        for name in ["build-info.txt", "COPYING", "COPYING.txt", "LICENSE", "LICENSE.txt"] {
            let source = path::Join(sourceRoot, name);
            if (fs::IsFile(source) and not fs::CopyFileEnsured(source, path::Join(targetRoot, name))) {
                return Failure<string>($"Could not copy backend metadata: ${source}");
            }
        }
        return std::Ok<string>(targetRoot);
    }

    fn PackageTemplate(repositoryRoot: string, name: string) -> std::Result<string> {
        let templatePath = path::JoinAll([repositoryRoot, "tools", "package", name]);
        if (not fs::IsFile(templatePath)) {
            return Failure<string>($"Package template was not found: ${templatePath}");
        }
        return std::Ok<string>(fs::ReadText(templatePath));
    }

    fn Quickstart(packageName: string) -> string {
        let lines: string[] = [
            "# Wio Package Quickstart\n\n",
            $"This packaged toolchain was staged as `${packageName}`.\n\n",
            "## 1. Try the CLI directly\n\n",
            "```powershell\nbin\\wio.exe --help\nbin\\wio.exe env print --wio-root . --shell powershell --add-path\n```\n\n",
            "```sh\n./bin/wio --help\n./bin/wio env print --wio-root . --shell sh --add-path\n```\n\n",
            "## 2. Install\n\nRun `Install-Wio.ps1` on Windows or `install-wio.sh` on POSIX.\n\n",
            "## 3. Create and run a project\n\n",
            "```powershell\nwio project new MyApp --output-dir C:\\Projects --template wio-app\ncd C:\\Projects\\MyApp\nwio project build\nwio project run\n```\n\n",
            "Environment setup is available through `wio env setup`; cleanup uses `wio env remove`.\n"
        ];
        return lines.Join("");
    }

    fn WritePackageFiles(
        repositoryRoot: string,
        packageRoot: string,
        packageName: string,
        version: string,
        config: string,
        buildDirectory: string,
        backendRoot: string
    ) -> std::Result<std::ResultUnit> {
        for pair in [
            "LICENSE|LICENSE",
            "README.md|README.md",
            "docs/WIO_LANGUAGE_DRAFT.md|docs/WIO_LANGUAGE_DRAFT.md",
            "docs/README.md|docs/README.md",
            "docs/WIO_PROJECT_SYSTEM.md|docs/WIO_PROJECT_SYSTEM.md"
        ] {
            let parts = pair.Split("|");
            let source = path::Join(repositoryRoot, parts[0usize]);
            if (fs::IsFile(source) and not fs::CopyFileEnsured(source, path::Join(packageRoot, parts[1usize]))) {
                return Failure<std::ResultUnit>($"Could not copy package document: ${source}");
            }
        }
        let generatedAt = time::UtcNow().ToIso8601();
        let installPowerShell = PackageTemplate?(repositoryRoot, "Install-Wio.ps1");
        let uninstallPowerShell = PackageTemplate?(repositoryRoot, "Uninstall-Wio.ps1");
        let installShell = PackageTemplate?(repositoryRoot, "install-wio.sh");
        let uninstallShell = PackageTemplate?(repositoryRoot, "uninstall-wio.sh");
        let fields: string[] = [
            "  \"name\": " + serialization::QuoteJson(packageName),
            "  \"version\": " + serialization::QuoteJson(version),
            "  \"platform\": " + serialization::QuoteJson(PlatformTag()),
            "  \"architecture\": " + serialization::QuoteJson(ArchitectureTag()),
            "  \"config\": " + serialization::QuoteJson(config),
            "  \"buildDir\": " + serialization::QuoteJson(buildDirectory),
            "  \"packageRoot\": " + serialization::QuoteJson(packageRoot),
            "  \"bundledBackendRoot\": " + serialization::QuoteJson(backendRoot),
            "  \"generatedAtUtc\": " + serialization::QuoteJson(generatedAt)
        ];
        if (not fs::WriteTextEnsured(path::Join(packageRoot, "WIO_PACKAGE_INFO.json"), "{\n" + fields.Join(",\n") + "\n}\n") or
            not fs::WriteText(path::Join(packageRoot, "Install-Wio.ps1"), installPowerShell) or
            not fs::WriteText(path::Join(packageRoot, "Uninstall-Wio.ps1"), uninstallPowerShell) or
            not fs::WriteText(path::Join(packageRoot, "install-wio.sh"), installShell) or
            not fs::WriteText(path::Join(packageRoot, "uninstall-wio.sh"), uninstallShell) or
            not fs::WriteText(path::Join(packageRoot, "QUICKSTART.md"), Quickstart(packageName))) {
            return Failure<std::ResultUnit>("Could not write package metadata or installer scripts.");
        }
        return std::OkUnit();
    }

    fn BuildPackage(args: string[], parser: ref Argonaut::Parser) -> std::Result<i32> {
        let repositoryRoot = SelfHostedCli::FindRepositoryRoot(args[0usize]);
        if (repositoryRoot == "") { return Failure<i32>("Could not resolve the Wio repository root."); }
        let buildDirectory = path::AbsoluteFrom(repositoryRoot, parser.GetStringOr("BUILD-DIR", "build"));
        let outputDirectory = path::AbsoluteFrom(repositoryRoot, parser.GetStringOr("OUTPUT-DIR", "artifacts\\packages"));
        let config = parser.GetStringOr("CONFIG", "Release");
        let version = Version?(repositoryRoot);
        let suffix = NormalizeTag(parser.GetStringOr("VERSION-SUFFIX", ""));
        let packageName = "wio-" + version + "-" + PlatformTag() + "-" + ArchitectureTag() + "-" +
            config.ToLower() + (suffix == "" ? "" : "-" + suffix);
        let packageRoot = path::Join(outputDirectory, packageName);
        let distRoot = path::Join(buildDirectory, "dist");
        let archive = path::Join(outputDirectory, packageName + ".zip");
        if (path::Equivalent(packageRoot, repositoryRoot) or packageRoot == path::RootPath(packageRoot)) {
            return Failure<i32>($"Refusing unsafe package directory: ${packageRoot}");
        }
        if (parser.GetFlag("CLEAN")) {
            if (fs::Exists(packageRoot)) { fs::RemoveAll(packageRoot); }
            if (fs::Exists(archive)) { fs::Remove(archive); }
        }
        if (not fs::EnsureDirectory(outputDirectory)) {
            return Failure<i32>($"Could not create output directory: ${outputDirectory}");
        }
        if (fs::Exists(distRoot) and not fs::RemoveAll(distRoot)) {
            return Failure<i32>($"Could not clean dist directory: ${distRoot}");
        }

        mut configureArgs: string[] = ["-S", repositoryRoot, "-B", buildDirectory, "-DWIO_DIST_DIR=" + distRoot];
        let generator = parser.GetStringOr("GENERATOR", "");
        if (generator != "") { configureArgs.Push("-G"); configureArgs.Push(generator); }
        let configured = SelfHostedCli::Run?("cmake", configureArgs, repositoryRoot);
        if (configured != 0) { return std::Ok<i32>(configured); }
        let built = SelfHostedCli::Run?(
            "cmake", ["--build", buildDirectory, "--target", "wio_dist", "--config", config], repositoryRoot);
        if (built != 0) { return std::Ok<i32>(built); }
        if (fs::Exists(packageRoot) and not fs::RemoveAll(packageRoot)) {
            return Failure<i32>($"Could not replace package root: ${packageRoot}");
        }
        if (not fs::CopyRecursive(distRoot, packageRoot)) {
            return Failure<i32>($"Could not copy staged distribution: ${distRoot}");
        }
        let backendRoot = CopyPortableBackend?(packageRoot);
        WritePackageFiles?(repositoryRoot, packageRoot, packageName, version, config, buildDirectory, backendRoot);

        let bootstrapInstaller = path::Join(outputDirectory, packageName + "-installer.ps1");
        if (platform::IsWindows()) {
            let bootstrap = PackageTemplate?(repositoryRoot, "Bootstrap-Wio.ps1").Replace("__PACKAGE_NAME__", packageName);
            if (not fs::WriteText(bootstrapInstaller, bootstrap)) {
                return Failure<i32>($"Could not write bootstrap installer: ${bootstrapInstaller}");
            }
        }
        if (not parser.GetFlag("NO-ZIP")) {
            let zipped = SelfHostedCli::Run?(
                "cmake", ["-E", "tar", "cf", path::FileName(archive), "--format=zip", packageName], outputDirectory);
            if (zipped != 0) { return std::Ok<i32>(zipped); }
        }

        if (platform::IsWindows() and not parser.GetFlag("NO-VISUAL-INSTALLER")) {
            let script = path::JoinAll([repositoryRoot, "tools", "Build-WioVisualInstaller.ps1"]);
            if (fs::IsFile(script)) {
                mut visualArgs: string[] = ["-ExecutionPolicy", "Bypass", "-File", script, "-Version", version,
                    "-PackageRoot", packageRoot, "-OutputDir", outputDirectory];
                let inno = parser.GetStringOr("INNO-COMPILER", "");
                if (inno != "") { visualArgs.Push("-InnoCompiler"); visualArgs.Push(inno); }
                let visual = SelfHostedCli::Run?("powershell", visualArgs, repositoryRoot);
                if (visual != 0 and parser.GetFlag("VISUAL-INSTALLER")) { return std::Ok<i32>(visual); }
            }
            else if (parser.GetFlag("VISUAL-INSTALLER")) {
                return Failure<i32>("Visual installer script was not found.");
            }
        }

        console::PrintLine!($"Wio package root : ${packageRoot}");
        if (not parser.GetFlag("NO-ZIP")) { console::PrintLine!($"Wio package zip  : ${archive}"); }
        if (platform::IsWindows()) { console::PrintLine!($"Wio installer    : ${bootstrapInstaller}"); }
        let quickstartPath = path::Join(packageRoot, "QUICKSTART.md");
        let portableWio = path::JoinAll([packageRoot, "bin", "wio" + process::ExecutableSuffix()]);
        console::PrintLine!($"Next steps:\n  1. Open ${quickstartPath}\n  2. Run the platform installer script\n  3. Portable use stays available via ${portableWio}");
        return std::Ok<i32>(0);
    }

    fn Execute(args: string[]) -> std::Result<i32> {
        mut parser = Parser?();
        parser.Parse?(CommandArgs(args));
        if (parser.GetFlag("HELP") or parser.GetFlag("HELP-SHORT")) {
            console::Print(parser.Help());
            return std::Ok<i32>(0);
        }
        if (parser.GetFlag("VERSION") or parser.GetFlag("VERSION-SHORT")) {
            return SelfHostedCli::RunNativeVersion(args[0usize]);
        }
        if (parser.GetFlag("VISUAL-INSTALLER") and parser.GetFlag("NO-VISUAL-INSTALLER")) {
            return SelfHostedCli::Failure<i32>(
                "Package options --visual-installer and --no-visual-installer cannot be used together."
            );
        }
        if (parser.GetStringOr("INNO-COMPILER", "") != "" and
            parser.GetFlag("NO-VISUAL-INSTALLER")) {
            return SelfHostedCli::Failure<i32>(
                "Package option --inno-compiler cannot be combined with --no-visual-installer."
            );
        }
        return BuildPackage(args, ref parser);
    }
}
