use project_manifest;
use project_vm;
use std::console as console;
use std::fs as fs;
use std::hash as hash;
use std::path as path;
use std::process as process;
use std::regex as regex;
use std::resource as resource;
use std::result as result;
use std::serialization as serialization;
use std::uuid as uuid;

realm SelfHostedProject {
    fn HasFlag(args: string[], name: string) -> bool {
        for value in args {
            if (value == "--") { break; }
            if (value == name) { return true; }
        }
        return false;
    }

    fn ArgumentsAfterSeparator(args: string[]) -> string[] {
        mut values: string[] = [];
        mut afterSeparator = false;
        mut index = 3usize;
        while (index < args.Count()) {
            if (afterSeparator) {
                values.Push(args[index]);
            }
            else if (args[index] == "--") {
                afterSeparator = true;
            }
            index += 1usize;
        }
        return values;
    }

    fn AppendFrontendArguments(command: ref string[], info: ProjectInfo, extraModuleDirectory: string) {
        if (extraModuleDirectory != "") {
            command.Push("--module-dir");
            command.Push(extraModuleDirectory);
        }
        for directory in info.wioSourceRoots {
            command.Push("--module-dir");
            command.Push(directory);
        }
        for directory in info.wioIncludeDirs {
            command.Push("--include-dir");
            command.Push(directory);
        }
    }

    fn AppendCompilerArguments(command: ref string[], info: ProjectInfo, extraModuleDirectory: string) {
        AppendFrontendArguments(command, info, extraModuleDirectory);
        for directory in info.wioLinkDirs {
            command.Push("--link-dir");
            command.Push(directory);
        }
        for library in info.wioLinkLibraries {
            command.Push("--link-lib");
            command.Push((library.Contains("/") or library.Contains("\\"))
                ? path::AbsoluteFromRaw(info.projectRoot, library)
                : library);
        }
        for source in info.wioNativeSources {
            command.Push("--backend-arg");
            command.Push(source);
        }
        for argument in info.wioBackendArgs {
            command.Push("--backend-arg");
            command.Push(argument);
        }
    }

    fn RunProcess(command: string, args: string[], workingDirectory: string) -> std::Result<i32> {
        let launched = process::Run(command, args, workingDirectory);
        if (launched.IsError()) {
            return std::Err<i32>(launched.ErrorValue());
        }
        return std::Ok<i32>(launched.Value());
    }

    fn OutputUpToDate(output: string, inputs: string[]) -> bool {
        let outputTime = fs::LastWriteTimeRaw(output);
        // GNU file-clock timestamps can be negative. Only -1 means failure.
        if (outputTime == -1i64) { return false; }
        for input in inputs {
            let inputTime = fs::LastWriteTimeRaw(input);
            if (inputTime == -1i64 or inputTime > outputTime) { return false; }
        }
        return true;
    }

    fn ProjectCompilerInputs(info: ProjectInfo, entry: string) -> string[] {
        mut inputs: string[] = [
            info.manifestFile, info.nativeCore, entry,
            path::Join(info.toolchainRoot, "std"),
            path::Join3(info.toolchainRoot, "runtime", "include"),
            info.sdkIncludeDirectory
        ];
        for value in info.wioSourceRoots { inputs.Push(value); }
        for value in info.wioIncludeDirs { inputs.Push(value); }
        for value in info.wioNativeSources { inputs.Push(value); }
        // LastWriteTimeRaw already scans directory contents recursively.
        for value in info.wioLinkLibraries {
            let candidate = path::AbsoluteFromRaw(info.projectRoot, value);
            if (fs::IsFile(candidate)) { inputs.Push(candidate); }
        }
        if (info.runtimeStaticLibrary != "") { inputs.Push(info.runtimeStaticLibrary); }
        return inputs;
    }

    fn SameOutputPath(left: string, right: string) -> bool
    {
        if (path::Equivalent(left, right)) return true;

        if (process::ExecutableSuffix() == ".exe")
        {
            return path::AbsoluteRaw(left).ToLower() == path::AbsoluteRaw(right).ToLower();
        }

        return false;
    }

    fn ValidateVmProject(info: ProjectInfo) -> std::UnitResult
    {
        if (info.wioTarget != "exe" and not fs::IsFile(path::Join(VmRuntimePackage(info), "WioVmRuntimeConfig.cmake")))
        {
            return Failure<std::ResultUnit>("VM library builds require an installed WioVmRuntime. Set vm.runtimePrefix to its prefix; its C++ toolchain and configuration must match the wrapper/host.");
        }

        if (info.wioTarget == "exe" and not fs::IsFile(info.vmRunner))
        {
            return Failure<std::ResultUnit>($"The standalone VM runner is missing: ${info.vmRunner}. Install or build wio-vm beside wio.");
        }

        mut outputs: string[] = [info.vmBytecodeOutput, info.vmBridgeOutput, VmBytecodeCandidate(info),
            VmBytecodeCandidate(info) + ".publish", VmBytecodeCandidate(info) + ".build-args"];
        outputs.Push(info.wioTarget == "exe" ? info.vmExecutableOutput : info.vmModuleOutput);
        if (info.hostEnabled) { outputs.Push(info.vmHostOutput); }

        let protectedInputs: string[] = [info.wioEntry, info.manifestFile, info.nativeCore, info.vmRunner,
            info.vmStandardNativeLibrary, info.vmStandardNativeCatalog, info.wioOutput, info.hostOutput];
        mut index = 0usize;
        while (index < outputs.Count())
        {
            for input in protectedInputs
            {
                if (SameOutputPath(outputs[index], input))
                {
                    return Failure<std::ResultUnit>($"VM output collides with a source, toolchain or native output: ${outputs[index]}");
                }

            }

            mut other = index + 1usize;
            while (other < outputs.Count())
            {
                if (SameOutputPath(outputs[index], outputs[other]))
                {
                    return Failure<std::ResultUnit>($"VM artifact outputs must be distinct: ${outputs[index]}");
                }

                other += 1usize;
            }

            index += 1usize;
        }

        return std::OkUnit();
    }

    fn BytecodeCompilerInputs(info: ProjectInfo) -> string[]
    {
        mut inputs: string[] = [info.manifestFile, info.nativeCore, info.wioEntry];
        for source in FilesWithExtensions([path::Join(info.toolchainRoot, "std")], [".wio"])
        {
            inputs.Push(source);
        }

        // Module roots may contain the build directory. Track source files, not
        // directory timestamps that include our own bytecode/package outputs.
        for source in FilesWithExtensions(info.wioSourceRoots, [".wio"])
        {
            inputs.Push(source);
        }

        // Relative imports beside the entry remain legal even when the
        // manifest supplies a different explicit module search root.
        for source in FilesWithExtensions([path::ParentPath(info.wioEntry)], [".wio"])
        {
            if (not inputs.Contains(source)) inputs.Push(source);
        }

        return inputs;
    }

    fn VmBytecodeCandidate(info: ProjectInfo) -> string
    {
        // Keep the final filename: it determines the logical bytecode module name.
        return path::Join3(path::ParentPath(info.vmBytecodeOutput), ".vm-bytecode-stage",
            path::FileName(info.vmBytecodeOutput));
    }

    fn VmBytecodeArguments(info: ProjectInfo, noBuiltin: bool, output: string) -> string[]
    {
        mut arguments: string[] = [info.wioEntry, "--target", "exe", "--emit-bytecode",
            "--bytecode-output", output];
        AppendFrontendArguments(ref arguments, info, "");
        if (noBuiltin) arguments.Push("--no-builtin");
        return arguments;
    }

    fn VmBytecodeSignature(info: ProjectInfo, noBuiltin: bool) -> string
    {
        let arguments = VmBytecodeArguments(info, noBuiltin, info.vmBytecodeOutput);
        mut signature = serialization::QuoteJson(info.config) + "\n";
        for argument in arguments
        {
            signature += serialization::QuoteJson(argument) + "\n";
        }

        for input in BytecodeCompilerInputs(info)
        {
            signature += serialization::QuoteJson(input) + "\n";
            if (fs::IsFile(input)) signature += hash::Sha256(fs::ReadTextRaw(input)) + "\n";
        }

        return signature;
    }

    fn PrepareVmBytecode(info: ProjectInfo, forceRebuild: bool, noBuiltin: bool, working: string) -> std::Result<i32>
    {
        let signature = VmBytecodeSignature(info, noBuiltin);
        let candidate = VmBytecodeCandidate(info);
        let signatureFile = candidate + ".build-args";
        if (not forceRebuild)
        {
            let cached = fs::ReadText(candidate);
            let metadata = fs::ReadText(signatureFile);
            if (cached.IsOk() and metadata.IsOk() and
                metadata.Value() == signature + "bytecode:" + hash::Sha256(cached.Value()))
            {
                fs::WriteText?(working, cached.Value());
                console::PrintLine!("Project VM bytecode: up to date, skipping compiler invocation.");
                return std::Ok<i32>(0);
            }
        }

        let compiled = RunProcess?(info.nativeCore, VmBytecodeArguments(info, noBuiltin, working), info.projectRoot);
        if (compiled != 0) return std::Ok<i32>(compiled);
        if (VmBytecodeSignature(info, noBuiltin) != signature)
        {
            return Failure<i32>("Project inputs changed during bytecode compilation; retry the build.");
        }

        // Each invocation owns its working module. A concurrent cache update
        // can only cause a benign miss: metadata includes the exact byte digest.
        if (fs::EnsureDirectory(path::ParentPath(candidate)).IsOk())
        {
            let cacheCopy = working + ".cache";
            let cacheMetadata = working + ".signature";
            if (fs::CopyFile(working, cacheCopy).IsOk() and fs::ReplaceFileAtomic(cacheCopy, candidate).IsOk())
            {
                if (fs::WriteText(cacheMetadata, signature + "bytecode:" + hash::Sha256(fs::ReadTextRaw(working))).IsOk())
                {
                    fs::ReplaceFileAtomic(cacheMetadata, signatureFile);
                }
            }
        }
        return std::Ok<i32>(0);
    }

    fn PublishVmBytecode(info: ProjectInfo, working: string) -> std::UnitResult
    {
        if (fs::IsFile(info.vmBytecodeOutput) and
            hash::Sha256(fs::ReadTextRaw(working)) == hash::Sha256(fs::ReadTextRaw(info.vmBytecodeOutput)))
        {
            return std::OkUnit();
        }

        let publication = working + ".publish";
        fs::CopyFile?(working, publication);
        fs::ReplaceFileAtomic?(publication, info.vmBytecodeOutput);
        return std::OkUnit();
    }

    fn CleanupVmBytecodeStage(directory: string)
    {
        fs::TryRemoveAll(directory);
    }

    fn BuildVmStandardWorking(info: ProjectInfo, forceRebuild: bool, noBuiltin: bool, working: string) -> std::Result<i32>
    {
        let bytecodeResult = PrepareVmBytecode?(info, forceRebuild, noBuiltin, working);
        if (bytecodeResult != 0) return std::Ok<i32>(bytecodeResult);
        let supported = process::Capture?(info.vmRunner,
            ["--check-native", working, "--standard-library", info.vmStandardNativeLibrary], info.projectRoot);
        if (supported.exitCode == 0)
        {
            PublishVmBytecode?(info, working);
            console::PrintLine!("Project VM native support: reusing the standard adapter; no project C++ build.");
            return PackageVmExecutable(info, forceRebuild, info.vmStandardNativeLibrary, working);
        }

        console::PrintLine!(supported.text.Trim());
        return std::Ok<i32>(supported.exitCode);
    }

    fn BuildVmStandard(info: ProjectInfo, forceRebuild: bool, noBuiltin: bool) -> std::Result<i32>
    {
        let directory = path::Join3(path::ParentPath(info.vmBytecodeOutput), ".wbc", uuid::NewV4());
        let cleanup = resource::Owned<string>(directory, CleanupVmBytecodeStage);
        fs::EnsureDirectory?(directory);
        let outcome = BuildVmStandardWorking(info, forceRebuild, noBuiltin,
            path::Join(directory, path::FileName(info.vmBytecodeOutput)));
        cleanup.Dispose();
        return outcome;
    }

    fn PackageVmExecutable(info: ProjectInfo, forceRebuild: bool, producer: string, bytecode: string) -> std::Result<i32>
    {
        mut inputs: string[] = [info.manifestFile, info.vmRunner, info.vmBytecodeOutput, producer];
        for library in info.vmNativeLibraries
        {
            inputs.Push(library);
        }

        for library in info.vmRuntimeLibraries
        {
            inputs.Push(library);
        }

        if (not forceRebuild and OutputUpToDate(info.vmExecutableOutput, inputs))
        {
            mut verification: string[] = ["--verify", info.vmExecutableOutput,
                "--expect-instruction-limit", $"${info.vmInstructionLimit}", "--expect-bytecode", bytecode,
                "--expect-native-library", producer];
            for library in info.vmNativeLibraries
            {
                verification.Push("--expect-native-library");
                verification.Push(library);
            }

            for library in info.vmRuntimeLibraries
            {
                verification.Push("--expect-runtime-library");
                verification.Push(library);
            }

            let verified = process::Capture?(info.vmRunner, verification, info.projectRoot);
            if (verified.exitCode == 0)
            {
                console::PrintLine!("Project VM executable: up to date, skipping package invocation.");
                return std::Ok<i32>(0);
            }

            console::PrintLine!("Project VM executable needs repair; packaging the current build outputs.");
        }

        mut arguments: string[] = [
            "--package", bytecode, "--output", info.vmExecutableOutput,
            "--replace", "--version-libraries", "--native-library", producer,
            "--instruction-limit", $"${info.vmInstructionLimit}"
        ];
        for library in info.vmNativeLibraries
        {
            arguments.Push("--native-library");
            arguments.Push(library);
        }

        for library in info.vmRuntimeLibraries
        {
            arguments.Push("--runtime-library");
            arguments.Push(library);
        }

        return RunProcess(info.vmRunner, arguments, info.projectRoot);
    }

    fn BuildResolved(
        info: ProjectInfo,
        forceRebuild: bool,
        emitMode: string,
        irOutput: string,
        noBuiltin: bool,
        cppBackend: string,
        backend: string
    ) -> std::Result<i32> {
        if (not fs::IsFile(info.wioEntry)) {
            return Failure<i32>($"Wio entry file was not found: ${info.wioEntry}");
        }
        if (not fs::TryEnsureDirectory(info.outputDirectory)) {
            return Failure<i32>($"Could not create project output directory: ${info.outputDirectory}");
        }
        if (backend != "native" and backend != "vm") {
            return Failure<i32>($"Unknown project backend '${backend}'. Expected native or vm.");
        }
        if (backend == "vm" and emitMode != "") {
            return Failure<i32>("--backend vm cannot be combined with an explicit emit mode.");
        }
        if (backend == "vm" and cppBackend == "legacy") {
            return Failure<i32>("The VM backend requires canonical Lowered WIR; --cpp-backend legacy is unsupported.");
        }
        if (backend == "vm") {
            ValidateVmProject?(info);
        }

        // Explicit native build inputs retain their established producer path.
        // Ordinary executable projects first compile bytecode, then query the
        // trusted, reusable standard adapter without executing application code.
        if (backend == "vm" and info.wioTarget == "exe" and info.wioNativeSources.Count() == 0usize and
            info.wioLinkLibraries.Count() == 0usize and info.wioBackendArgs.Count() == 0usize and
            info.vmNativeLibraries.Count() == 0usize and (cppBackend == "" or cppBackend == "wir"))
        {
            let standard = BuildVmStandard?(info, forceRebuild, noBuiltin);
            if (standard != 3) return std::Ok<i32>(standard);
            console::PrintLine!("Project VM native support: building a project-specific adapter.");
        }
        let compileTarget = backend == "vm" ? "shared" : info.wioTarget;
        let compileOutput = backend == "vm" ? info.vmBridgeOutput : info.wioOutput;
        mut compileArgs: string[] = [
            info.wioEntry, "--target", compileTarget, "--output", compileOutput
        ];
        AppendCompilerArguments(ref compileArgs, info, "");
        if (noBuiltin) { compileArgs.Push("--no-builtin"); }
        if (cppBackend != "") {
            compileArgs.Push("--cpp-backend");
            compileArgs.Push(cppBackend);
        }
        if (backend == "vm") {
            compileArgs.Push("--native-bridge-only");
            compileArgs.Push("--bytecode-sidecar");
            compileArgs.Push(info.vmBytecodeOutput);
            if (info.wioTarget != "exe")
            {
                compileArgs.Push("--bytecode-sidecar-kind");
                compileArgs.Push("library");
            }
        }
        if (emitMode != "") {
            compileArgs.Push("--intermediate-dir");
            compileArgs.Push(info.outputDirectory);
            if (emitMode == "cpp") { compileArgs.Push("--emit-cpp"); }
            else if (emitMode == "typed-wir") { compileArgs.Push("--emit-typed-wir"); }
            else if (emitMode == "lowered-wir") { compileArgs.Push("--emit-lowered-wir"); }
            else if (emitMode == "bytecode") { compileArgs.Push("--emit-bytecode"); }
            else { return Failure<i32>($"Unknown compiler emission mode: ${emitMode}"); }
            if (irOutput != "") {
                compileArgs.Push(emitMode == "bytecode" ? "--bytecode-output" : "--ir-output");
                compileArgs.Push(path::AbsoluteFromRaw(info.projectRoot, irOutput));
            }
        }
        let compilerInputs = ProjectCompilerInputs(info, info.wioEntry);
        mut outputCurrent = OutputUpToDate(info.wioOutput, compilerInputs);
        if (backend == "vm") {
            outputCurrent = OutputUpToDate(info.vmBytecodeOutput, compilerInputs) and
                OutputUpToDate(info.vmBridgeOutput, compilerInputs);
        }
        mut signature = serialization::QuoteJson(info.config) + "\n";
        for argument in compileArgs
        {
            signature += serialization::QuoteJson(argument) + "\n";
        }

        let signatureFile = compileOutput + ".build-args";
        outputCurrent = outputCurrent and fs::IsFile(signatureFile) and fs::ReadTextRaw(signatureFile) == signature;
        if (emitMode != "" or cppBackend != "" or noBuiltin or forceRebuild or not outputCurrent) {
            if (emitMode == "" and not fs::TryWriteTextEnsured(signatureFile, ""))
            {
                return Failure<i32>($"Could not invalidate project compiler arguments: ${signatureFile}");
            }

            let compileResult = RunProcess?(info.nativeCore, compileArgs, info.projectRoot);
            if (compileResult != 0) { return std::Ok<i32>(compileResult); }
            if (emitMode == "" and not fs::TryWriteTextEnsured(signatureFile, signature))
            {
                return Failure<i32>($"Could not record project compiler arguments: ${signatureFile}");
            }
        }
        else {
            console::PrintLine!("Project Wio compile: up to date, skipping compiler invocation.");
        }
        if (emitMode != "") { return std::Ok<i32>(0); }
        if (backend == "vm")
        {
            return info.wioTarget == "exe" ? PackageVmExecutable(info, forceRebuild, info.vmBridgeOutput, info.vmBytecodeOutput) : BuildVmLibrary(info, forceRebuild);
        }
        if (not info.hostEnabled) { return std::Ok<i32>(0); }

        mut hostArgs: string[] = ["-std=c++20", "-I", info.sdkIncludeDirectory];
        for source in info.hostSourceFiles { hostArgs.Push(source); }
        for directory in info.hostIncludeDirs {
            hostArgs.Push("-I");
            hostArgs.Push(directory);
        }
        for directory in info.hostLinkDirs {
            hostArgs.Push("-L");
            hostArgs.Push(directory);
        }
        for library in info.hostLinkLibraries {
            if (library.StartsWith("-")) {
                hostArgs.Push(library);
            }
            else if (library.Contains("/") or library.Contains("\\") or
                     library.EndsWith(".a") or library.EndsWith(".lib") or
                     library.EndsWith(".so") or library.EndsWith(".dll") or
                     library.EndsWith(".dylib")) {
                hostArgs.Push(path::AbsoluteFromRaw(info.projectRoot, library));
            }
            else {
                hostArgs.Push("-l" + library);
            }
        }
        if (info.wioTarget == "static") {
            if (info.runtimeStaticLibrary == "") {
                return Failure<i32>("The Wio runtime static library could not be resolved.");
            }
            hostArgs.Push(info.wioOutput);
            hostArgs.Push(info.runtimeStaticLibrary);
        }
        if (process::ExecutableSuffix() == ".exe") { hostArgs.Push("-static"); }
        for argument in info.hostCompilerArgs { hostArgs.Push(argument); }
        for argument in info.hostLinkerArgs { hostArgs.Push(argument); }
        hostArgs.Push("-o");
        hostArgs.Push(info.hostOutput);
        mut hostInputs: string[] = [info.manifestFile, info.wioOutput, info.sdkIncludeDirectory];
        for value in info.hostSourceFiles { hostInputs.Push(value); }
        for value in info.hostIncludeDirs { hostInputs.Push(value); }
        if (forceRebuild or not OutputUpToDate(info.hostOutput, hostInputs)) {
            return RunProcess(info.hostCompiler, hostArgs, info.projectRoot);
        }
        console::PrintLine!("Project host compile: up to date, skipping host compiler invocation.");
        return std::Ok<i32>(0);
    }

    fn Check(args: string[]) -> std::Result<i32>
    {
        let info = ResolveInfo?(args);
        if (not fs::IsFile(info.wioEntry))
        {
            return Failure<i32>($"Wio entry file was not found: ${info.wioEntry}");
        }

        let backend = OptionValue(args, "--backend", "native");
        if (backend != "native" and backend != "vm")
        {
            return Failure<i32>($"Unknown project backend '${backend}'. Expected native or vm.");
        }

        mut command: string[] = [info.wioEntry, "--target", info.wioTarget, "--dry-run"];
        AppendFrontendArguments(ref command, info, "");
        let cppBackend = OptionValue(args, "--cpp-backend", "");
        if (cppBackend != "")
        {
            command.Push("--cpp-backend");
            command.Push(cppBackend);
        }

        if (HasFlag(args, "--no-builtin") or HasFlag(args, "-B"))
        {
            command.Push("--no-builtin");
        }

        // No output/cache directories, signatures, native bridge or host build.
        // The compiler checks syntax/semantics and declared header availability;
        // WIR/backend, C++ type checking and linking remain explicit build work.
        return RunProcess(info.nativeCore, command, info.projectRoot);
    }

    fn Build(args: string[]) -> std::Result<i32> {
        let emitCpp = HasFlag(args, "--emit-cpp");
        let emitTypedWir = HasFlag(args, "--emit-typed-wir");
        let emitLoweredWir = HasFlag(args, "--emit-lowered-wir");
        let emitBytecode = HasFlag(args, "--emit-bytecode");
        let emitCount = (emitCpp ? 1i32 : 0i32) +
            (emitTypedWir ? 1i32 : 0i32) +
            (emitLoweredWir ? 1i32 : 0i32) +
            (emitBytecode ? 1i32 : 0i32);
        if (emitCount > 1i32) {
            return Failure<i32>("Choose only one of --emit-cpp, --emit-typed-wir, --emit-lowered-wir, or --emit-bytecode.");
        }
        let irOutput = OptionValue(args, "--ir-output", "");
        let bytecodeOutput = OptionValue(args, "--bytecode-output", "");
        if ((not emitTypedWir and not emitLoweredWir) and irOutput != "") {
            return Failure<i32>("--ir-output requires --emit-typed-wir or --emit-lowered-wir.");
        }
        if (not emitBytecode and bytecodeOutput != "") {
            return Failure<i32>("--bytecode-output requires --emit-bytecode.");
        }
        let emitMode = emitCpp
            ? "cpp"
            : (emitTypedWir ? "typed-wir" : (emitLoweredWir ? "lowered-wir" : (emitBytecode ? "bytecode" : "")));
        return BuildResolved(
            ResolveInfo?(args),
            HasFlag(args, "--rebuild") or HasFlag(args, "--configure"),
            emitMode,
            emitBytecode ? bytecodeOutput : irOutput,
            HasFlag(args, "--no-builtin") or HasFlag(args, "-B"),
            OptionValue(args, "--cpp-backend", ""),
            OptionValue(args, "--backend", "native")
        );
    }

    fn QuoteCommandArgument(value: string) -> string {
        if (value.Contains(" ") or value.Contains("\t") or value.Contains("\"")) {
            return "\"" + value.Replace("\"", "\\\"") + "\"";
        }
        return value;
    }

    fn FormatCommand(command: string, args: string[]) -> string {
        mut values: string[] = [QuoteCommandArgument(command)];
        for argument in args { values.Push(QuoteCommandArgument(argument)); }
        return values.Join(" ");
    }

    fn Run(args: string[]) -> std::Result<i32> {
        let info = ResolveInfo?(args);
        let backend = OptionValue(args, "--backend", "native");
        if (backend != "native" and backend != "vm") {
            return Failure<i32>($"Unknown project backend '${backend}'. Expected native or vm.");
        }
        if (backend == "vm") {
            ValidateVmProject?(info);
            if (info.wioTarget != "exe" and not info.hostEnabled)
            {
                return Failure<i32>("A VM library is not executable. Enable host.enabled or use project build/package.");
            }
        }
        let noBuild = HasFlag(args, "--no-build");
        if (noBuild and (HasFlag(args, "--rebuild") or HasFlag(args, "--configure"))) {
            return Failure<i32>("--no-build cannot be combined with --rebuild or --configure.");
        }
        if (not noBuild) {
            let buildResult = BuildResolved?(
                info,
                HasFlag(args, "--rebuild") or HasFlag(args, "--configure"),
                "",
                "",
                false,
                OptionValue(args, "--cpp-backend", ""),
                backend
            );
            if (buildResult != 0) { return std::Ok<i32>(buildResult); }
        }

        mut executable = "";
        mut runArgs: string[] = [];
        if (backend == "vm") {
            executable = info.wioTarget == "exe" ? info.vmExecutableOutput : info.vmHostOutput;
            let verified = info.wioTarget == "exe"
                ? RunProcess?(info.vmRunner,
                    ["--verify", executable, "--expect-instruction-limit", $"${info.vmInstructionLimit}"], info.projectRoot)
                : VerifyVmLibrary?(info);
            if (verified != 0) { return std::Ok<i32>(verified); }
            if (info.hostEnabled and info.passLibraryPath and info.wioTarget == "shared")
            {
                runArgs.Push(info.vmModuleOutput);
            }
        }
        else if (info.hostEnabled) {
            executable = info.hostOutput;
            if (info.passLibraryPath and info.wioTarget == "shared") { runArgs.Push(info.wioOutput); }
        }
        else if (info.wioTarget == "exe") {
            executable = info.wioOutput;
        }
        if (executable == "") { return Failure<i32>("This project does not define a runnable executable."); }
        if (not fs::IsFile(executable)) {
            return Failure<i32>($"Expected project executable does not exist: ${executable}");
        }
        if (not HasFlag(args, "--no-manifest-args")) {
            for argument in info.runArgs { runArgs.Push(argument); }
        }
        for argument in OptionValues(args, "--arg") { runArgs.Push(argument); }
        for argument in ArgumentsAfterSeparator(args) { runArgs.Push(argument); }

        let workingOverride = OptionValue(args, "--cwd", OptionValue(args, "--working-directory", ""));
        let workingDirectory = workingOverride == ""
            ? info.runWorkingDirectory
            : path::AbsoluteFromRaw(info.projectRoot, workingOverride);
        if (not fs::IsDirectory(workingDirectory)) {
            return Failure<i32>($"Run working directory does not exist: ${workingDirectory}");
        }
        if (HasFlag(args, "--print-command")) {
            let formattedCommand = FormatCommand(executable, runArgs);
            console::PrintLine!($"Working directory: ${workingDirectory}");
            console::PrintLine!($"Command: ${formattedCommand}");
        }
        return RunProcess(executable, runArgs, workingDirectory);
    }

    fn ProjectRelative(info: ProjectInfo, file: string) -> string {
        let relative = path::RelativeRaw(file, info.projectRoot);
        return relative.StartsWith("..") ? file : relative;
    }

    fn TestOutput(info: ProjectInfo, file: string) -> string {
        return path::ChangeExtension(
            path::Join3(info.buildDirectory, "tests", ProjectRelative(info, file)),
            process::ExecutableSuffix()
        );
    }

    fn Test(args: string[]) -> std::Result<i32> {
        let info = ResolveInfo?(args);
        let filter = OptionValue(args, "--filter", "");
        mut selected: string[] = [];
        for file in info.testFiles {
            let display = ProjectRelative(info, file);
            if (filter == "" or regex::IsMatch?(display, filter)) { selected.Push(file); }
        }
        if (HasFlag(args, "--list")) {
            for file in selected { console::PrintLine!(ProjectRelative(info, file)); }
            let selectedCount = selected.Count();
            console::PrintLine!($"${selectedCount} project test(s) matched.");
            return std::Ok<i32>(0);
        }
        if (selected.Empty()) {
            console::PrintLine!(
                "No project tests matched. Add .wio tests under 'tests/' or configure test.files/test.sourceRoots."
            );
            return std::Ok<i32>(0);
        }
        if (not fs::IsDirectory(info.testWorkingDirectory)) {
            return Failure<i32>($"Test working directory does not exist: ${info.testWorkingDirectory}");
        }
        let noBuild = HasFlag(args, "--no-build");
        let forceRebuild = HasFlag(args, "--rebuild") or HasFlag(args, "--configure");
        let cppBackend = OptionValue(args, "--cpp-backend", "");
        mut passed = 0usize;
        for file in selected {
            let display = ProjectRelative(info, file);
            let output = TestOutput(info, file);
            if (not noBuild and
                (cppBackend != "" or forceRebuild or not OutputUpToDate(output, ProjectCompilerInputs(info, file)))) {
                fs::TryEnsureParentDirectory(output);
                mut compileArgs: string[] = [file, "--target", "exe", "--output", output];
                AppendCompilerArguments(ref compileArgs, info, path::ParentPath(file));
                if (cppBackend != "") {
                    compileArgs.Push("--cpp-backend");
                    compileArgs.Push(cppBackend);
                }
                console::PrintLine!($"[ BUILD ] ${display}");
                let compileResult = RunProcess?(info.nativeCore, compileArgs, info.projectRoot);
                if (compileResult != 0) {
                    console::PrintLine!($"[ FAIL  ] ${display} (compile)");
                    return std::Ok<i32>(compileResult);
                }
            }
            if (not fs::IsFile(output)) {
                return Failure<i32>($"Expected project test executable does not exist: ${output}");
            }
            console::PrintLine!($"[ RUN   ] ${display}");
            let testResult = RunProcess?(output, [], info.testWorkingDirectory);
            if (testResult != 0) {
                console::PrintLine!($"[ FAIL  ] ${display} (exit ${testResult})");
                return std::Ok<i32>(testResult);
            }
            passed += 1usize;
            console::PrintLine!($"[ PASS  ] ${display}");
        }
        let selectedCount = selected.Count();
        console::PrintLine!($"${passed}/${selectedCount} project test(s) passed.");
        return std::Ok<i32>(0);
    }

    fn CopyRequired(source: string, target: string) -> std::UnitResult {
        if (not fs::Exists(source)) {
            return Failure<std::ResultUnit>($"Package input does not exist: ${source}");
        }
        if (not fs::TryCopyRecursive(source, target)) {
            return Failure<std::ResultUnit>($"Could not package '${source}' as '${target}'.");
        }
        return std::OkUnit();
    }

    fn Package(args: string[]) -> std::Result<i32> {
        let info = ResolveInfo?(args);
        let backend = OptionValue(args, "--backend", "native");
        if (backend != "native" and backend != "vm") {
            return Failure<i32>($"Unknown project backend '${backend}'. Expected native or vm.");
        }
        if (backend == "vm") { ValidateVmProject?(info); }
        let noBuild = HasFlag(args, "--no-build");
        if (noBuild and (HasFlag(args, "--rebuild") or HasFlag(args, "--configure"))) {
            return Failure<i32>("--no-build cannot be combined with --rebuild or --configure.");
        }
        if (not noBuild) {
            let buildResult = BuildResolved?(
                info,
                HasFlag(args, "--rebuild") or HasFlag(args, "--configure"),
                "",
                "",
                false,
                OptionValue(args, "--cpp-backend", ""),
                backend
            );
            if (buildResult != 0) { return std::Ok<i32>(buildResult); }
        }
        let parentValue = OptionValue(args, "--output-dir", path::Join(info.buildDirectory, "packages"));
        let packageParent = path::AbsoluteFromRaw(info.projectRoot, parentValue);
        let packageRoot = path::Join(packageParent, SafeName(info.name));
        if (path::Equivalent(packageRoot, info.projectRoot) or packageRoot == path::RootPath(packageRoot)) {
            return Failure<i32>($"Refusing to use unsafe package directory: ${packageRoot}");
        }
        if (backend == "vm")
        {
            let verified = info.wioTarget == "exe"
                ? RunProcess?(info.vmRunner,
                    ["--verify", info.vmExecutableOutput, "--expect-instruction-limit", $"${info.vmInstructionLimit}"], info.projectRoot)
                : VerifyVmLibrary?(info);
            if (verified != 0) return std::Ok<i32>(verified);

            mut protectedFiles: string[] = [
                info.manifestFile, info.wioEntry, info.nativeCore, info.vmRunner,
                info.vmExecutableOutput, info.vmBytecodeOutput, info.vmBridgeOutput, info.vmStandardNativeLibrary,
                info.vmStandardNativeCatalog, info.sdkIncludeDirectory
            ];
            protectedFiles.Push(info.vmModuleOutput);
            protectedFiles.Push(info.vmHostOutput);
            protectedFiles.Push(VmProjectDirectory(info));
            protectedFiles.Push(info.vmRuntimePrefix);
            protectedFiles.Push(VmRuntimePackage(info));
            for value in info.packageAssets { protectedFiles.Push(value); }
            for value in info.packageFiles { protectedFiles.Push(value); }
            for value in info.wioSourceRoots { protectedFiles.Push(value); }
            for value in info.wioIncludeDirs { protectedFiles.Push(value); }
            for value in info.wioLinkDirs { protectedFiles.Push(value); }
            for value in info.wioNativeSources { protectedFiles.Push(value); }
            for value in info.vmNativeLibraries { protectedFiles.Push(value); }
            for value in info.vmRuntimeLibraries { protectedFiles.Push(value); }
            for file in protectedFiles
            {
                mut ancestor = fs::IsDirectory(file) ? file : path::ParentPath(file);
                while (ancestor != "")
                {
                    if (SameOutputPath(packageRoot, ancestor))
                    {
                        return Failure<i32>($"Refusing to package over a source, toolchain or VM artifact directory: ${packageRoot}");
                    }

                    let parent = path::ParentPath(ancestor);
                    if (parent == ancestor) break;

                    ancestor = parent;
                }

            }

        }
        if (fs::Exists(packageRoot)) {
            if (not HasFlag(args, "--clean")) {
                return Failure<i32>(
                    $"Package directory already exists: ${packageRoot}. Pass --clean to replace it."
                );
            }
            if (not fs::TryRemoveAll(packageRoot)) {
                return Failure<i32>($"Could not clean package directory: ${packageRoot}");
            }
        }
        if (not fs::TryEnsureDirectory(packageRoot)) {
            return Failure<i32>($"Could not create package directory: ${packageRoot}");
        }

        mut entrypoint = "";
        mut packageArguments: string[] = [];
        mut artifacts: string[] = [];
        if (backend == "vm") {
            if (info.wioTarget == "exe")
            {
                entrypoint = path::Join("bin", path::FileName(info.vmExecutableOutput));
                let deployed = RunProcess?(
                    info.vmRunner, ["--deploy", info.vmExecutableOutput, "--output", path::Join(packageRoot, entrypoint)], info.projectRoot);
                if (deployed != 0) return std::Ok<i32>(deployed);

                artifacts.Push(entrypoint);
            }
            else
            {
                let installed = InstallVmLibrary?(info, packageRoot);
                if (installed != 0) return std::Ok<i32>(installed);

                let library = path::Join("lib", path::FileName(info.vmModuleOutput));
                if (info.hostEnabled)
                {
                    entrypoint = path::Join("bin", path::FileName(info.vmHostOutput));
                    artifacts.Push(entrypoint);
                    if (info.wioTarget == "shared" and info.passLibraryPath) { packageArguments.Push(library); }
                }

                if (info.wioTarget == "shared" or not info.hostEnabled) { artifacts.Push(library); }
            }
        }
        else if (info.hostEnabled) {
            entrypoint = path::Join("bin", path::FileName(info.hostOutput));
            CopyRequired?(info.hostOutput, path::Join(packageRoot, entrypoint));
            artifacts.Push(entrypoint);
            if (info.wioTarget == "shared") {
                let library = path::Join("lib", path::FileName(info.wioOutput));
                CopyRequired?(info.wioOutput, path::Join(packageRoot, library));
                packageArguments.Push(library);
                artifacts.Push(library);
            }
        }
        else if (info.wioTarget == "exe") {
            entrypoint = path::Join("bin", path::FileName(info.wioOutput));
            CopyRequired?(info.wioOutput, path::Join(packageRoot, entrypoint));
            artifacts.Push(entrypoint);
        }
        else {
            let library = path::Join("lib", path::FileName(info.wioOutput));
            CopyRequired?(info.wioOutput, path::Join(packageRoot, library));
            artifacts.Push(library);
        }
        for asset in info.packageAssets {
            let destination = path::FileName(asset) == "assets"
                ? path::Join(packageRoot, "assets")
                : path::Join3(packageRoot, "assets", path::FileName(asset));
            CopyRequired?(asset, destination);
        }
        for file in info.packageFiles {
            mut relative = path::RelativeRaw(file, info.projectRoot);
            if (relative.StartsWith("..")) { relative = path::FileName(file); }
            CopyRequired?(file, path::Join(packageRoot, relative));
        }

        if (entrypoint != "") {
            if (process::ExecutableSuffix() == ".exe") {
                mut launcher = "@echo off\r\n\"%~dp0";
                launcher.Append(entrypoint.Replace("/", "\\"));
                launcher.Append("\"");
                for argument in packageArguments {
                    launcher.Append(" \"%~dp0");
                    launcher.Append(argument.Replace("/", "\\"));
                    launcher.Append("\"");
                }
                launcher.Append(" %*\r\n");
                if (not fs::TryWriteText(path::Join(packageRoot, "run.cmd"), launcher)) {
                    return Failure<i32>("Could not write the package launcher.");
                }
            }
            else {
                mut launcher = "#!/usr/bin/env sh\n";
                launcher += "package_root=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n";
                launcher += "exec \"$package_root/" + entrypoint + "\"";
                for argument in packageArguments
                {
                    launcher += " \"$package_root/" + argument + "\"";
                }

                launcher += " \"$@\"\n";
                let launcherPath = path::Join(packageRoot, "run.sh");
                if (not fs::TryWriteText(launcherPath, launcher) or not fs::TryMakeExecutable(launcherPath)) {
                    return Failure<i32>("Could not write the package launcher.");
                }
            }
        }
        let hostEnabled = info.hostEnabled ? "true" : "false";
        let entrypointJson = entrypoint == "" ? "null" : serialization::QuoteJson(entrypoint);
        mut metadata = "{\n";
        metadata += "  \"schemaVersion\": 1,\n";
        metadata += "  \"name\": " + serialization::QuoteJson(info.name) + ",\n";
        metadata += "  \"configuration\": " + serialization::QuoteJson(info.config) + ",\n";
        metadata += "  \"backend\": " + serialization::QuoteJson(backend) + ",\n";
        metadata += "  \"target\": " + serialization::QuoteJson(info.wioTarget) + ",\n";
        metadata += "  \"hostEnabled\": " + hostEnabled + ",\n";
        metadata += "  \"entrypoint\": " + entrypointJson + "\n";
        metadata += "}\n";
        if (not fs::TryWriteText(path::Join(packageRoot, "wio-package.json"), metadata)) {
            return Failure<i32>("Could not write package metadata.");
        }
        console::PrintLine!($"Packaged project: ${packageRoot}");
        let artifactCount = artifacts.Count();
        console::PrintLine!($"Artifacts       : ${artifactCount}");
        return std::Ok<i32>(0);
    }

    fn Execute(command: string, args: string[]) -> std::Result<i32> {
        if (command == "describe") { return Describe(args); }
        if (command == "check") { return Check(args); }
        if (command == "build") { return Build(args); }
        if (command == "run") { return Run(args); }
        if (command == "test") { return Test(args); }
        if (command == "package") { return Package(args); }
        return Failure<i32>($"Unsupported project command: ${command}");
    }
}
