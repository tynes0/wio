use argonaut;
use common;
use global_commands;
use std::console as console;
use std::fs as fs;
use std::json as json;
use std::path as path;
use std::regex as regex;
use std::result as result;
use std::serialization as serialization;

realm SelfHostedBind {
    fn Help() -> string {
        let lines: string[] = [
            "Wio binding commands\n\n",
            "Usage:\n",
            "  wio bind new    --manifest FILE [--output FILE]\n",
            "  wio bind import --header FILE --realm NAME [--output FILE] [--header-include FILE] [--prefer-flagset]\n"
        ];
        return lines.Join("");
    }

    fn AddRequired(parser: ref Argonaut::Parser, id: string, alias: string, description: string)
        -> std::Result<std::ResultUnit> {
        mut argument = Argonaut::Argument(id);
        argument.AddAlias(alias).SetDescription(description);
        parser.Add?(argument.Required?());
        return std::OkUnit();
    }

    fn AddOption(parser: ref Argonaut::Parser, id: string, alias: string, description: string)
        -> std::Result<std::ResultUnit> {
        mut argument = Argonaut::Argument(id);
        argument.AddAlias(alias).SetDefaultValue("").SetDescription(description);
        parser.Add?(argument);
        return std::OkUnit();
    }

    fn AddFlag(parser: ref Argonaut::Parser, id: string, alias: string, description: string)
        -> std::Result<std::ResultUnit> {
        mut argument = Argonaut::Argument(id);
        argument.AddAlias(alias).SetDescription(description);
        parser.Add?(argument.Flag?());
        return std::OkUnit();
    }

    fn Parser(action: string) -> std::Result<Argonaut::Parser> {
        mut parser = Argonaut::Parser();
        if (action == "new") {
            AddRequired?(ref parser, "MANIFEST", "--manifest", "Path to the JSON binding manifest.");
            AddOption?(ref parser, "OUTPUT", "--output", "Optional output .wio file override.");
        }
        else {
            AddRequired?(ref parser, "HEADER", "--header", "Path to the C/C++ header to import.");
            AddRequired?(ref parser, "REALM", "--realm", "Target Wio realm name for the generated bindings.");
            AddOption?(ref parser, "OUTPUT", "--output", "Optional output .wio file override.");
            AddOption?(
                ref parser,
                "HEADER-INCLUDE",
                "--header-include",
                "Header path string to place inside @CppHeader(...). Defaults to the header file name."
            );
            AddFlag?(ref parser, "PREFER-FLAGSET", "--prefer-flagset", "Treat imported enums as flagsets when possible.");
        }
        AddFlag?(ref parser, "HELP", "--help", "Show this help menu.");
        AddFlag?(ref parser, "HELP-SHORT", "-h", "Show this help menu.");
        AddFlag?(ref parser, "VERSION", "--version", "Show the Wio version.");
        AddFlag?(ref parser, "VERSION-SHORT", "-v", "Show the Wio version.");
        return std::Ok<Argonaut::Parser>(parser);
    }

    fn CommandArgs(action: string, args: string[]) -> string[] {
        mut values: string[] = [$"wio bind ${action}"];
        mut index = 3usize;
        while (index < args.Count()) {
            values.Push(args[index]);
            index += 1usize;
        }
        return values;
    }

    fn Failure<T>(message: string) -> std::Result<T> {
        return SelfHostedCli::Failure<T>($"Binding generation failed: ${message}");
    }

    fn JsonField(value: json::Value, key: string) -> json::Value {
        return value.Get(key).ValueOr(json::NullValue());
    }

    fn JsonText(value: json::Value, key: string) -> string {
        return JsonField(value, key).StringOr("");
    }

    fn JsonArray(value: json::Value, key: string) -> json::Value[] {
        return JsonField(value, key).arrayValue;
    }

    fn Scalar(value: json::Value) -> string {
        if (value.IsString()) { return value.stringValue; }
        return json::Write(value);
    }

    fn BindingCppName(realm: json::Value, item: json::Value) -> string {
        let explicitName = JsonText(item, "cppName");
        if (explicitName != "") { return explicitName; }
        let name = JsonText(item, "name");
        let cppNamespace = JsonText(realm, "cppNamespace");
        return cppNamespace == "" ? name : cppNamespace + "::" + name;
    }

    fn RenderMembers(items: json::Value[]) -> string {
        mut output = "";
        for item in items {
            output.Append("        " + JsonText(item, "name"));
            let value = JsonField(item, "value");
            if (not value.IsNull()) { output.Append(" = " + Scalar(value)); }
            output.Append(",\n");
        }
        return output;
    }

    fn RenderParameters(items: json::Value[]) -> string {
        mut values: string[] = [];
        for item in items {
            values.Push(JsonText(item, "name") + ": " + JsonText(item, "type"));
        }
        return values.Join(", ");
    }

    fn GenerateManifest(parser: ref Argonaut::Parser) -> std::Result<i32> {
        let manifestPath = path::Absolute(parser.GetStringOr("MANIFEST", ""));
        if (not fs::IsFile(manifestPath)) { return Failure<i32>($"Manifest does not exist: ${manifestPath}"); }
        let root = json::Parse?(fs::ReadText(manifestPath));
        if (not root.IsObject()) { return Failure<i32>("Binding manifest root must be an object."); }
        let realms = JsonArray(root, "realms");
        if (realms.Empty()) { return Failure<i32>("Binding manifest must contain at least one realm."); }
        mut outputPath = parser.GetStringOr("OUTPUT", "");
        if (outputPath == "") { outputPath = JsonText(root, "outputPath"); }
        if (outputPath == "") { return Failure<i32>("Manifest must define outputPath or --output must be provided."); }
        outputPath = path::AbsoluteFrom(path::ParentPath(manifestPath), outputPath);

        mut output = "// Generated by wio bind new\n// Manifest: " + manifestPath + "\n\n";
        for realmSpec in realms {
            let realmName = JsonText(realmSpec, "name");
            if (realmName == "") { return Failure<i32>("Every realm requires a name."); }
            output.Append("realm " + realmName + " {\n");
            mut headers = JsonArray(realmSpec, "headers");
            if (headers.Empty()) { headers = JsonArray(root, "headers"); }
            if (headers.Empty() and JsonText(root, "header") != "") {
                headers.Push(json::StringValue(JsonText(root, "header")));
            }
            for header in headers {
                output.Append("    use @CppHeader(" + serialization::QuoteJson(header.StringOr("")) + ");\n");
            }
            if (not headers.Empty()) { output.Append("\n"); }

            let constants = JsonArray(realmSpec, "consts");
            for constant in constants {
                output.Append("    const " + JsonText(constant, "name") + ": " + JsonText(constant, "type") +
                    " = " + Scalar(JsonField(constant, "value")) + ";\n");
            }
            if (not constants.Empty()) { output.Append("\n"); }

            for enumSpec in JsonArray(realmSpec, "enums") {
                let backing = JsonText(enumSpec, "backingType");
                if (backing != "") { output.Append("    @Type(" + backing + ")\n"); }
                output.Append("    enum " + JsonText(enumSpec, "name") + " {\n");
                output.Append(RenderMembers(JsonArray(enumSpec, "members")));
                output.Append("    };\n\n");
            }
            for flagSpec in JsonArray(realmSpec, "flagsets") {
                let backing = JsonText(flagSpec, "backingType");
                if (backing != "") { output.Append("    @Type(" + backing + ")\n"); }
                output.Append("    flagset " + JsonText(flagSpec, "name") + " {\n");
                output.Append(RenderMembers(JsonArray(flagSpec, "members")));
                output.Append("    };\n\n");
            }
            for componentSpec in JsonArray(realmSpec, "components") {
                output.Append("    @Native\n    @CppName(" + BindingCppName(realmSpec, componentSpec) + ")\n");
                output.Append("    component " + JsonText(componentSpec, "name") + " {\n");
                for field in JsonArray(componentSpec, "fields") {
                    output.Append("        " + JsonText(field, "name") + ": " + JsonText(field, "type") + ";\n");
                }
                output.Append("    }\n\n");
            }
            for functionSpec in JsonArray(realmSpec, "functions") {
                output.Append("    @Native\n    @CppName(" + BindingCppName(realmSpec, functionSpec) + ")\n");
                for value in JsonArray(functionSpec, "instantiate") { output.Append("    @Instantiate(" + Scalar(value) + ")\n"); }
                for value in JsonArray(functionSpec, "apply") { output.Append("    @Apply(" + Scalar(value) + ")\n"); }
                output.Append("    fn " + JsonText(functionSpec, "name") + "(" +
                    RenderParameters(JsonArray(functionSpec, "parameters")) + ")");
                let returnType = JsonText(functionSpec, "returnType");
                if (returnType != "") { output.Append(" -> " + returnType); }
                output.Append(";\n\n");
            }
            output.Append("}\n\n");
        }
        if (not fs::WriteTextEnsured(outputPath, output)) { return Failure<i32>($"Could not write: ${outputPath}"); }
        console::PrintLine!($"Generated Wio binding module: ${outputPath}");
        return std::Ok<i32>(0);
    }

    fn RegexMatches(input: string, pattern: string) -> std::Result<regex::Match[]> {
        mut output: regex::Match[] = [];
        mut cursor = 0usize;
        while (cursor < input.Count()) {
            mut found = regex::Find?(input.Slice(cursor), pattern);
            if (not found.found) { break; }
            found.index += cursor;
            output.Push(found);
            let advance = found.length == 0usize ? 1usize : found.length;
            cursor = found.index + advance;
        }
        return std::Ok<regex::Match[]>(output);
    }

    fn CppType(value: string) -> string {
        mut typeName = value.Trim().Replace("struct ", "").Replace("class ", "").Replace("enum class ", "").Replace("enum ", "");
        if (typeName == "const char*" or typeName == "const char *" or typeName == "char*" or typeName == "char *") { return "string"; }
        if (typeName == "const void*" or typeName == "const void *" or typeName == "void*" or typeName == "void *") { return "opaque"; }
        let cppTypes: string[] = [
            "void|void", "bool|bool", "char|char", "signed char|i8", "unsigned char|u8",
            "short|i16", "unsigned short|u16", "int|i32", "unsigned int|u32",
            "long long|i64", "unsigned long long|u64", "float|f32", "double|f64",
            "std::int8_t|i8", "int8_t|i8", "std::int16_t|i16", "int16_t|i16",
            "std::int32_t|i32", "int32_t|i32", "std::int64_t|i64", "int64_t|i64",
            "std::uint8_t|u8", "uint8_t|u8", "std::uint16_t|u16", "uint16_t|u16",
            "std::uint32_t|u32", "uint32_t|u32", "std::uint64_t|u64", "uint64_t|u64",
            "std::size_t|usize", "size_t|usize"
        ];
        for pair in cppTypes {
            let parts = pair.Split("|");
            if (typeName == parts[0usize]) { return parts[1usize]; }
        }
        return typeName;
    }

    fn CppParameter(value: string) -> string {
        let collapsed = value.Trim().Replace("  ", " ");
        if (collapsed == "" or collapsed == "void") { return ""; }
        let pieces = collapsed.Split(" ");
        let name = pieces.Last();
        mut typeName = collapsed.Take(collapsed.Count() - name.Count()).Trim();
        let isRef = typeName.EndsWith("&") or typeName.EndsWith("*");
        let isConst = typeName.StartsWith("const ");
        if (isRef) { typeName = typeName.Take(typeName.Count() - 1usize).Trim(); }
        if (isConst) { typeName = typeName.Slice(6usize).Trim(); }
        let mapped = CppType(typeName);
        if (not isRef or mapped == "string" or mapped == "opaque") { return name + ": " + mapped; }
        return name + ": " + (isConst ? "view " : "ref ") + mapped;
    }

    fn CppName(prefix: string, name: string) -> string {
        return prefix == "" ? name : prefix + "::" + name;
    }

    fn GenerateHeader(parser: ref Argonaut::Parser) -> std::Result<i32> {
        let headerPath = path::Absolute(parser.GetStringOr("HEADER", ""));
        if (not fs::IsFile(headerPath)) { return Failure<i32>($"Header does not exist: ${headerPath}"); }
        let realmName = parser.GetStringOr("REALM", "");
        mut outputPath = parser.GetStringOr("OUTPUT", "");
        if (outputPath == "") { outputPath = path::ChangeExtension(headerPath, ".wio"); }
        else { outputPath = path::Absolute(outputPath); }
        mut headerInclude = parser.GetStringOr("HEADER-INCLUDE", "");
        if (headerInclude == "") { headerInclude = path::FileName(headerPath); }
        mut source = fs::ReadText(headerPath);
        source = regex::Replace?(source, "//[^\\r\\n]*", "");
        source = regex::Replace?(source, "/\\*[\\s\\S]*?\\*/", "");
        let namespaceMatch = regex::Find?(source, "namespace\\s+([A-Za-z_]\\w*)\\s*\\{");
        let cppPrefix = namespaceMatch.found and not namespaceMatch.groups.Empty() ? namespaceMatch.groups[0usize] : "";
        mut output = "// Generated by wio bind import\n// Source header: " + headerPath + "\n\nrealm " + realmName + " {\n";
        output.Append("    use @CppHeader(" + serialization::QuoteJson(headerInclude) + ");\n\n");

        for constant in RegexMatches?(source, "(?:(?:inline|static)\\s+)*constexpr\\s+([A-Za-z_:\\s\\*&<>\\d,]+?)\\s+([A-Za-z_]\\w*)\\s*=\\s*([^;{}]+)\\s*;") {
            output.Append("    const " + constant.groups[1usize] + ": " + CppType(constant.groups[0usize]) + " = " + constant.groups[2usize].Trim() + ";\n");
        }
        let enumMatches = RegexMatches?(source, "enum(?:\\s+class)?\\s+([A-Za-z_]\\w*)\\s*(?::\\s*([^{};]+))?\\s*\\{([\\s\\S]*?)\\}\\s*;");
        if (not enumMatches.Empty()) { output.Append("\n"); }
        for enumSpec in enumMatches {
            let name = enumSpec.groups[0usize];
            let backing = enumSpec.groups[1usize].Trim();
            let body = enumSpec.groups[2usize];
            let flagset = parser.GetFlag("PREFER-FLAGSET") or name.EndsWith("Flags") or name.EndsWith("Bits") or
                name.EndsWith("Mask") or name.EndsWith("Modifiers") or name.EndsWith("Options") or body.Contains("<<") or body.Contains("|");
            output.Append("    @Native\n");
            if (backing != "") { output.Append("    @Type(" + CppType(backing) + ")\n"); }
            output.Append("    @CppName(" + CppName(cppPrefix, name) + ")\n    " + (flagset ? "flagset " : "enum ") + name + " {\n");
            for rawMember in body.Split(",") {
                let member = rawMember.Trim();
                if (member == "") { continue; }
                let assignment = member.Split("=");
                output.Append("        " + assignment[0usize].Trim());
                if (assignment.Count() > 1usize) { output.Append(" = " + assignment.Slice(1usize).Join("=").Trim()); }
                output.Append(",\n");
            }
            output.Append("    };\n\n");
        }
        for structSpec in RegexMatches?(source, "struct\\s+([A-Za-z_]\\w*)\\s*\\{([\\s\\S]*?)\\}\\s*;") {
            let name = structSpec.groups[0usize];
            output.Append("    @Native\n    @CppName(" + CppName(cppPrefix, name) + ")\n    component " + name + " {\n");
            for rawField in structSpec.groups[1usize].Split(";") {
                let field = rawField.Trim();
                if (field == "") { continue; }
                let arrayField = regex::Find?(field, "^(.*?)\\s+([A-Za-z_]\\w*)\\s*\\[\\s*(\\d+)\\s*\\]$");
                if (arrayField.found) {
                    output.Append("        " + arrayField.groups[1usize] + ": [" + CppType(arrayField.groups[0usize]) + "; " + arrayField.groups[2usize] + "];\n");
                } else {
                    let normalField = regex::Find?(field, "^(.*?)\\s+([A-Za-z_]\\w*)$");
                    if (normalField.found) { output.Append("        " + normalField.groups[1usize] + ": " + CppType(normalField.groups[0usize]) + ";\n"); }
                }
            }
            output.Append("    }\n\n");
        }
        for functionSpec in RegexMatches?(source, "([A-Za-z_:\\s\\*&<>\\d,]+?)\\s+([A-Za-z_]\\w*)\\s*\\(([^;{}()]*)\\)\\s*;") {
            let name = functionSpec.groups[1usize];
            if (name == "if" or name == "for" or name == "while" or name == "switch" or name == "return") { continue; }
            mut parameters: string[] = [];
            for rawParameter in functionSpec.groups[2usize].Split(",") {
                let parameter = CppParameter(rawParameter);
                if (parameter != "") { parameters.Push(parameter); }
            }
            mut rawReturnType = functionSpec.groups[0usize].Trim();
            if (rawReturnType.EndsWith("&") or rawReturnType.EndsWith("*")) {
                rawReturnType = rawReturnType.Take(rawReturnType.Count() - 1usize).Trim();
            }
            let returnType = CppType(rawReturnType.Replace("const ", ""));
            output.Append("    @Native\n    @CppName(" + CppName(cppPrefix, name) + ")\n    fn " + name + "(" + parameters.Join(", ") + ")");
            if (returnType != "void") { output.Append(" -> " + returnType); }
            output.Append(";\n\n");
        }
        output.Append("}\n");
        if (not fs::WriteTextEnsured(outputPath, output)) { return Failure<i32>($"Could not write: ${outputPath}"); }
        console::PrintLine!($"Generated Wio binding module: ${outputPath}");
        return std::Ok<i32>(0);
    }

    fn Execute(args: string[]) -> std::Result<i32> {
        if (args.Count() < 3usize or SelfHostedGlobal::IsHelp(args[2usize])) {
            console::Print(Help());
            return std::Ok<i32>(0);
        }
        if (SelfHostedGlobal::IsVersion(args[2usize])) {
            return SelfHostedCli::RunNativeVersion(args[0usize]);
        }

        let action = args[2usize];
        if (action != "new" and action != "import") {
            let suggestion = SelfHostedCli::Suggest(action, ["new", "import"]);
            mut message = $"Unknown bind subcommand: ${action}";
            if (suggestion != "") {
                message.Append($"\nDid you mean 'wio bind ${suggestion}'?");
            }
            message.Append("\nRun 'wio bind --help' to list available binding commands.");
            return SelfHostedCli::Failure<i32>(message);
        }

        mut parser = Parser?(action);
        parser.Parse?(CommandArgs(action, args));
        if (parser.GetFlag("HELP") or parser.GetFlag("HELP-SHORT")) {
            console::Print(parser.Help());
            return std::Ok<i32>(0);
        }
        if (parser.GetFlag("VERSION") or parser.GetFlag("VERSION-SHORT")) {
            return SelfHostedCli::RunNativeVersion(args[0usize]);
        }

        if (action == "new") { return GenerateManifest(ref parser); }
        return GenerateHeader(ref parser);
    }
}
