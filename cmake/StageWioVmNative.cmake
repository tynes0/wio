cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/WioVmNativePaths.cmake")
if(NOT NATIVE_STAGE OR NOT NATIVE_MANIFEST OR NOT NATIVE_PREFIX MATCHES "^[A-Za-z0-9_.+-]+\\.vm-native$")
    message(FATAL_ERROR "Invalid VM native staging arguments")
endif()
wio_vm_native_leaf("${NATIVE_PREFIX}")
set(all_sources ${NATIVE_PRODUCERS} ${RUNTIME_LIBRARIES})
set(names)
set(hashes)
set(roles)
set(signature "wio-vm-native-bundle-v1\n")
list(LENGTH NATIVE_PRODUCERS producer_count)
set(index 0)
foreach(source IN LISTS all_sources)
    if(NOT IS_ABSOLUTE "${source}" OR NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "VM native dependency is not an absolute existing file: ${source}")
    endif()
    get_filename_component(name "${source}" NAME)
    wio_vm_native_leaf("${name}")
    string(TOLOWER "${name}" folded)
    if(folded IN_LIST names_folded)
        message(FATAL_ERROR "VM native dependencies have colliding filenames: ${name}")
    endif()
    list(APPEND names_folded "${folded}")
    file(SHA256 "${source}" hash)
    if(index LESS producer_count)
        set(role producer)
    else()
        set(role runtime)
    endif()
    string(LENGTH "${name}" name_size)
    string(APPEND signature "${role}:${name_size}:${name}:${hash}\n")
    list(APPEND names "${name}")
    list(APPEND hashes "${hash}")
    list(APPEND roles "${role}")
    math(EXPR index "${index} + 1")
endforeach()
string(SHA256 digest "${signature}")
set(bundle "${NATIVE_PREFIX}/${digest}")
wio_vm_native_quote(bundle_json "${bundle}")
set(document "{\"version\":1,\"bundle\":${bundle_json},\"files\":[]}")
file(MAKE_DIRECTORY "${NATIVE_STAGE}/${digest}")
set(WIO_NATIVE_PATH_INITIALIZER "")
set(index 0)
foreach(source IN LISTS all_sources)
    list(GET names ${index} name)
    list(GET hashes ${index} hash)
    list(GET roles ${index} role)
    set(destination "${NATIVE_STAGE}/${digest}/${name}")
    wio_vm_native_inside("${NATIVE_STAGE}" "${destination}")
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" existing)
        if(NOT existing STREQUAL hash)
            message(FATAL_ERROR "VM native staging generation collision: ${destination}")
        endif()
    else()
        configure_file("${source}" "${destination}" COPYONLY)
    endif()
    wio_vm_native_quote(name_json "${name}")
    set(record "{\"name\":${name_json},\"sha256\":\"${hash}\",\"role\":\"${role}\"}")
    string(JSON document SET "${document}" files ${index} "${record}")
    if(role STREQUAL "producer")
        string(HEX "${bundle}/${name}" encoded)
        string(REGEX REPLACE "(..)" "\\\\x\\1" encoded "${encoded}")
        string(APPEND WIO_NATIVE_PATH_INITIALIZER "std::filesystem::u8path(\"${encoded}\"),\n")
    endif()
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${NATIVE_MANIFEST}" "${document}\n")
