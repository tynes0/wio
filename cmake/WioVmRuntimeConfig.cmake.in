@PACKAGE_INIT@

# GNU ld's supplementary make-style link depfiles can split whitespace in
# archive paths into nonexistent inputs. Ninja then relinks an unchanged image
# forever. Keep CMake's declared target/file dependencies, and only disable this
# optional linker-generated augmentation for affected default configurations.
# An explicit consumer setting still wins (e.g. with a fixed linker).
if(UNIX AND NOT APPLE AND CMAKE_GENERATOR MATCHES "Ninja" AND
   CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND NOT DEFINED CMAKE_LINK_DEPENDS_USE_LINKER)
    if("${CMAKE_CURRENT_LIST_DIR}" MATCHES "[ \t]" OR
       "${CMAKE_CURRENT_SOURCE_DIR}" MATCHES "[ \t]" OR
       "${CMAKE_CURRENT_BINARY_DIR}" MATCHES "[ \t]")
        set(CMAKE_LINK_DEPENDS_USE_LINKER FALSE)
    endif()
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/WioVmRuntimeTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WioVmModule.cmake")

# Archives are C++ runtime products, not a cross-toolchain wire format.
set(WioVmRuntime_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(WioVmRuntime_MSVC_STATIC_RUNTIME "@WIO_MSVC_STATIC_RUNTIME@")
check_required_components(WioVmRuntime)
