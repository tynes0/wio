cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/WioVmNativePaths.cmake")
if(NOT MANIFEST OR NOT STAGE OR NOT DESTINATION OR NOT IS_DIRECTORY "${DESTINATION}")
    message(FATAL_ERROR "Invalid VM native deployment arguments")
endif()
file(READ "${MANIFEST}" document)
string(JSON version GET "${document}" version)
string(JSON bundle GET "${document}" bundle)
if(NOT version EQUAL 1 OR NOT bundle MATCHES "^[A-Za-z0-9_.+-]+\\.vm-native/([0-9a-f]+)$")
    message(FATAL_ERROR "Invalid VM native deployment manifest")
endif()
set(digest "${CMAKE_MATCH_1}")
get_filename_component(prefix "${bundle}" DIRECTORY)
wio_vm_native_leaf("${prefix}")
string(LENGTH "${digest}" digest_size)
if(NOT digest_size EQUAL 64)
    message(FATAL_ERROR "Invalid VM native bundle digest")
endif()
string(JSON count LENGTH "${document}" files)
set(signature "wio-vm-native-bundle-v1\n")
set(names)
set(hashes)
set(folded_names)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${document}" files ${index} name)
        string(JSON hash GET "${document}" files ${index} sha256)
        string(JSON role GET "${document}" files ${index} role)
        wio_vm_native_leaf("${name}")
        string(TOLOWER "${name}" folded)
        string(LENGTH "${hash}" hash_size)
        if(folded IN_LIST folded_names OR NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_size EQUAL 64 OR
           NOT role MATCHES "^(producer|runtime)$")
            message(FATAL_ERROR "Invalid VM native bundle file metadata")
        endif()
        list(APPEND folded_names "${folded}")
        set(source "${STAGE}/${digest}/${name}")
        wio_vm_native_inside("${STAGE}" "${source}")
        if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "Missing staged VM native dependency: ${source}")
        endif()
        file(SHA256 "${source}" actual)
        if(NOT actual STREQUAL hash)
            message(FATAL_ERROR "Staged VM native dependency failed its content hash: ${source}")
        endif()
        string(LENGTH "${name}" name_size)
        string(APPEND signature "${role}:${name_size}:${name}:${hash}\n")
        list(APPEND names "${name}")
        list(APPEND hashes "${hash}")
    endforeach()
endif()
string(SHA256 actual_digest "${signature}")
if(NOT actual_digest STREQUAL digest)
    message(FATAL_ERROR "VM native manifest does not match its bundle identity")
endif()
set(directory "${DESTINATION}/${bundle}")
wio_vm_native_inside("${DESTINATION}" "${directory}")
# Validate all existing destination files before copying any missing files.
set(index 0)
foreach(name IN LISTS names)
    set(path "${directory}/${name}")
    wio_vm_native_inside("${DESTINATION}" "${path}")
    if(EXISTS "${path}")
        if(IS_DIRECTORY "${path}")
            message(FATAL_ERROR "VM native destination is a directory: ${path}")
        endif()
        file(SHA256 "${path}" actual)
        list(GET hashes ${index} expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Refusing to overwrite a different VM native generation: ${path}")
        endif()
    endif()
    math(EXPR index "${index} + 1")
endforeach()
file(MAKE_DIRECTORY "${directory}")
foreach(name IN LISTS names)
    if(NOT EXISTS "${directory}/${name}")
        configure_file("${STAGE}/${digest}/${name}" "${directory}/${name}" COPYONLY)
    endif()
endforeach()
configure_file("${MANIFEST}" "${directory}/wio-native-manifest.json" COPYONLY)
