function(wio_vm_native_leaf name)
    if(NOT name OR name STREQUAL "." OR name STREQUAL ".." OR name MATCHES "[/\\\\<>:\"|?*;\r\n]" OR
       name MATCHES "[ .]$")
        message(FATAL_ERROR "VM native bundle requires a portable single filename: ${name}")
    endif()
    string(TOLOWER "${name}" folded)
    if(folded MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])($|\\.)" OR folded STREQUAL "wio-native-manifest.json")
        message(FATAL_ERROR "VM native bundle filename is reserved: ${name}")
    endif()
    foreach(code RANGE 1 31)
        string(ASCII ${code} control)
        string(FIND "${name}" "${control}" position)
        if(NOT position EQUAL -1)
            message(FATAL_ERROR "VM native bundle filename contains a control character")
        endif()
    endforeach()
endfunction()

function(wio_vm_native_quote output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(wio_vm_native_inside root candidate)
    file(REAL_PATH "${root}" base)
    # Resolve an existing ancestor, then append the absent components. Calling
    # REAL_PATH on a missing leaf produces CMake warnings and can miss an
    # existing symlink parent. Never create directories to perform this check.
    set(ancestor "${candidate}")
    set(missing)
    while(NOT EXISTS "${ancestor}")
        if(IS_SYMLINK "${ancestor}")
            message(FATAL_ERROR "VM native bundle path contains a dangling symlink: ${candidate}")
        endif()
        get_filename_component(parent "${ancestor}" DIRECTORY)
        if(parent STREQUAL ancestor OR NOT parent)
            message(FATAL_ERROR "VM native bundle path has no existing ancestor: ${candidate}")
        endif()
        get_filename_component(leaf "${ancestor}" NAME)
        list(PREPEND missing "${leaf}")
        set(ancestor "${parent}")
    endwhile()
    file(REAL_PATH "${ancestor}" resolved_ancestor)
    cmake_path(IS_PREFIX base "${resolved_ancestor}" NORMALIZE ancestor_contained)
    if(NOT ancestor_contained)
        message(FATAL_ERROR "VM native bundle ancestor escapes its destination: ${candidate}")
    endif()
    set(resolved "${resolved_ancestor}")
    foreach(part IN LISTS missing)
        cmake_path(APPEND resolved "${part}")
    endforeach()
    cmake_path(IS_PREFIX base "${resolved}" NORMALIZE contained)
    if(NOT contained)
        message(FATAL_ERROR "VM native bundle path escapes its destination: ${candidate}")
    endif()
endfunction()
