cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT GETTER MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR
   NOT SESSION_GETTER MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR NOT TASK_GETTER MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Invalid VM module embedding arguments")
endif()
file(SIZE "${INPUT}" byte_count)
if(byte_count LESS 48 OR byte_count GREATER 536870912)
    message(FATAL_ERROR "VM module bytecode size is outside the supported codec range")
endif()
file(READ "${INPUT}" bytes HEX)
# Bulk transformations avoid a CMake list element / string append per byte.
string(REPEAT "[0-9a-f][0-9a-f]" 24 line_pattern)
string(REGEX REPLACE "(${line_pattern})" "\\1\n" lines "${bytes}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," initializer "${lines}")
if(KIND STREQUAL "SHARED")
    set(visibility "#if defined(_WIN32)\n#define WIO_VM_EXPORT __declspec(dllexport)\n#else\n#define WIO_VM_EXPORT __attribute__((visibility(\"default\")))\n#endif\n")
else()
    set(visibility "#define WIO_VM_EXPORT\n")
endif()
set(factory "return std::make_unique<wio::vm::ModuleSessionFactory>(std::move(decoded.module));")
if(NATIVE_PRODUCERS)
    include("${CMAKE_CURRENT_LIST_DIR}/StageWioVmNative.cmake")
    set(factory "const std::array names = {${WIO_NATIVE_PATH_INITIALIZER}};
            auto dependencies = wio::vm::moduleNativeLibraries(code, names);
            return std::make_unique<wio::vm::ModuleSessionFactory>(std::move(decoded.module), wio::vm::MachineOptions{}, std::move(dependencies));")
endif()
file(WRITE "${OUTPUT}" "// Generated bytecode module; do not edit.\n#include <wio/vm/module_session.h>\n#include <wio/bytecode/codec.h>\n#include <stdexcept>\n#include <array>\n${visibility}
namespace
{
    const unsigned char code[] = {${initializer}};

    wio::vm::ModuleSessionFactory& module()
    {
        static const auto adapter = []
        {
            auto decoded = wio::bytecode::decode({reinterpret_cast<const std::byte*>(code), sizeof(code)});
            if (!decoded.succeeded())
                throw std::invalid_argument(decoded.error);
            ${factory}
        }();
        return *adapter;
    }
}

extern \"C\" WIO_VM_EXPORT const WioSdkModuleContract* ${GETTER}() noexcept
{
    try
    {
        return &module().defaultContract();
    }
    catch (...)
    {
        return nullptr;
    }
}

extern \"C\" WIO_VM_EXPORT const WioSdkModuleSessionApi* ${SESSION_GETTER}() noexcept
{
    try
    {
        return &module().api();
    }
    catch (...)
    {
        return nullptr;
    }
}

extern \"C\" WIO_VM_EXPORT const WioSdkModuleTaskApi* ${TASK_GETTER}() noexcept
{
    try
    {
        return &module().taskApi();
    }
    catch (...)
    {
        return nullptr;
    }
}

")
