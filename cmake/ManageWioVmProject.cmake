cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/WioVmNativePaths.cmake")
if(NOT ACTION MATCHES "^(record|verify)$" OR NOT METADATA OR NOT EXPECTED_KIND MATCHES "^(shared|static)$" OR
   NOT IS_ABSOLUTE "${EXPECTED_MODULE}" OR (EXPECTED_HOST AND NOT IS_ABSOLUTE "${EXPECTED_HOST}"))
    message(FATAL_ERROR "Invalid VM project artifact verification arguments")
endif()
if(ACTION STREQUAL "record")
    file(READ "${NATIVE_MANIFEST}" native)
    set(record "{\"version\":1}")
    foreach(field IN ITEMS kind module host)
        string(TOUPPER "${field}" upper)
        wio_vm_native_quote(encoded "${EXPECTED_${upper}}")
        string(JSON record SET "${record}" "${field}" "${encoded}")
    endforeach()
    string(JSON record SET "${record}" native "${native}")
    foreach(field IN ITEMS module host)
        string(TOUPPER "${field}" upper)
        if(EXPECTED_${upper})
            file(SHA256 "${EXPECTED_${upper}}" hash)
            string(JSON record SET "${record}" "${field}Hash" "\"${hash}\"")
        endif()
    endforeach()
else()
    file(READ "${METADATA}" record)
endif()
string(JSON version GET "${record}" version)
if(NOT version EQUAL 1)
    message(FATAL_ERROR "Unsupported VM project artifact record")
endif()
foreach(field IN ITEMS kind module host)
    string(TOUPPER "${field}" upper)
    string(JSON value GET "${record}" "${field}")
    if(NOT value STREQUAL EXPECTED_${upper})
        message(FATAL_ERROR "VM project ${field} changed; rebuild instead of using --no-build")
    endif()
endforeach()
foreach(field IN ITEMS module host)
    string(TOUPPER "${field}" upper)
    if(EXPECTED_${upper})
        if(NOT EXISTS "${EXPECTED_${upper}}" OR IS_DIRECTORY "${EXPECTED_${upper}}")
            message(FATAL_ERROR "Missing VM project ${field}; rebuild the project")
        endif()
        file(SHA256 "${EXPECTED_${upper}}" actual)
        string(JSON expected GET "${record}" "${field}Hash")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "VM project ${field} does not match its recorded image; rebuild the project")
        endif()
    endif()
endforeach()
if(EXPECTED_KIND STREQUAL "static" AND EXPECTED_HOST)
    get_filename_component(image_root "${EXPECTED_HOST}" DIRECTORY)
else()
    get_filename_component(image_root "${EXPECTED_MODULE}" DIRECTORY)
endif()
string(JSON native GET "${record}" native)
string(JSON bundle GET "${native}" bundle)
if(NOT bundle MATCHES "^[A-Za-z0-9_.+-]+\\.vm-native/[0-9a-f]+$")
    message(FATAL_ERROR "Invalid VM project native bundle path")
endif()
string(JSON count LENGTH "${native}" files)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${native}" files ${index} name)
        string(JSON expected GET "${native}" files ${index} sha256)
        wio_vm_native_leaf("${name}")
        set(file "${image_root}/${bundle}/${name}")
        wio_vm_native_inside("${image_root}" "${file}")
        if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
            message(FATAL_ERROR "Missing deployed VM native dependency: ${file}. Rebuild to repair it.")
        endif()
        file(SHA256 "${file}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Deployed VM native dependency does not match its recorded generation: ${file}")
        endif()
    endforeach()
endif()
if(ACTION STREQUAL "record")
    file(WRITE "${METADATA}.tmp" "${record}\n")
    file(RENAME "${METADATA}.tmp" "${METADATA}")
endif()
message(STATUS "VM project ${EXPECTED_KIND} artifacts verified")
