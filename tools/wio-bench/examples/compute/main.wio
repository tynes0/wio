use std::benchmark as bench;
use std::console as console;
use std::convert as convert;

fn Compute(count: i64) -> u64
{
    mut state = 12345u64;
    mut checksum = 0u64;
    for (index in 0i64..<count)
    {
        state = (state * 48271u64) % 2147483647u64;
        checksum += state;
    }

    return checksum;
}

fn Entry(args: string[]) -> i32
{
    if (args.Count() != 2usize) return 1;
    let parsed = convert::ParseI64(args[1usize]);
    if (parsed.IsError()) return 1;
    let count = parsed.Value();
    if (count < 1 or count > 1000000) return 1;
    // Same in-process warmup as C++ and C#, outside the reported kernel.
    bench::Consume(Compute(bench::Input(count)));
    bench::Consume(Compute(bench::Input(count)));
    let start = bench::Now();
    let checksum = Compute(bench::Input(count));
    bench::Consume(checksum);
    let elapsed = bench::Now() - start;
    console::PrintLine(bench::Protocol(elapsed, count fit u64, checksum));
    return 0;
}
