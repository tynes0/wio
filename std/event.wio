realm std {
    realm event {
        object Event {
            public name: string;
            public payload: any;
            public context: any;
            public handled: bool;

            OnConstruct(name: string) {
                self.name = name;
                self.payload = null;
                self.context = null;
                self.handled = false;
            }

            OnConstruct(name: string, payload: any) {
                self.name = name;
                self.payload = payload;
                self.context = null;
                self.handled = false;
            }

            OnConstruct(name: string, payload: any, context: any) {
                self.name = name;
                self.payload = payload;
                self.context = context;
                self.handled = false;
            }

            public fn Handle() {
                self.handled = true;
            }

            public fn Reset(name: string) {
                self.name = name;
                self.payload = null;
                self.context = null;
                self.handled = false;
            }

            public fn Reset(name: string, payload: any) {
                self.name = name;
                self.payload = payload;
                self.context = null;
                self.handled = false;
            }

            public fn Reset(name: string, payload: any, context: any) {
                self.name = name;
                self.payload = payload;
                self.context = context;
                self.handled = false;
            }

            public fn ClearPayload() {
                self.payload = null;
            }

            public fn ClearContext() {
                self.context = null;
            }

            public fn HasPayload() -> bool {
                return self.payload != null;
            }

            public fn HasContext() -> bool {
                return self.context != null;
            }
        }
    }
}
