        fn Capabilities() -> Result<CapabilitiesInfo> {
            mut result: CapabilitiesInfo = CapabilitiesInfo();
            mut colors = false;
            mut cursorPosition = false;
            mut cursorVisibility = false;
            mut cursorSize = false;
            mut bufferSize = false;
            mut windowPosition = false;
            mut windowSizeGet = false;
            mut windowSizeSet = false;
            mut largestWindowSize = false;
            mut moveBufferArea = false;
            mut keyAvailable = false;
            mut readKey = false;
            mut title = false;
            mut beep = false;
            mut beepFrequency = false;
            mut keyboardToggleState = false;
            mut treatControlCAsInput = false;
            mut encodingSet = false;
            let status = TryCapabilities(
                ref colors,
                ref cursorPosition,
                ref cursorVisibility,
                ref cursorSize,
                ref bufferSize,
                ref windowPosition,
                ref windowSizeGet,
                ref windowSizeSet,
                ref largestWindowSize,
                ref moveBufferArea,
                ref keyAvailable,
                ref readKey,
                ref title,
                ref beep,
                ref beepFrequency,
                ref keyboardToggleState,
                ref treatControlCAsInput,
                ref encodingSet);
            if (not Ok(status)) {
                return Result<CapabilitiesInfo>(LastResultError());
            }
            result.colors = colors;
            result.cursorPosition = cursorPosition;
            result.cursorVisibility = cursorVisibility;
            result.cursorSize = cursorSize;
            result.bufferSize = bufferSize;
            result.windowPosition = windowPosition;
            result.windowSizeGet = windowSizeGet;
            result.windowSizeSet = windowSizeSet;
            result.largestWindowSize = largestWindowSize;
            result.moveBufferArea = moveBufferArea;
            result.keyAvailable = keyAvailable;
            result.readKey = readKey;
            result.title = title;
            result.beep = beep;
            result.beepFrequency = beepFrequency;
            result.keyboardToggleState = keyboardToggleState;
            result.treatControlCAsInput = treatControlCAsInput;
            result.encodingSet = encodingSet;
            return Result<CapabilitiesInfo>(result);
        }

        fn GetCursorPositionInfo() -> Result<CursorPositionInfo> {
            mut result: CursorPositionInfo = CursorPositionInfo();
            mut left = 0;
            mut top = 0;
            let status = TryGetCursorPosition(ref left, ref top);
            if (not Ok(status)) {
                return Result<CursorPositionInfo>(LastResultError());
            }
            result.left = left;
            result.top = top;
            return Result<CursorPositionInfo>(result);
        }

        fn GetStandardErrorInfo(bufferSize: usize) -> Result<StandardStreamInfo> {
            mut result: StandardStreamInfo = StandardStreamInfo();
            mut redirected = false;
            mut actualBufferSize = 0usize;
            mut hasReader = false;
            mut hasWriter = false;
            mut isOpen = false;
            let status = TryOpenStandardError(bufferSize, ref redirected, ref actualBufferSize, ref hasReader, ref hasWriter, ref isOpen);
            if (not Ok(status)) {
                return Result<StandardStreamInfo>(LastResultError());
            }
            result.redirected = redirected;
            result.bufferSize = actualBufferSize;
            result.hasReader = hasReader;
            result.hasWriter = hasWriter;
            result.isOpen = isOpen;
            return Result<StandardStreamInfo>(result);
        }

