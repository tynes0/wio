        @Native @CppName(wio::runtime::std_console::MoveBufferArea) fn TryMoveBufferArea(sourceLeft: i32, sourceTop: i32, sourceWidth: i32, sourceHeight: i32, targetLeft: i32, targetTop: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::MoveBufferArea) fn TryMoveBufferArea(sourceLeft: i32, sourceTop: i32, sourceWidth: i32, sourceHeight: i32, targetLeft: i32, targetTop: i32, sourceChar: i32, sourceForeColor: Color, sourceBackColor: Color) -> Status;
        @Native @CppName(wio::runtime::std_console::OpenStandardError) fn TryOpenStandardError(bufferSize: usize, redirected: ref bool, actualBufferSize: ref usize, hasReader: ref bool, hasWriter: ref bool, isOpen: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::OpenStandardInput) fn TryOpenStandardInput(bufferSize: usize, redirected: ref bool, actualBufferSize: ref usize, hasReader: ref bool, hasWriter: ref bool, isOpen: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::OpenStandardOutput) fn TryOpenStandardOutput(bufferSize: usize, redirected: ref bool, actualBufferSize: ref usize, hasReader: ref bool, hasWriter: ref bool, isOpen: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::Read) fn TryRead(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadCount) fn TryReadCount(count: usize, value: ref string) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadHidden) fn TryReadHidden(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadKey) fn TryReadKey(keyChar: ref i32, key: ref Key, modifiers: ref Modifiers) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadKey) fn TryReadKey(intercept: bool, keyChar: ref i32, key: ref Key, modifiers: ref Modifiers) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadLine) fn TryReadLine(value: ref string) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadUntil) fn TryReadUntil(delimiter: char, includeDelimiter: bool, value: ref string) -> Status;
        @Native @CppName(wio::runtime::std_console::ReadWord) fn TryReadWord(value: ref string) -> Status;
