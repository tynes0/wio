        @Native @CppName(wio::runtime::std_console::SetBackgroundColor) fn TrySetBackgroundColor(color: Color) -> Status;
        @Native @CppName(wio::runtime::std_console::GetForegroundColor) fn TryGetForegroundColor(color: ref Color) -> Status;
        @Native @CppName(wio::runtime::std_console::SetForegroundColor) fn TrySetForegroundColor(color: Color) -> Status;
