            return Result<string>(LastResultError());
        }

        fn ReadWordResult() -> Result<string> {
            return ReadWord();
        }

        fn InputUntil(delimiter: char, includeDelimiter: bool) -> Result<string> {
            let value = InputUntilRaw(delimiter, includeDelimiter);
            if (LastStatusCode() == Status::Ok) {
                return Result<string>(value);
            }

            return Result<string>(LastResultError());
        }

        fn InputUntil(delimiter: char) -> Result<string> {
            let value = InputUntilRaw(delimiter);
