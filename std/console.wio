        @Native @CppName(wio::runtime::std_console::SetBufferHeight) fn TrySetBufferHeight(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetBufferWidth) fn TryGetBufferWidth(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetBufferWidth) fn TrySetBufferWidth(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetCapsLock) fn TryGetCapsLock(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetCursorLeft) fn TryGetCursorLeft(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetCursorLeft) fn TrySetCursorLeft(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetCursorSize) fn TryGetCursorSize(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetCursorSize) fn TrySetCursorSize(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetCursorTop) fn TryGetCursorTop(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetCursorTop) fn TrySetCursorTop(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetCursorVisible) fn TryGetCursorVisible(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::SetCursorVisible) fn TrySetCursorVisible(value: bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetInputEncoding) fn TryGetInputEncoding(value: ref Encoding) -> Status;
        @Native @CppName(wio::runtime::std_console::SetInputEncoding) fn TrySetInputEncoding(value: Encoding) -> Status;
        @Native @CppName(wio::runtime::std_console::GetOutputEncoding) fn TryGetOutputEncoding(value: ref Encoding) -> Status;
        @Native @CppName(wio::runtime::std_console::SetOutputEncoding) fn TrySetOutputEncoding(value: Encoding) -> Status;
        @Native @CppName(wio::runtime::std_console::GetIsErrorRedirected) fn TryGetIsErrorRedirected(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetIsInputRedirected) fn TryGetIsInputRedirected(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetIsOutputRedirected) fn TryGetIsOutputRedirected(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetKeyAvailable) fn TryGetKeyAvailable(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetLargestWindowHeight) fn TryGetLargestWindowHeight(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetLargestWindowWidth) fn TryGetLargestWindowWidth(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetNumberLock) fn TryGetNumberLock(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetNewLine) fn TryGetNewLine(value: ref string) -> Status;
        @Native @CppName(wio::runtime::std_console::SetNewLine) fn TrySetNewLine(value: string) -> Status;
        @Native @CppName(wio::runtime::std_console::GetTitle) fn TryGetTitle(value: ref string) -> Status;
        @Native @CppName(wio::runtime::std_console::SetTitle) fn TrySetTitle(value: string) -> Status;
        @Native @CppName(wio::runtime::std_console::GetTreatControlCAsInput) fn TryGetTreatControlCAsInput(value: ref bool) -> Status;
        @Native @CppName(wio::runtime::std_console::SetTreatControlCAsInput) fn TrySetTreatControlCAsInput(value: bool) -> Status;
        @Native @CppName(wio::runtime::std_console::GetWindowHeight) fn TryGetWindowHeight(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowHeight) fn TrySetWindowHeight(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetWindowLeft) fn TryGetWindowLeft(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowLeft) fn TrySetWindowLeft(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetWindowTop) fn TryGetWindowTop(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowTop) fn TrySetWindowTop(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::GetWindowWidth) fn TryGetWindowWidth(value: ref i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowWidth) fn TrySetWindowWidth(value: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::Beep) fn TryBeep() -> Status;
        @Native @CppName(wio::runtime::std_console::Beep) fn TryBeep(frequency: i32, durationMs: i32) -> Status;
