            cursorSize: ref bool,
            bufferSize: ref bool,
            windowPosition: ref bool,
            windowSizeGet: ref bool,
            windowSizeSet: ref bool,
            largestWindowSize: ref bool,
            moveBufferArea: ref bool,
            keyAvailable: ref bool,
            readKey: ref bool,
            title: ref bool,
            beep: ref bool,
            beepFrequency: ref bool,
            keyboardToggleState: ref bool,
            treatControlCAsInput: ref bool,
            encodingSet: ref bool) -> Status;

