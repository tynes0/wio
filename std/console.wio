        fn GetReadKeyInfo(intercept: bool) -> Result<KeyInfo> {
            mut result: KeyInfo = KeyInfo();
            mut keyChar = 0;
            mut key = Key::None;
            mut modifiers = Modifiers::None;
            let status = TryReadKey(intercept, ref keyChar, ref key, ref modifiers);
            if (not Ok(status)) {
                return Result<KeyInfo>(LastResultError());
            }
            result.keyChar = keyChar;
            result.key = key;
            result.modifiers = modifiers;
            return Result<KeyInfo>(result);
        }

        fn GetReadKeyInfo() -> Result<KeyInfo> {
            mut result: KeyInfo = KeyInfo();
            mut keyChar = 0;
            mut key = Key::None;
            mut modifiers = Modifiers::None;
            let status = TryReadKey(ref keyChar, ref key, ref modifiers);
            if (not Ok(status)) {
