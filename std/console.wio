realm std {
    realm console {
        use @CppHeader("std_console.h");

        type Status = u8;
        type ErrorDomain = u8;
        type Color = u8;
        type Encoding = u8;
        type Key = i32;
        type Modifiers = u8;
        type SpecialKey = i32;

        const StatusOk: Status = 0u8;
        const StatusUnsupported: Status = 1u8;
        const StatusUnavailable: Status = 2u8;
        const StatusInvalidArgument: Status = 3u8;
        const StatusInvalidRange: Status = 4u8;
        const StatusNullArgument: Status = 5u8;
        const StatusInputRedirected: Status = 6u8;
        const StatusOutputRedirected: Status = 7u8;
        const StatusErrorRedirected: Status = 8u8;
        const StatusIoError: Status = 9u8;
        const StatusPartialIo: Status = 10u8;
        const StatusEndOfFile: Status = 11u8;
        const StatusEncodingError: Status = 12u8;
        const StatusFormatError: Status = 13u8;
        const StatusPermissionDenied: Status = 14u8;
        const StatusPlatformError: Status = 15u8;
        const StatusUnknownError: Status = 16u8;

        const DomainNone: ErrorDomain = 0u8;
        const DomainGeneric: ErrorDomain = 1u8;
        const DomainStdio: ErrorDomain = 2u8;
        const DomainWin32: ErrorDomain = 3u8;
        const DomainPosix: ErrorDomain = 4u8;
        const DomainTerminal: ErrorDomain = 5u8;
        const DomainFormatting: ErrorDomain = 6u8;

        const ColorBlack: Color = 0u8;
        const ColorDarkBlue: Color = 1u8;
        const ColorDarkGreen: Color = 2u8;
        const ColorDarkCyan: Color = 3u8;
        const ColorDarkRed: Color = 4u8;
        const ColorDarkMagenta: Color = 5u8;
        const ColorDarkYellow: Color = 6u8;
        const ColorGray: Color = 7u8;
        const ColorDarkGray: Color = 8u8;
        const ColorBlue: Color = 9u8;
        const ColorGreen: Color = 10u8;
        const ColorCyan: Color = 11u8;
        const ColorRed: Color = 12u8;
        const ColorMagenta: Color = 13u8;
        const ColorYellow: Color = 14u8;
        const ColorWhite: Color = 15u8;

        const EncodingUnknown: Encoding = 0u8;
        const EncodingUtf8: Encoding = 1u8;
        const EncodingUtf16: Encoding = 2u8;
        const EncodingSystemDefault: Encoding = 3u8;

        const ModifierNone: Modifiers = 0u8;
        const ModifierAlt: Modifiers = 1u8;
        const ModifierShift: Modifiers = 2u8;
        const ModifierControl: Modifiers = 4u8;

        const SpecialKeyControlC: SpecialKey = 0;
        const SpecialKeyControlBreak: SpecialKey = 1;

        component ErrorInfo {
            status: Status;
            domain: ErrorDomain;
            nativeCode: i32;
            line: i32;
            file: string;
        }

        component CapabilitiesInfo {
            colors: bool;
            cursorPosition: bool;
            cursorVisibility: bool;
            cursorSize: bool;
            bufferSize: bool;
            windowPosition: bool;
            windowSizeGet: bool;
            windowSizeSet: bool;
            largestWindowSize: bool;
            moveBufferArea: bool;
            keyAvailable: bool;
            readKey: bool;
            title: bool;
            beep: bool;
            beepFrequency: bool;
            keyboardToggleState: bool;
            treatControlCAsInput: bool;
            encodingSet: bool;
        }

        component CursorPositionInfo {
            left: i32;
            top: i32;
        }

        component SizeInfo {
            width: i32;
            height: i32;
        }

        component RectInfo {
            left: i32;
            top: i32;
            width: i32;
            height: i32;
        }

        component KeyInfo {
            keyChar: i32;
            key: Key;
            modifiers: Modifiers;
        }

        component StandardStreamInfo {
            redirected: bool;
            bufferSize: usize;
            hasReader: bool;
            hasWriter: bool;
            isOpen: bool;
        }

        fn Ok(status: Status) -> bool {
            return status == StatusOk;
        }

        fn Failed(status: Status) -> bool {
            return not Ok(status);
        }

        fn HasModifier(value: Modifiers, mask: Modifiers) -> bool {
            return (value & mask) != 0u8;
        }

        @Native
        @CppName(wio::runtime::std_console::ClearLastError)
        fn ClearLastError();

        @Native
        @CppName(wio::runtime::std_console::LastStatus)
        fn LastStatusCode() -> Status;

        @Native
        @CppName(wio::runtime::std_console::LastErrorDomain)
        fn LastErrorDomainCode() -> ErrorDomain;

        @Native
        @CppName(wio::runtime::std_console::LastNativeCode)
        fn LastNativeCode() -> i32;

        @Native
        @CppName(wio::runtime::std_console::LastErrorLine)
        fn LastErrorLine() -> i32;

        @Native
        @CppName(wio::runtime::std_console::LastErrorFile)
        fn LastErrorFile() -> string;

        @Native
        @CppName(wio::runtime::std_console::StatusName)
        fn StatusName(status: Status) -> string;

        @Native
        @CppName(wio::runtime::std_console::ErrorDomainName)
        fn ErrorDomainName(domain: ErrorDomain) -> string;

        fn LastError() -> ErrorInfo {
            mut result: ErrorInfo = ErrorInfo();
            result.status = LastStatusCode();
            result.domain = LastErrorDomainCode();
            result.nativeCode = LastNativeCode();
            result.line = LastErrorLine();
            result.file = LastErrorFile();
            return result;
        }

        @Native
        @CppName(wio::runtime::std_console::WriteValue)
        @Instantiate(string)
        @Instantiate(bool)
        @Instantiate(char)
        @Instantiate(i8)
        @Instantiate(i16)
        @Instantiate(i32)
        @Instantiate(i64)
        @Instantiate(u8)
        @Instantiate(u16)
        @Instantiate(u32)
        @Instantiate(u64)
        @Instantiate(f32)
        @Instantiate(f64)
        fn Print<T>(value: T) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLine)
        fn PrintLine() -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLineValue)
        @Instantiate(string)
        @Instantiate(bool)
        @Instantiate(char)
        @Instantiate(i8)
        @Instantiate(i16)
        @Instantiate(i32)
        @Instantiate(i64)
        @Instantiate(u8)
        @Instantiate(u16)
        @Instantiate(u32)
        @Instantiate(u64)
        @Instantiate(f32)
        @Instantiate(f64)
        fn PrintLine<T>(value: T) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteFormat)
        fn PrintFormat<Args...>(format: string, args: Args...) -> Status;

        @Native
        @CppName(wio::runtime::std_console::WriteLineFormat)
        fn PrintLineFormat<Args...>(format: string, args: Args...) -> Status;

        @Native
        @CppName(wio::runtime::std_console::Format)
        fn Format<Args...>(format: string, args: Args...) -> string;

        @Native
        @CppName(wio::runtime::std_console::WriteSegment)
        fn WriteSlice(value: string, index: usize, count: usize) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteTextDecimal)
        fn WriteDecimal(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLineTextDecimal)
        fn WriteDecimalLine(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorText)
        fn WriteError(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorLine)
        fn WriteErrorLine() -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorLineText)
        fn WriteErrorLine(value: string) -> i32;

        fn PrintSpace() -> i32 {
            return Print(" ");
        }

        fn Write<T>(value: T) -> i32 {
            return Print(value);
        }

        fn WriteLine<T>(value: T) -> i32 {
            return PrintLine(value);
        }

        fn WriteRepeat<T>(value: T, count: usize) -> i32 {
            mut index: usize = 0usize;
            while (index < count) {
                let result = Print(value);
                if (result != 0) {
                    return result;
                }
                index += 1usize;
            }
            return 0;
        }

        fn WriteJoined<T>(values: T[], separator: string) -> i32 {
            mut index: usize = 0usize;
            while (index < values.Count()) {
                if (index > 0usize) {
                    let separatorResult = Print(separator);
                    if (separatorResult != 0) {
                        return separatorResult;
                    }
                }

                let valueResult = Print(values[index]);
                if (valueResult != 0) {
                    return valueResult;
                }

                index += 1usize;
            }

            return 0;
        }

        fn WriteEachLine<T>(values: T[]) -> i32 {
            for value in values {
                let result = PrintLine(value);
                if (result != 0) {
                    return result;
                }
            }
            return 0;
        }

        @Native
        @CppName(wio::runtime::std_console::Input)
        fn Input(prompt: string) -> string;

        @Native
        @CppName(wio::runtime::std_console::Input)
        fn Input() -> string;

        @Native
        @CppName(wio::runtime::std_console::InputN)
        fn InputN(count: usize) -> string;

        @Native
        @CppName(wio::runtime::std_console::InputChar)
        fn InputChar(isHidden: bool) -> char;

        @Native
        @CppName(wio::runtime::std_console::InputChar)
        fn InputChar() -> char;

        @Native
        @CppName(wio::runtime::std_console::InputWord)
        fn InputWord() -> string;

        @Native
        @CppName(wio::runtime::std_console::InputUntil)
        fn InputUntil(delimiter: char, includeDelimiter: bool) -> string;

        @Native
        @CppName(wio::runtime::std_console::InputUntil)
        fn InputUntil(delimiter: char) -> string;

