        @Native @CppName(wio::runtime::std_console::SetBufferSize) fn TrySetBufferSize(width: i32, height: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetCursorPosition) fn TrySetCursorPosition(left: i32, top: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowPosition) fn TrySetWindowPosition(left: i32, top: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::SetWindowSize) fn TrySetWindowSize(width: i32, height: i32) -> Status;
        @Native @CppName(wio::runtime::std_console::FlushError) fn TryFlushError() -> Status;
        @Native @CppName(wio::runtime::std_console::FlushOut) fn TryFlushOut() -> Status;

        fn Capabilities() -> CapabilitiesInfo {
            mut result: CapabilitiesInfo = CapabilitiesInfo();
            mut colors = false;
            mut cursorPosition = false;
            mut cursorVisibility = false;
            mut cursorSize = false;
            mut bufferSize = false;
            mut windowPosition = false;
            mut windowSizeGet = false;
            mut windowSizeSet = false;
            mut largestWindowSize = false;
            mut moveBufferArea = false;
            mut keyAvailable = false;
            mut readKey = false;
            mut title = false;
            mut beep = false;
            mut beepFrequency = false;
            mut keyboardToggleState = false;
            mut treatControlCAsInput = false;
            mut encodingSet = false;
            TryCapabilities(
                ref colors,
                ref cursorPosition,
                ref cursorVisibility,
                ref cursorSize,
                ref bufferSize,
                ref windowPosition,
                ref windowSizeGet,
                ref windowSizeSet,
                ref largestWindowSize,
                ref moveBufferArea,
                ref keyAvailable,
                ref readKey,
                ref title,
                ref beep,
                ref beepFrequency,
                ref keyboardToggleState,
                ref treatControlCAsInput,
                ref encodingSet);
            result.colors = colors;
            result.cursorPosition = cursorPosition;
            result.cursorVisibility = cursorVisibility;
            result.cursorSize = cursorSize;
            result.bufferSize = bufferSize;
            result.windowPosition = windowPosition;
            result.windowSizeGet = windowSizeGet;
            result.windowSizeSet = windowSizeSet;
            result.largestWindowSize = largestWindowSize;
            result.moveBufferArea = moveBufferArea;
            result.keyAvailable = keyAvailable;
            result.readKey = readKey;
            result.title = title;
            result.beep = beep;
            result.beepFrequency = beepFrequency;
            result.keyboardToggleState = keyboardToggleState;
            result.treatControlCAsInput = treatControlCAsInput;
            result.encodingSet = encodingSet;
            return result;
        }

        fn GetCursorPositionInfo() -> CursorPositionInfo {
            mut result: CursorPositionInfo = CursorPositionInfo();
            mut left = 0;
            mut top = 0;
            TryGetCursorPosition(ref left, ref top);
            result.left = left;
            result.top = top;
            return result;
        }

        fn GetStandardErrorInfo(bufferSize: usize) -> StandardStreamInfo {
            mut result: StandardStreamInfo = StandardStreamInfo();
            mut redirected = false;
            mut actualBufferSize = 0usize;
            mut hasReader = false;
            mut hasWriter = false;
            mut isOpen = false;
            TryOpenStandardError(bufferSize, ref redirected, ref actualBufferSize, ref hasReader, ref hasWriter, ref isOpen);
            result.redirected = redirected;
            result.bufferSize = actualBufferSize;
            result.hasReader = hasReader;
            result.hasWriter = hasWriter;
            result.isOpen = isOpen;
            return result;
        }

        fn GetStandardInputInfo(bufferSize: usize) -> StandardStreamInfo {
            mut result: StandardStreamInfo = StandardStreamInfo();
            mut redirected = false;
            mut actualBufferSize = 0usize;
            mut hasReader = false;
            mut hasWriter = false;
            mut isOpen = false;
            TryOpenStandardInput(bufferSize, ref redirected, ref actualBufferSize, ref hasReader, ref hasWriter, ref isOpen);
            result.redirected = redirected;
            result.bufferSize = actualBufferSize;
            result.hasReader = hasReader;
            result.hasWriter = hasWriter;
            result.isOpen = isOpen;
            return result;
        }

        fn GetStandardOutputInfo(bufferSize: usize) -> StandardStreamInfo {
            mut result: StandardStreamInfo = StandardStreamInfo();
            mut redirected = false;
            mut actualBufferSize = 0usize;
            mut hasReader = false;
            mut hasWriter = false;
            mut isOpen = false;
            TryOpenStandardOutput(bufferSize, ref redirected, ref actualBufferSize, ref hasReader, ref hasWriter, ref isOpen);
            result.redirected = redirected;
            result.bufferSize = actualBufferSize;
            result.hasReader = hasReader;
            result.hasWriter = hasWriter;
            result.isOpen = isOpen;
            return result;
        }

        fn GetReadKeyInfo(intercept: bool) -> KeyInfo {
            mut result: KeyInfo = KeyInfo();
            mut keyChar = 0;
            mut key = 0;
            mut modifiers = 0u8;
            TryReadKey(intercept, ref keyChar, ref key, ref modifiers);
            result.keyChar = keyChar;
            result.key = key;
            result.modifiers = modifiers;
            return result;
        }

        fn GetReadKeyInfo() -> KeyInfo {
            mut result: KeyInfo = KeyInfo();
            mut keyChar = 0;
            mut key = 0;
            mut modifiers = 0u8;
            TryReadKey(ref keyChar, ref key, ref modifiers);
            result.keyChar = keyChar;
            result.key = key;
            result.modifiers = modifiers;
            return result;
        }

        fn BackgroundColorOr(fallback: Color) -> Color {
            mut value = fallback;
            TryGetBackgroundColor(ref value);
            return value;
        }

        fn ForegroundColorOr(fallback: Color) -> Color {
            mut value = fallback;
            TryGetForegroundColor(ref value);
            return value;
        }

        fn NewLineOr(fallback: string) -> string {
            mut value = fallback;
            TryGetNewLine(ref value);
            return value;
        }

        fn TitleOr(fallback: string) -> string {
            mut value = fallback;
            TryGetTitle(ref value);
            return value;
        }
    }
}
