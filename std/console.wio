use std::result;

realm std {
    realm console {
        use @CppHeader("std_console.h");

        type StatusCode = u8;

        @Native
        @Type(u8)
        @CppName(wio::runtime::console::ConsoleStatus)
        enum Status {
            Ok = 0u8,
            Unsupported = 1u8,
            Unavailable = 2u8,
            InvalidArgument = 3u8,
            InvalidRange = 4u8,
            NullArgument = 5u8,
            InputRedirected = 6u8,
            OutputRedirected = 7u8,
            ErrorRedirected = 8u8,
            IoError = 9u8,
            PartialIo = 10u8,
            EndOfFile = 11u8,
            EncodingError = 12u8,
            FormatError = 13u8,
            PermissionDenied = 14u8,
            PlatformError = 15u8,
            UnknownError = 16u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::console::ConsoleErrorDomain)
        enum ErrorDomain {
            None = 0u8,
            Generic = 1u8,
            Stdio = 2u8,
            Win32 = 3u8,
            Posix = 4u8,
            Terminal = 5u8,
            Formatting = 6u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::console::ConsoleColor)
        enum Color {
            Black = 0u8,
            DarkBlue = 1u8,
            DarkGreen = 2u8,
            DarkCyan = 3u8,
            DarkRed = 4u8,
            DarkMagenta = 5u8,
            DarkYellow = 6u8,
            Gray = 7u8,
            DarkGray = 8u8,
            Blue = 9u8,
            Green = 10u8,
            Cyan = 11u8,
            Red = 12u8,
            Magenta = 13u8,
            Yellow = 14u8,
            White = 15u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::console::ConsoleEncoding)
        enum Encoding {
            Unknown = 0u8,
            Utf8 = 1u8,
            Utf16 = 2u8,
            SystemDefault = 3u8
        };

