        const StatusOk: Status = Status::Ok;
        const StatusUnsupported: Status = Status::Unsupported;
        const StatusUnavailable: Status = Status::Unavailable;
        const StatusInvalidArgument: Status = Status::InvalidArgument;
        const StatusInvalidRange: Status = Status::InvalidRange;
        const StatusNullArgument: Status = Status::NullArgument;
        const StatusInputRedirected: Status = Status::InputRedirected;
        const StatusOutputRedirected: Status = Status::OutputRedirected;
        const StatusErrorRedirected: Status = Status::ErrorRedirected;
        const StatusIoError: Status = Status::IoError;
        const StatusPartialIo: Status = Status::PartialIo;
        const StatusEndOfFile: Status = Status::EndOfFile;
        const StatusEncodingError: Status = Status::EncodingError;
        const StatusFormatError: Status = Status::FormatError;
        const StatusPermissionDenied: Status = Status::PermissionDenied;
        const StatusPlatformError: Status = Status::PlatformError;
        const StatusUnknownError: Status = Status::UnknownError;

        const DomainNone: ErrorDomain = ErrorDomain::None;
        const DomainGeneric: ErrorDomain = ErrorDomain::Generic;
        const DomainStdio: ErrorDomain = ErrorDomain::Stdio;
        const DomainWin32: ErrorDomain = ErrorDomain::Win32;
        const DomainPosix: ErrorDomain = ErrorDomain::Posix;
        const DomainTerminal: ErrorDomain = ErrorDomain::Terminal;
        const DomainFormatting: ErrorDomain = ErrorDomain::Formatting;

        const ColorBlack: Color = Color::Black;
        const ColorDarkBlue: Color = Color::DarkBlue;
        const ColorDarkGreen: Color = Color::DarkGreen;
        const ColorDarkCyan: Color = Color::DarkCyan;
        const ColorDarkRed: Color = Color::DarkRed;
        const ColorDarkMagenta: Color = Color::DarkMagenta;
        const ColorDarkYellow: Color = Color::DarkYellow;
        const ColorGray: Color = Color::Gray;
        const ColorDarkGray: Color = Color::DarkGray;
        const ColorBlue: Color = Color::Blue;
        const ColorGreen: Color = Color::Green;
        const ColorCyan: Color = Color::Cyan;
        const ColorRed: Color = Color::Red;
        const ColorMagenta: Color = Color::Magenta;
        const ColorYellow: Color = Color::Yellow;
        const ColorWhite: Color = Color::White;

        const EncodingUnknown: Encoding = Encoding::Unknown;
        const EncodingUtf8: Encoding = Encoding::Utf8;
        const EncodingUtf16: Encoding = Encoding::Utf16;
        const EncodingSystemDefault: Encoding = Encoding::SystemDefault;

        const ModifierNone: Modifiers = Modifiers::None;
        const ModifierAlt: Modifiers = Modifiers::Alt;
        const ModifierShift: Modifiers = Modifiers::Shift;
        const ModifierControl: Modifiers = Modifiers::Control;

        const SpecialKeyControlC: SpecialKey = SpecialKey::ControlC;
        const SpecialKeyControlBreak: SpecialKey = SpecialKey::ControlBreak;

        component ErrorInfo {
            status: Status;
            domain: ErrorDomain;
            nativeCode: i32;
            line: i32;
            file: string;
        }

        component CapabilitiesInfo {
            colors: bool;
            cursorPosition: bool;
            cursorVisibility: bool;
            cursorSize: bool;
            bufferSize: bool;
            windowPosition: bool;
            windowSizeGet: bool;
            windowSizeSet: bool;
            largestWindowSize: bool;
            moveBufferArea: bool;
            keyAvailable: bool;
            readKey: bool;
            title: bool;
            beep: bool;
            beepFrequency: bool;
            keyboardToggleState: bool;
            treatControlCAsInput: bool;
            encodingSet: bool;
        }

        component CursorPositionInfo {
            left: i32;
            top: i32;
        }

        component SizeInfo {
            width: i32;
            height: i32;
        }

        component RectInfo {
            left: i32;
            top: i32;
            width: i32;
            height: i32;
        }

        component KeyInfo {
            keyChar: i32;
            key: Key;
            modifiers: Modifiers;
        }

        component StandardStreamInfo {
            redirected: bool;
            bufferSize: usize;
            hasReader: bool;
            hasWriter: bool;
            isOpen: bool;
        }

        fn Ok(status: StatusCode) -> bool {
            return status == 0u8;
        }

        fn Failed(status: StatusCode) -> bool {
            return not Ok(status);
        }

        fn HasModifier(value: Modifiers, mask: Modifiers) -> bool {
            return (value & mask) != Modifiers::None;
        }

        @Native
        @CppName(wio::runtime::std_console::ClearLastError)
        fn ClearLastError();

        @Native
        @CppName(wio::runtime::std_console::LastStatusValue)
        fn LastStatusCode() -> Status;

        @Native
        @CppName(wio::runtime::std_console::LastErrorDomainValue)
        fn LastErrorDomainCode() -> ErrorDomain;

        @Native
        @CppName(wio::runtime::std_console::LastNativeCode)
        fn LastNativeCode() -> i32;

        @Native
        @CppName(wio::runtime::std_console::LastErrorLine)
        fn LastErrorLine() -> i32;

        @Native
        @CppName(wio::runtime::std_console::LastErrorFile)
        fn LastErrorFile() -> string;

        @Native
        @CppName(wio::runtime::std_console::StatusName)
        fn StatusName(status: Status) -> string;

        @Native
        @CppName(wio::runtime::std_console::ErrorDomainName)
        fn ErrorDomainName(domain: ErrorDomain) -> string;

        @Native
        @CppName(wio::runtime::std_console::StatusValue)
        fn StatusCodeValue(status: Status) -> i32;

        fn LastError() -> ErrorInfo {
            mut result: ErrorInfo = ErrorInfo();
            result.status = LastStatusCode();
            result.domain = LastErrorDomainCode();
            result.nativeCode = LastNativeCode();
            result.line = LastErrorLine();
            result.file = LastErrorFile();
            return result;
        }

        fn LastResultError() -> ResultError {
            let error = LastError();
            let message = $"console error ${StatusName(error.status)} (${ErrorDomainName(error.domain)})";
            return MakeResultError(
                ResultDomain::console,
                StatusCodeValue(error.status),
                error.nativeCode fit i64,
                message
            );
        }

        fn ResultFromStatus(status: StatusCode) -> UnitResult {
            if (Ok(status)) {
                return UnitResult(ResultUnit());
            }

            return UnitResult(LastResultError());
        }

        @Native
        @CppName(wio::runtime::std_console::WriteValue)
        @Instantiate(string)
        @Instantiate(bool)
        @Instantiate(char)
        @Instantiate(i8)
        @Instantiate(i16)
        @Instantiate(i32)
        @Instantiate(i64)
        @Instantiate(u8)
        @Instantiate(u16)
        @Instantiate(u32)
        @Instantiate(u64)
        @Instantiate(f32)
        @Instantiate(f64)
        @Instantiate(text)
        fn PrintRaw<T>(value: T) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLine)
        fn PrintLineRaw() -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLineValue)
        @Instantiate(string)
        @Instantiate(bool)
        @Instantiate(char)
        @Instantiate(i8)
        @Instantiate(i16)
        @Instantiate(i32)
        @Instantiate(i64)
        @Instantiate(u8)
        @Instantiate(u16)
        @Instantiate(u32)
        @Instantiate(u64)
        @Instantiate(f32)
        @Instantiate(f64)
        @Instantiate(text)
        fn PrintLineRaw<T>(value: T) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteFormat)
        fn PrintFormatRaw<Args...>(format: string, args: Args...) -> StatusCode;

        @Native
        @CppName(wio::runtime::std_console::WriteLineFormat)
        fn PrintLineFormatRaw<Args...>(format: string, args: Args...) -> StatusCode;

        @Native
        @CppName(wio::runtime::std_console::Format)
        fn Format<Args...>(format: string, args: Args...) -> string;

        @Native
        @CppName(wio::runtime::std_console::WriteSegment)
        fn WriteSliceRaw(value: string, index: usize, count: usize) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteBuffer)
        fn WriteBufferRaw(buffer: string, index: i32, count: i32) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteTextDecimal)
        fn WriteDecimalRaw(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteLineTextDecimal)
        fn WriteDecimalLineRaw(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorText)
        fn WriteErrorRaw(value: string) -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorLine)
        fn WriteErrorLineRaw() -> i32;

        @Native
        @CppName(wio::runtime::std_console::WriteErrorLineText)
        fn WriteErrorLineRaw(value: string) -> i32;

        fn PrintSpace() -> UnitResult {
            return Print(" ");
        }

        fn Write<T>(value: T) -> UnitResult {
            return Print(value);
        }

        fn WriteLine<T>(value: T) -> UnitResult {
            return PrintLine(value);
        }

        fn WriteRepeat<T>(value: T, count: usize) -> UnitResult {
            mut index: usize = 0usize;
            while (index < count) {
                let result = Print(value);
                if (result.IsError()) {
                    return result;
                }
                index += 1usize;
            }
            return OkUnit();
        }

        fn WriteJoined<T>(values: T[], separator: string) -> UnitResult {
            mut index: usize = 0usize;
            while (index < values.Count()) {
                if (index > 0usize) {
                    let separatorResult = Write(separator);
                    if (separatorResult.IsError()) {
                        return separatorResult;
                    }
                }

                let valueResult = Write(values[index]);
                if (valueResult.IsError()) {
                    return valueResult;
                }

                index += 1usize;
            }

            return OkUnit();
        }

        fn WriteEachLine<T>(values: T[]) -> UnitResult {
            for value in values {
                let result = WriteLine(value);
                if (result.IsError()) {
                    return result;
                }
            }
            return OkUnit();
        }

        @Native
        @CppName(wio::runtime::std_console::Input)
        fn InputRaw(prompt: string) -> string;

        @Native
        @CppName(wio::runtime::std_console::Input)
        fn InputRaw() -> string;

        @Native
        @CppName(wio::runtime::std_console::InputN)
        fn InputNRaw(count: usize) -> string;

        @Native
        @CppName(wio::runtime::std_console::InputChar)
        fn InputCharRaw(isHidden: bool) -> char;

        @Native
        @CppName(wio::runtime::std_console::InputChar)
        fn InputCharRaw() -> char;

        @Native
        @CppName(wio::runtime::std_console::InputWord)
        fn InputWordRaw() -> string;

        @Native
        @CppName(wio::runtime::std_console::InputUntil)
        fn InputUntilRaw(delimiter: char, includeDelimiter: bool) -> string;

        @Native
        @CppName(wio::runtime::std_console::InputUntil)
        fn InputUntilRaw(delimiter: char) -> string;

        fn Print<T>(value: T) -> UnitResult {
            let status = PrintRaw(value);
            if (status == 0) {
                return UnitResult(ResultUnit());
            }

            return UnitResult(LastResultError());
        }

        fn PrintResult<T>(value: T) -> UnitResult {
            return Print(value);
        }

        fn PrintLine() -> UnitResult {
            let status = PrintLineRaw();
            if (status == 0) {
                return UnitResult(ResultUnit());
            }

            return UnitResult(LastResultError());
        }

        fn PrintLineResult() -> UnitResult {
            return PrintLine();
        }

        fn PrintLine<T>(value: T) -> UnitResult {
            let status = PrintLineRaw(value);
            if (status == 0) {
                return UnitResult(ResultUnit());
            }

            return UnitResult(LastResultError());
        }

        fn PrintLineResult<T>(value: T) -> UnitResult {
            return PrintLine(value);
        }

        fn PrintFormat<Args...>(format: string, args: Args...) -> UnitResult {
            return ResultFromStatus(PrintFormatRaw(format, args...));
        }

        fn PrintLineFormat<Args...>(format: string, args: Args...) -> UnitResult {
            return ResultFromStatus(PrintLineFormatRaw(format, args...));
        }

        fn WriteSlice(value: string, index: usize, count: usize) -> UnitResult {
            return ResultFromStatus(WriteSliceRaw(value, index, count) fit u8);
        }

        fn WriteBuffer(buffer: string, index: i32, count: i32) -> UnitResult {
            return ResultFromStatus(WriteBufferRaw(buffer, index, count) fit u8);
        }

        fn WriteDecimal(value: string) -> UnitResult {
            return ResultFromStatus(WriteDecimalRaw(value) fit u8);
        }

        fn WriteDecimalLine(value: string) -> UnitResult {
            return ResultFromStatus(WriteDecimalLineRaw(value) fit u8);
        }

        fn WriteError(value: string) -> UnitResult {
            return ResultFromStatus(WriteErrorRaw(value) fit u8);
        }

        fn WriteErrorLine() -> UnitResult {
            return ResultFromStatus(WriteErrorLineRaw() fit u8);
        }

        fn WriteErrorLine(value: string) -> UnitResult {
            return ResultFromStatus(WriteErrorLineRaw(value) fit u8);
        }

        fn Input(prompt: string) -> Result<string> {
            let value = InputRaw(prompt);
            if (LastStatusCode() == Status::Ok) {
                return Result<string>(value);
            }

            return Result<string>(LastResultError());
        }

        fn InputResult(prompt: string) -> Result<string> {
            return Input(prompt);
        }

        fn Input() -> Result<string> {
            let value = InputRaw();
            if (LastStatusCode() == Status::Ok) {
                return Result<string>(value);
            }

            return Result<string>(LastResultError());
        }

        fn InputResult() -> Result<string> {
            return Input();
        }

        fn InputN(count: usize) -> Result<string> {
            let value = InputNRaw(count);
            if (LastStatusCode() == Status::Ok) {
                return Result<string>(value);
            }

            return Result<string>(LastResultError());
        }

        fn InputChar(isHidden: bool) -> Result<char> {
            let value = InputCharRaw(isHidden);
            if (LastStatusCode() == Status::Ok) {
                return Result<char>(value);
            }

            return Result<char>(LastResultError());
        }

        fn InputChar() -> Result<char> {
            let value = InputCharRaw();
            if (LastStatusCode() == Status::Ok) {
                return Result<char>(value);
            }

            return Result<char>(LastResultError());
        }

        fn ReadLine() -> Result<string> {
            mut value = "";
            let status = TryReadLine(ref value);
            if (Ok(status)) {
                return Result<string>(value);
            }

            return Result<string>(LastResultError());
        }

        fn ReadLineResult() -> Result<string> {
            return ReadLine();
        }

        fn ReadWord() -> Result<string> {
            mut value = "";
            let status = TryReadWord(ref value);
