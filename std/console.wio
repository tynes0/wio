            result.keyChar = keyChar;
            result.key = key;
            result.modifiers = modifiers;
            return Result<KeyInfo>(result);
        }

        fn BackgroundColorOr(fallback: Color) -> Color {
            mut value = fallback;
            TryGetBackgroundColor(ref value);
            return value;
        }

        fn ForegroundColorOr(fallback: Color) -> Color {
            mut value = fallback;
            TryGetForegroundColor(ref value);
            return value;
        }

        fn NewLineOr(fallback: string) -> string {
            mut value = fallback;
            TryGetNewLine(ref value);
            return value;
        }

        fn TitleOr(fallback: string) -> string {
            mut value = fallback;
            TryGetTitle(ref value);
            return value;
        }
