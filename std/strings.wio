use std::option as option;

realm std {
    realm strings {
        use @CppHeader("std_text.h");

        @Native
        @CppName(wio::runtime::std_text::StringIsAscii)
        fn IsAscii(value: string) -> bool;

        @Native
        @CppName(wio::runtime::std_text::StringEqualsIgnoreCase)
        fn EqualsIgnoreCase(left: string, right: string) -> bool;

        @Native
        @CppName(wio::runtime::std_text::StringCompare)
        fn Compare(left: string, right: string) -> i32;

        @Native
        @CppName(wio::runtime::std_text::StringCompareIgnoreCase)
        fn CompareIgnoreCase(left: string, right: string) -> i32;

        @Native
        @CppName(wio::runtime::std_text::StringContainsIgnoreCase)
        fn ContainsIgnoreCase(value: string, target: string) -> bool;

        @Native
        @CppName(wio::runtime::std_text::StringStartsWithIgnoreCase)
        fn StartsWithIgnoreCase(value: string, prefix: string) -> bool;

        @Native
        @CppName(wio::runtime::std_text::StringEndsWithIgnoreCase)
        fn EndsWithIgnoreCase(value: string, suffix: string) -> bool;

        @Native
        @CppName(wio::runtime::std_text::StringCountOccurrences)
        fn CountOccurrences(value: string, needle: string) -> usize;

        @Native
        @CppName(wio::runtime::std_text::StringSplitWhitespace)
        fn SplitWhitespace(value: string) -> string[];

        @Native
        @CppName(wio::runtime::std_text::StringCollapseWhitespace)
        fn CollapseWhitespace(value: string) -> string;

        fn Count(value: string) -> usize {
            return value.Count();
        }

        fn Empty(value: string) -> bool {
            return value.Empty();
        }

        fn IsEmpty(value: string) -> bool {
            return value.Empty();
        }

        fn IsNullOrWhiteSpace(value: string) -> bool {
            return value.Trim().Empty();
        }

        fn Contains(value: string, target: string) -> bool {
            return value.Contains(target);
        }

        fn ContainsChar(value: string, target: char) -> bool {
            return value.ContainsChar(target);
        }

        fn StartsWith(value: string, prefix: string) -> bool {
            return value.StartsWith(prefix);
        }

        fn EndsWith(value: string, suffix: string) -> bool {
            return value.EndsWith(suffix);
        }

        fn IndexOf(value: string, target: string) -> usize {
            return value.IndexOf(target);
        }

        fn LastIndexOf(value: string, target: string) -> usize {
            return value.LastIndexOf(target);
        }

        fn IndexOfChar(value: string, target: char) -> usize {
            return value.IndexOfChar(target);
        }

        fn LastIndexOfChar(value: string, target: char) -> usize {
            return value.LastIndexOfChar(target);
        }

        fn FirstOr(value: string, fallback: char) -> char {
            return value.GetOr(0usize, fallback);
        }

        fn LastOr(value: string, fallback: char) -> char {
            if (value.Empty()) {
                return fallback;
            }
            return value.Last();
        }

        fn GetOr(value: string, index: usize, fallback: char) -> char {
            return value.GetOr(index, fallback);
        }

        fn First(value: string) -> std::Option<char> {
            if (value.Empty()) { return std::None<char>(); }
            return std::Some<char>(value[0usize]);
        }

        fn Last(value: string) -> std::Option<char> {
            if (value.Empty()) { return std::None<char>(); }
            return std::Some<char>(value.Last());
        }

        fn Get(value: string, index: usize) -> std::Option<char> {
            return value.Get(index);
        }

        fn At(value: string, index: usize) -> char {
            return value.At(index);
        }

        fn Slice(value: string, start: usize) -> string {
            return value.Slice(start);
        }

        fn Slice(value: string, start: usize, count: usize) -> string {
            return value.Slice(start, count);
        }

        fn SliceFrom(value: string, start: usize) -> string {
            return value.SliceFrom(start);
        }

        fn Take(value: string, count: usize) -> string {
            return value.Take(count);
        }

        fn Skip(value: string, count: usize) -> string {
            return value.Skip(count);
        }

        fn Left(value: string, count: usize) -> string {
            return value.Left(count);
        }

        fn Right(value: string, count: usize) -> string {
            return value.Right(count);
        }

        fn RemovePrefix(value: string, prefix: string) -> string {
            if (value.StartsWith(prefix)) {
                return value.Skip(prefix.Count());
            }
            return value;
        }

        fn RemoveSuffix(value: string, suffix: string) -> string {
            if (value.EndsWith(suffix)) {
                return value.Take(value.Count() - suffix.Count());
            }
            return value;
        }

        fn EnsurePrefix(value: string, prefix: string) -> string {
            if (value.StartsWith(prefix)) {
                return value;
            }
            return prefix + value;
        }

        fn EnsureSuffix(value: string, suffix: string) -> string {
            if (value.EndsWith(suffix)) {
                return value;
            }
            return value + suffix;
        }

        fn BeforeFirst(value: string, separator: string) -> string {
            let index = value.IndexOf(separator);
            if (index < 0isize) {
                return value;
            }
            return value.Take(index fit usize);
        }

        fn AfterFirst(value: string, separator: string) -> string {
            let index = value.IndexOf(separator);
            if (index < 0isize) {
                return "";
            }
            return value.Skip((index fit usize) + separator.Count());
        }

        fn BeforeLast(value: string, separator: string) -> string {
            let index = value.LastIndexOf(separator);
            if (index < 0isize) {
                return value;
            }
            return value.Take(index fit usize);
        }

        fn AfterLast(value: string, separator: string) -> string {
            let index = value.LastIndexOf(separator);
            if (index < 0isize) {
                return "";
            }
            return value.Skip((index fit usize) + separator.Count());
        }

        fn Trim(value: string) -> string {
            return value.Trim();
        }

        fn TrimStart(value: string) -> string {
            return value.TrimStart();
        }

        fn TrimEnd(value: string) -> string {
            return value.TrimEnd();
        }

        fn ToLower(value: string) -> string {
            return value.ToLower();
        }

        fn ToUpper(value: string) -> string {
            return value.ToUpper();
        }

        fn Capitalize(value: string) -> string {
            if (value.Empty()) {
                return value;
            }
            return value.Take(1usize).ToUpper() + value.Skip(1usize);
        }

        fn Uncapitalize(value: string) -> string {
            if (value.Empty()) {
                return value;
            }
            return value.Take(1usize).ToLower() + value.Skip(1usize);
        }

        fn Truncate(value: string, maxLength: usize) -> string {
            if (value.Count() <= maxLength) {
                return value;
            }
            return value.Take(maxLength);
        }

        fn Truncate(value: string, maxLength: usize, suffix: string) -> string {
            if (value.Count() <= maxLength) {
                return value;
            }
            if (suffix.Count() >= maxLength) {
                return suffix.Take(maxLength);
            }
            return value.Take(maxLength - suffix.Count()) + suffix;
        }

        fn Replace(value: string, needle: string, replacement: string) -> string {
            return value.Replace(needle, replacement);
        }

        fn ReplaceFirst(value: string, needle: string, replacement: string) -> string {
            return value.ReplaceFirst(needle, replacement);
        }

        fn Repeat(value: string, count: usize) -> string {
            return value.Repeat(count);
        }

        fn Split(value: string, separator: string) -> string[] {
            return value.Split(separator);
        }

        fn Lines(value: string) -> string[] {
            return value.Lines();
        }

        fn PadLeft(value: string, width: usize, fill: char) -> string {
            return value.PadLeft(width, fill);
        }

        fn PadRight(value: string, width: usize, fill: char) -> string {
            return value.PadRight(width, fill);
        }

        fn Reversed(value: string) -> string {
            return value.Reversed();
        }

        fn Join(values: string[], separator: string) -> string {
            return values.Join(separator);
        }

        fn Concat(values: string[]) -> string {
            return values.Join("");
        }

        fn Appended(target: string, value: string) -> string {
            mut current = target;
            current.Append(value);
            return current;
        }

        fn Pushed(target: string, value: char) -> string {
            mut current = target;
            current.Push(value);
            return current;
        }

        fn Inserted(target: string, index: usize, value: string) -> string {
            mut current = target;
            current.Insert(index, value);
            return current;
        }

        fn Erased(target: string, index: usize, count: usize) -> string {
            mut current = target;
            current.Erase(index, count);
            return current;
        }
    }
}
