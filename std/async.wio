use std::concurrency as concurrency;
use std::option as option;

realm std {
    realm async {
        using cpp::header("std_async.h");

        // Marker contracts for values that may cross executor boundaries.
        // Value components composed only from transfer-safe fields are Send
        // automatically; owning objects opt in after providing synchronization.
        interface Send {}
        interface Sync {}

        type Task<T> = coroutine<T>;

        enum TaskStatus {
            pending,
            ready,
            failed,
            cancelled
        };

        object TaskPoll<T> {
            private status: TaskStatus;
            private value: std::Option<T>;
            private failure: string;

            public fn OnConstruct(status: TaskStatus, value: std::Option<T>, failure: string) {
                self.status = status;
                self.value = value;
                self.failure = failure;
            }

            public fn Status() -> TaskStatus { return self.status; }
            public fn IsPending() -> bool { return self.status == TaskStatus::pending; }
            public fn IsReady() -> bool { return self.status == TaskStatus::ready; }
            public fn IsFailed() -> bool { return self.status == TaskStatus::failed; }
            public fn IsCancelled() -> bool { return self.status == TaskStatus::cancelled; }
            public fn Value() -> std::Option<T> { return self.value; }
            public fn Failure() -> string { return self.failure; }
        }

        object VoidTaskPoll {
            private status: TaskStatus;
            private failure: string;

            public fn OnConstruct(status: TaskStatus, failure: string) {
                self.status = status;
                self.failure = failure;
            }

            public fn Status() -> TaskStatus { return self.status; }
            public fn IsPending() -> bool { return self.status == TaskStatus::pending; }
            public fn IsReady() -> bool { return self.status == TaskStatus::ready; }
            public fn IsFailed() -> bool { return self.status == TaskStatus::failed; }
            public fn IsCancelled() -> bool { return self.status == TaskStatus::cancelled; }
            public fn Failure() -> string { return self.failure; }
        }

        object Selection<T> {
            private index: usize;
            private value: T;

            public fn OnConstruct(index: usize, value: T) {
                self.index = index;
                self.value = value;
            }

            public fn Index() -> usize { return self.index; }
            public fn Value() -> T { return self.value; }
        }

        fn Sleep(milliseconds: u64) -> coroutine<void>
            with native, cpp::name(wio::runtime::AsyncSleep);

        fn Yield() -> coroutine<void>
            with native, cpp::name(wio::runtime::AsyncYield);

        fn BlockOn<T>(task: coroutine<T>) -> T
            with native, cpp::name(wio::runtime::BlockOn);

        fn BlockOn(task: coroutine<void>)
            with native, cpp::name(wio::runtime::BlockOn);

        fn Start<T>(task: coroutine<T>) -> coroutine<T>
            with native, cpp::name(wio::runtime::StartAsync);

        fn IsReady<T>(task: coroutine<T>) -> bool
            with native, cpp::name(wio::runtime::AsyncReady);

        fn IsCancelled<T>(task: coroutine<T>) -> bool
            with native, cpp::name(wio::runtime::AsyncCancelledStatus);

        fn IsFaulted<T>(task: coroutine<T>) -> bool
            with native, cpp::name(wio::runtime::AsyncFaulted);

        fn FailureMessage<T>(task: coroutine<T>) -> string
            with native, cpp::name(wio::runtime::AsyncFailureMessage);

        fn WaitFor<T>(task: coroutine<T>, milliseconds: u64) -> bool
            with native, cpp::name(wio::runtime::AsyncWaitFor);

        fn Cancel<T>(task: coroutine<T>)
            with native, cpp::name(wio::runtime::CancelAsync);

        fn CancelAfter<T>(task: coroutine<T>, milliseconds: u64) -> coroutine<void>
            with native, cpp::name(wio::runtime::CancelAfter);

        fn Detach<T>(task: coroutine<T>)
            with native, cpp::name(wio::runtime::DetachAsync);

        fn Poll<T>(task: coroutine<T>) -> TaskPoll<T> {
            if (IsCancelled(task)) {
                return TaskPoll<T>(TaskStatus::cancelled, std::None<T>(), "");
            }
            if (IsReady(task) == false) {
                return TaskPoll<T>(TaskStatus::pending, std::None<T>(), "");
            }
            if (IsFaulted(task)) {
                return TaskPoll<T>(TaskStatus::failed, std::None<T>(), FailureMessage(task));
            }
            return TaskPoll<T>(TaskStatus::ready, std::Some<T>(BlockOn<T>(task)), "");
        }

        fn Poll(task: coroutine<void>) -> VoidTaskPoll {
            if (IsCancelled(task)) {
                return VoidTaskPoll(TaskStatus::cancelled, "");
            }
            if (IsReady(task) == false) {
                return VoidTaskPoll(TaskStatus::pending, "");
            }
            if (IsFaulted(task)) {
                return VoidTaskPoll(TaskStatus::failed, FailureMessage(task));
            }
            return VoidTaskPoll(TaskStatus::ready, "");
        }

        fn Run<T>(action: fn() -> T) -> coroutine<T>
            with native, cpp::name(wio::runtime::RunAsync);

        fn Run(action: fn()) -> coroutine<void>
            with native, cpp::name(wio::runtime::RunAsync);

        fn RunBlocking<T>(action: fn() -> T) -> coroutine<T>
            with native, cpp::name(wio::runtime::RunBlockingAsync);

        fn RunBlocking(action: fn()) -> coroutine<void>
            with native, cpp::name(wio::runtime::RunBlockingAsync);

        fn All<T>(tasks: coroutine<T>[]) -> coroutine<T[]>
            with native, cpp::name(wio::runtime::WhenAll);

        fn All(tasks: coroutine<void>[]) -> coroutine<void>
            with native, cpp::name(wio::runtime::WhenAll);

        fn Any<T>(tasks: coroutine<T>[]) -> coroutine<usize>
            with native, cpp::name(wio::runtime::WhenAny);

        fn Race<T>(tasks: coroutine<T>[]) -> coroutine<T>
            with native, cpp::name(wio::runtime::Race);

        async fn Select<T>(tasks: coroutine<T>[]) -> Selection<T> {
            let winner = await Any<T>(tasks);
            let value = await tasks[winner];
            mut index = 0usize;
            for (task in tasks) {
                if (index != winner) { Cancel<T>(task); }
                index += 1usize;
            }
            return Selection<T>(winner, value);
        }

        fn Timeout<T>(task: coroutine<T>, milliseconds: u64) -> coroutine<T>
            with native, cpp::name(wio::runtime::WithTimeout);

        fn Timeout(task: coroutine<void>, milliseconds: u64) -> coroutine<void>
            with native, cpp::name(wio::runtime::WithTimeout);

        realm detail {
            async fn PresentWhenReady<T>(task: coroutine<T>) -> std::Option<T> {
                return std::Some<T>(await task);
            }

            async fn AbsentAfter<T>(milliseconds: u64) -> std::Option<T> {
                await std::async::Sleep(milliseconds);
                return std::None<T>();
            }

            async fn CompletedWhenReady(task: coroutine<void>) -> bool {
                await task;
                return true;
            }

            async fn IncompleteAfter(milliseconds: u64) -> bool {
                await std::async::Sleep(milliseconds);
                return false;
            }
        }

        async fn TimeoutOption<T>(task: coroutine<T>, milliseconds: u64) -> std::Option<T> {
            let candidates: coroutine<std::Option<T> >[] = [
                detail::PresentWhenReady<T>(task),
                detail::AbsentAfter<T>(milliseconds)
            ];
            let result = await Race(candidates);
            if (result.IsNone()) { Cancel<T>(task); }
            return result;
        }

        async fn TimeoutCompleted(task: coroutine<void>, milliseconds: u64) -> bool {
            let candidates: coroutine<bool>[] = [
                detail::CompletedWhenReady(task),
                detail::IncompleteAfter(milliseconds)
            ];
            let completed = await Race(candidates);
            if (not completed) { Cancel<void>(task); }
            return completed;
        }

        fn WorkerCount() -> u64
            with native, cpp::name(wio::runtime::AsyncWorkerCount);

        fn BlockingWorkerCount() -> u64
            with native, cpp::name(wio::runtime::AsyncBlockingWorkerCount);

        fn BlockingQueueCapacity() -> u64
            with native, cpp::name(wio::runtime::AsyncBlockingQueueCapacity);

        fn BlockingPendingCount() -> u64
            with native, cpp::name(wio::runtime::AsyncBlockingPendingCount);

        fn IsRuntimeRunning() -> bool
            with native, cpp::name(wio::runtime::AsyncRuntimeRunning);

        fn ShutdownRuntime()
            with native, cpp::name(wio::runtime::ShutdownAsyncRuntime);

        type CancellationToken = concurrency::CancellationToken;

        object CancellationSource {
            private token: CancellationToken;

            public fn OnConstruct() {
                self.token = CancellationToken();
            }

            public fn Token() -> CancellationToken { return self.token; }
            public fn Cancel() { self.token.Cancel(); }
            public fn IsCancelled() -> bool { return self.token.IsCancelled(); }
        }

        fn ScopeCreate() -> opaque
            with native, cpp::name(wio::runtime::AsyncScopeCreate);

        fn ScopeDestroy(handle: opaque)
            with native, cpp::name(wio::runtime::AsyncScopeDestroy);

        fn ScopeSpawn<T>(handle: opaque, task: coroutine<T>) -> coroutine<T>
            with native, cpp::name(wio::runtime::AsyncScopeSpawn);

        fn ScopeJoin(handle: opaque) -> coroutine<void>
            with native, cpp::name(wio::runtime::AsyncScopeJoin);

        fn ScopeCancel(handle: opaque)
            with native, cpp::name(wio::runtime::AsyncScopeCancel);

        fn ScopeCount(handle: opaque) -> u64
            with native, cpp::name(wio::runtime::AsyncScopeCount);

        fn ScopeClosed(handle: opaque) -> bool
            with native, cpp::name(wio::runtime::AsyncScopeClosed);

        fn ScopeDeadline(handle: opaque, milliseconds: u64) -> bool
            with native, cpp::name(wio::runtime::AsyncScopeDeadline);

        object Scope {
            private handle: opaque;
            private disposed: bool;

            public fn OnConstruct() {
                self.handle = ScopeCreate();
                self.disposed = false;
            }

            public fn OnConstruct(deadlineMilliseconds: u64) {
                self.handle = ScopeCreate();
                self.disposed = false;
                ScopeDeadline(self.handle, deadlineMilliseconds);
            }

            public fn Spawn<T>(task: Task<T>) -> Task<T> {
                return ScopeSpawn<T>(self.handle, task);
            }

            public async fn Join() {
                await ScopeJoin(self.handle);
            }

            public fn Cancel() { ScopeCancel(self.handle); }
            public fn Count() -> u64 { return ScopeCount(self.handle); }
            public fn IsClosed() -> bool { return ScopeClosed(self.handle); }
            public fn SetDeadline(milliseconds: u64) -> bool {
                return ScopeDeadline(self.handle, milliseconds);
            }

            public fn OnDestruct() {
                if (not self.disposed) {
                    ScopeDestroy(self.handle);
                    self.disposed = true;
                }
            }
        }

        async fn SleepCancellable(
            milliseconds: u64,
            token: CancellationToken,
            pollMilliseconds: u64 = 10u64
        ) -> bool {
            if (token.IsCancelled()) { return false; }
            let quantum = pollMilliseconds == 0u64 ? 1u64 : pollMilliseconds;

            mut remaining = milliseconds;
            while (remaining > 0u64) {
                if (token.IsCancelled()) { return false; }
                let slice = remaining < quantum ? remaining : quantum;
                await Sleep(slice);
                remaining -= slice;
            }
            return not token.IsCancelled();
        }

        @From(Send, Sync)
        object Dispatcher {
            private gate: concurrency::Mutex;
            private actions: fn()[];

            public fn OnConstruct() {
                self.gate = concurrency::Mutex();
                self.actions = [];
            }

            public fn Post(action: fn()) {
                self.gate.Lock();
                self.actions.Push(action);
                self.gate.Unlock();
            }

            public fn Count() -> usize {
                self.gate.Lock();
                let count = self.actions.Count();
                self.gate.Unlock();
                return count;
            }

            public fn Drain() -> usize {
                mut count = 0usize;
                while (true) {
                    self.gate.Lock();
                    if (self.actions.Empty()) {
                        self.gate.Unlock();
                        return count;
                    }
                    let action = self.actions[0usize];
                    self.actions.RemoveAt(0usize);
                    self.gate.Unlock();
                    action();
                    count += 1usize;
                }
                return count;
            }
        }

        object TaskGroup<T> {
            private tasks: coroutine<T>[];
            private joined: bool;

            public fn OnConstruct() {
                self.tasks = [];
                self.joined = false;
            }

            public fn Spawn(task: coroutine<T>) -> bool {
                if (self.joined) { return false; }
                self.tasks.Push(Start<T>(task));
                return true;
            }

            public fn Count() -> usize { return self.tasks.Count(); }

            public async fn JoinAll() -> T[] {
                self.joined = true;
                let values = await All<T>(self.tasks);
                self.tasks.Clear();
                return values;
            }

            public fn CancelAll() {
                for (task in self.tasks) { Cancel<T>(task); }
                self.tasks.Clear();
                self.joined = true;
            }

            public fn OnDestruct() { self.CancelAll(); }
        }

        object VoidTaskGroup {
            private tasks: coroutine<void>[];
            private joined: bool;

            public fn OnConstruct() {
                self.tasks = [];
                self.joined = false;
            }

            public fn Spawn(task: coroutine<void>) -> bool {
                if (self.joined) { return false; }
                self.tasks.Push(Start<void>(task));
                return true;
            }

            public fn Count() -> usize { return self.tasks.Count(); }

            public async fn JoinAll() {
                self.joined = true;
                await All(self.tasks);
                self.tasks.Clear();
            }

            public fn CancelAll() {
                for (task in self.tasks) { Cancel<void>(task); }
                self.tasks.Clear();
                self.joined = true;
            }

            public fn OnDestruct() { self.CancelAll(); }
        }
    }
}
