use std::convert as convert;
use std::option as option;
use std::result as result;
use std::serialization as serialization;
use std::unicode as unicode;

realm std {
    realm json {
        @Type(u8)
        enum Kind {
            null_value = 0u8,
            boolean = 1u8,
            integer = 2u8,
            number = 3u8,
            string_value = 4u8,
            array_value = 5u8,
            object_value = 6u8
        };

        @Type(u8)
        enum DuplicateKeyPolicy {
            reject = 0u8,
            keep_first = 1u8,
            keep_last = 2u8
        };

        component ParseOptions {
            maxDepth: usize;
            maxBytes: usize;
            duplicateKeys: DuplicateKeyPolicy;
        };

        object Value {
            public kind: Kind;
            public booleanValue: bool;
            public integerText: string;
            public numberValue: f64;
            public stringValue: string;
            public arrayValue: Value[];
            public objectValue: Dict<string, Value>;

            public fn IsNull() -> bool { return self.kind == Kind::null_value; }
            public fn IsBool() -> bool { return self.kind == Kind::boolean; }
            public fn IsInteger() -> bool { return self.kind == Kind::integer; }
            public fn IsNumber() -> bool { return self.kind == Kind::number; }
            public fn IsString() -> bool { return self.kind == Kind::string_value; }
            public fn IsArray() -> bool { return self.kind == Kind::array_value; }
            public fn IsObject() -> bool { return self.kind == Kind::object_value; }
            public fn Count() -> usize {
                if (self.IsArray()) { return self.arrayValue.Count(); }
                if (self.IsObject()) { return self.objectValue.Count(); }
                return 0usize;
            }
            public fn BoolOr(fallback: bool) -> bool {
                if (self.IsBool()) { return self.booleanValue; }
                return fallback;
            }
            public fn NumberOr(fallback: f64) -> f64 {
                if (self.IsNumber()) { return self.numberValue; }
                return fallback;
            }
            public fn IntegerTextOr(fallback: string) -> string {
                if (self.IsInteger()) { return self.integerText; }
                return fallback;
            }
            public fn I64() -> std::Result<i64> {
                if (not self.IsInteger()) {
                    return std::Err<i64>(std::MakeResultError(
                        std::ResultDomain::custom, 3, "JSON value is not an integer."));
                }
                return convert::ParseI64(self.integerText);
            }
            public fn StringOr(fallback: string) -> string {
                if (self.IsString()) { return self.stringValue; }
                return fallback;
            }
            public fn At(index: usize) -> std::Option<Value> {
                if (not self.IsArray() or index >= self.arrayValue.Count()) { return std::None<Value>(); }
                return std::Some<Value>(self.arrayValue[index]);
            }
            public fn Get(key: string) -> std::Option<Value> {
                if (not self.IsObject() or not self.objectValue.ContainsKey(key)) { return std::None<Value>(); }
                return std::Some<Value>(self.objectValue.GetOr(key, NullValue()));
            }
            public fn Contains(key: string) -> bool {
                return self.IsObject() and self.objectValue.ContainsKey(key);
            }
        }

        fn NullValue() -> Value {
            mut value = Value();
            value.kind = Kind::null_value;
            return value;
        }

        fn BoolValue(value: bool) -> Value {
            mut result = Value();
            result.kind = Kind::boolean;
            result.booleanValue = value;
            return result;
        }

        fn NumberValue(value: f64) -> Value {
            mut result = Value();
            result.kind = Kind::number;
            result.numberValue = value;
            return result;
        }

        fn IntegerValue(value: string) -> Value {
            mut result = Value();
            result.kind = Kind::integer;
            result.integerText = value;
            return result;
        }

        fn DefaultParseOptions() -> ParseOptions {
            mut options = ParseOptions();
            options.maxDepth = 128usize;
            options.maxBytes = 16usize * 1024usize * 1024usize;
            options.duplicateKeys = DuplicateKeyPolicy::reject;
            return options;
        }

        fn StringValue(value: string) -> Value {
            mut result = Value();
            result.kind = Kind::string_value;
            result.stringValue = value;
            return result;
        }

        fn ArrayValue(values: Value[]) -> Value {
            mut result = Value();
            result.kind = Kind::array_value;
            result.arrayValue = values;
            return result;
        }

        fn ObjectValue(values: Dict<string, Value>) -> Value {
            mut result = Value();
            result.kind = Kind::object_value;
            result.objectValue = values;
            return result;
        }

        object Parser {
            private source: string;
            private position: usize;
            private failure: string;
            private options: ParseOptions;

            OnConstruct(source: string) {
                self.source = source;
                self.position = 0usize;
                self.failure = "";
                self.options = DefaultParseOptions();
            }

            OnConstruct(source: string, options: ParseOptions) {
                self.source = source;
                self.position = 0usize;
                self.failure = "";
                self.options = options;
            }

            private fn Fail(message: string) {
                if (self.failure == "") {
                    self.failure = $"JSON parse error at byte ${self.position}: ${message}";
                }
            }

            private fn SkipWhitespace() {
                while (self.position < self.source.Count()) {
                    let current = self.source[self.position];
                    if (current != ' ' and current != '\t' and current != '\r' and current != '\n') { return; }
                    self.position += 1usize;
                }
            }

            private fn Consume(text: string) -> bool {
                if (self.source.Slice(self.position, text.Count()) != text) { return false; }
                self.position += text.Count();
                return true;
            }

            private fn ParseStringToken() -> string {
                if (self.position >= self.source.Count() or self.source[self.position] != '"') {
                    self.Fail("Expected a string.");
                    return "";
                }
                let start = self.position;
                self.position += 1usize;
                mut escaped = false;
                while (self.position < self.source.Count()) {
                    let current = self.source[self.position];
                    self.position += 1usize;
                    if (escaped) {
                        escaped = false;
                    } else if (current == '\\') {
                        escaped = true;
                    } else if (current == '"') {
                        return serialization::UnquoteJson(
                            self.source.Slice(start, self.position - start));
                    } else if (current == '\n' or current == '\r') {
                        self.Fail("Unescaped newline in string.");
                        return "";
                    }
                }
                self.Fail("Unterminated string.");
                return "";
            }

            private fn ParseNumberValue() -> Value {
                let start = self.position;
                while (self.position < self.source.Count()) {
                    let current = self.source[self.position];
                    let valid = (current >= '0' and current <= '9') or current == '-' or current == '+' or
                                current == '.' or current == 'e' or current == 'E';
                    if (not valid) { break; }
                    self.position += 1usize;
                }
                let token = self.source.Slice(start, self.position - start);
                if (not serialization::IsValidJsonNumber(token)) {
                    self.Fail("Invalid number grammar.");
                    return NullValue();
                }
                if (serialization::IsJsonInteger(token)) {
                    return IntegerValue(token);
                }
                let parsed = convert::ParseF64(token);
                if (parsed.IsError()) {
                    self.Fail("Invalid number.");
                    return NullValue();
                }
                return NumberValue(parsed.Value());
            }

            private fn ParseArrayValue(depth: usize) -> Value {
                if (depth > self.options.maxDepth) {
                    self.Fail("Maximum nesting depth exceeded.");
                    return NullValue();
                }
                self.position += 1usize;
                mut values: Value[] = [];
                self.SkipWhitespace();
                if (self.position < self.source.Count() and self.source[self.position] == ']') {
                    self.position += 1usize;
                    return ArrayValue(values);
                }
                while (self.position < self.source.Count() and self.failure == "") {
                    values.Push(self.ParseAny(depth));
                    self.SkipWhitespace();
                    if (self.position < self.source.Count() and self.source[self.position] == ']') {
                        self.position += 1usize;
                        return ArrayValue(values);
                    }
                    if (self.position >= self.source.Count() or self.source[self.position] != ',') {
                        self.Fail("Expected ',' or ']' in array.");
                        return NullValue();
                    }
                    self.position += 1usize;
                    self.SkipWhitespace();
                }
                self.Fail("Unterminated array.");
                return NullValue();
            }

            private fn ParseObjectValue(depth: usize) -> Value {
                if (depth > self.options.maxDepth) {
                    self.Fail("Maximum nesting depth exceeded.");
                    return NullValue();
                }
                self.position += 1usize;
                mut values: Dict<string, Value> = {};
                self.SkipWhitespace();
                if (self.position < self.source.Count() and self.source[self.position] == '}') {
                    self.position += 1usize;
                    return ObjectValue(values);
                }
                while (self.position < self.source.Count() and self.failure == "") {
                    let key = self.ParseStringToken();
                    self.SkipWhitespace();
                    if (self.position >= self.source.Count() or self.source[self.position] != ':') {
                        self.Fail("Expected ':' after object key.");
                        return NullValue();
                    }
                    self.position += 1usize;
                    self.SkipWhitespace();
                    let parsedValue = self.ParseAny(depth);
                    if (values.ContainsKey(key)) {
                        if (self.options.duplicateKeys == DuplicateKeyPolicy::reject) {
                            self.Fail($"Duplicate object key '${key}'.");
                            return NullValue();
                        }
                        if (self.options.duplicateKeys == DuplicateKeyPolicy::keep_last) {
                            values.Set(key, parsedValue);
                        }
                    } else {
                        values.Set(key, parsedValue);
                    }
                    self.SkipWhitespace();
                    if (self.position < self.source.Count() and self.source[self.position] == '}') {
                        self.position += 1usize;
                        return ObjectValue(values);
                    }
                    if (self.position >= self.source.Count() or self.source[self.position] != ',') {
                        self.Fail("Expected ',' or '}' in object.");
                        return NullValue();
                    }
                    self.position += 1usize;
                    self.SkipWhitespace();
                }
                self.Fail("Unterminated object.");
                return NullValue();
            }

            private fn ParseAny(depth: usize) -> Value {
                self.SkipWhitespace();
                if (self.position >= self.source.Count()) {
                    self.Fail("Expected a value.");
                    return NullValue();
                }
                let current = self.source[self.position];
                if (current == '"') { return StringValue(self.ParseStringToken()); }
                if (current == '[') { return self.ParseArrayValue(depth + 1usize); }
                if (current == '{') { return self.ParseObjectValue(depth + 1usize); }
                if (self.Consume("true")) { return BoolValue(true); }
                if (self.Consume("false")) { return BoolValue(false); }
                if (self.Consume("null")) { return NullValue(); }
                if ((current >= '0' and current <= '9') or current == '-') { return self.ParseNumberValue(); }
                self.Fail("Unexpected token.");
                return NullValue();
            }

            public fn Run() -> std::Result<Value> {
                if (self.source.Count() > self.options.maxBytes) {
                    return std::Err<Value>(std::MakeResultError(
                        std::ResultDomain::custom, 2, "JSON input exceeds the configured byte limit."));
                }
                if (not unicode::IsValidUtf8(self.source)) {
                    return std::Err<Value>(std::MakeResultError(
                        std::ResultDomain::custom, 2, "JSON input is not valid UTF-8."));
                }
                let value = self.ParseAny(0usize);
                self.SkipWhitespace();
                if (self.failure == "" and self.position != self.source.Count()) {
                    self.Fail("Trailing characters.");
                }
                if (self.failure != "") {
                    return std::Err<Value>(std::MakeResultError(
                        std::ResultDomain::custom, 1, self.failure));
                }
                return std::Ok<Value>(value);
            }
        }

        fn Parse(value: string) -> std::Result<Value> {
            return Parser(value).Run();
        }

        fn Parse(value: string, options: ParseOptions) -> std::Result<Value> {
            return Parser(value, options).Run();
        }

        fn IsValid(value: string) -> bool { return Parse(value).IsOk(); }

        fn Indent(depth: usize, width: usize) -> string {
            mut result = "";
            mut count = 0usize;
            while (count < depth * width) {
                result += " ";
                count += 1usize;
            }
            return result;
        }

        fn WriteValue(value: Value, pretty: bool, depth: usize, width: usize) -> string {
            if (value.IsNull()) { return "null"; }
            if (value.IsBool()) { return match (value.booleanValue) { true: "true"; assumed: "false"; }; }
            if (value.IsInteger()) { return value.integerText; }
            if (value.IsNumber()) { return std::ToString<f64>(value.numberValue); }
            if (value.IsString()) { return serialization::QuoteJson(value.stringValue); }
            if (value.IsArray()) {
                if (value.arrayValue.Empty()) { return "[]"; }
                mut parts: string[] = [];
                mut index = 0usize;
                while (index < value.arrayValue.Count()) {
                    let encoded = WriteValue(value.arrayValue[index], pretty, depth + 1usize, width);
                    parts.Push(match (pretty) {
                        true: Indent(depth + 1usize, width) + encoded;
                        assumed: encoded;
                    });
                    index += 1usize;
                }
                if (pretty) {
                    return "[\n" + parts.Join(",\n") + "\n" + Indent(depth, width) + "]";
                }
                return "[" + parts.Join(",") + "]";
            }
            mut keys = value.objectValue.Keys();
            keys.Sort();
            if (keys.Empty()) { return "{}"; }
            mut fields: string[] = [];
            mut index = 0usize;
            while (index < keys.Count()) {
                let key = keys[index];
                let separator = match (pretty) { true: ": "; assumed: ":"; };
                let encoded = serialization::QuoteJson(key) + separator +
                    WriteValue(value.objectValue.GetOr(key, NullValue()), pretty, depth + 1usize, width);
                fields.Push(match (pretty) {
                    true: Indent(depth + 1usize, width) + encoded;
                    assumed: encoded;
                });
                index += 1usize;
            }
            if (pretty) {
                return "{\n" + fields.Join(",\n") + "\n" + Indent(depth, width) + "}";
            }
            return "{" + fields.Join(",") + "}";
        }

        fn Write(value: Value) -> string { return WriteValue(value, false, 0usize, 2usize); }
        fn WritePretty(value: Value) -> string { return WriteValue(value, true, 0usize, 2usize); }
        fn WritePretty(value: Value, indentWidth: usize) -> string {
            return WriteValue(value, true, 0usize, indentWidth);
        }

        fn DecodePointerToken(value: string) -> string {
            return value.Replace("~1", "/").Replace("~0", "~");
        }

        fn Pointer(value: Value, pointer: string) -> std::Option<Value> {
            if (pointer == "") { return std::Some(value); }
            if (not pointer.StartsWith("/")) { return std::None<Value>(); }
            let segments = pointer.Split("/");
            mut current = value;
            mut index = 1usize;
            while (index < segments.Count()) {
                let segment = DecodePointerToken(segments[index]);
                if (current.IsObject()) {
                    let next = current.Get(segment);
                    if (next.IsNone()) { return std::None<Value>(); }
                    current = next.Value();
                } else if (current.IsArray()) {
                    let parsedIndex = convert::ParseU64(segment);
                    if (parsedIndex.IsError()) { return std::None<Value>(); }
                    let next = current.At(parsedIndex.Value() fit usize);
                    if (next.IsNone()) { return std::None<Value>(); }
                    current = next.Value();
                } else {
                    return std::None<Value>();
                }
                index += 1usize;
            }
            return std::Some(current);
        }

        // RFC 7396 merge-patch semantics. Objects are merged recursively;
        // null fields remove keys and all other values replace the target.
        fn MergePatch(target: Value, patch: Value) -> Value {
            if (not patch.IsObject()) { return patch; }
            mut result = target;
            if (not result.IsObject()) {
                mut empty: Dict<string, Value> = {};
                result = ObjectValue(empty);
            }
            let keys = patch.objectValue.Keys();
            for (key in keys) {
                let patchValue = patch.objectValue.GetOr(key, NullValue());
                if (patchValue.IsNull()) {
                    result.objectValue.Remove(key);
                } else {
                    let currentValue = result.objectValue.GetOr(key, NullValue());
                    result.objectValue.Set(key, MergePatch(currentValue, patchValue));
                }
            }
            return result;
        }

        // Scalar/composition compatibility facade.
        fn Escape(value: string) -> string { return serialization::EscapeJson(value); }
        fn Quote(value: string) -> string { return serialization::QuoteJson(value); }
        fn Unquote(value: string) -> string { return serialization::UnquoteJson(value); }
        fn String(value: string) -> string { return serialization::ToJson(value); }
        fn Bool(value: bool) -> string { return serialization::ToJson(value); }
        fn Number(value: i32) -> string { return serialization::ToJson(value); }
        fn Number(value: i64) -> string { return serialization::ToJson(value); }
        fn Number(value: f64) -> string { return serialization::ToJson(value); }
        fn Array(values: string[]) -> string { return serialization::ArrayJson(values); }
        fn Field(name: string, value: string) -> string { return serialization::FieldJson(name, value); }
        fn Object(fields: string[]) -> string { return serialization::ObjectJson(fields); }
        fn Null() -> string { return serialization::NullJson(); }
    }
}
