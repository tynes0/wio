use std::option as option;

realm std {
    realm semver {
        using cpp::header("std_utility.h");

        const PartMask: u64 = 2097151u64;

        component Version {
            packed: u64;

            fn operator==(right: Version) -> bool { return self.packed == right.packed; }
            fn operator!=(right: Version) -> bool { return self.packed != right.packed; }
        }

        component SemanticVersion {
            core: Version;
            prerelease: string;
            build: string;
        }

        fn Make(major: u64, minor: u64, patch: u64) -> Version {
            mut result = Version();
            result.packed =
                ((major & PartMask) << 42u64) |
                ((minor & PartMask) << 21u64) |
                (patch & PartMask);
            return result;
        }

        fn TryMake(major: u64, minor: u64, patch: u64) -> std::Option<Version> {
            if (major > PartMask or minor > PartMask or patch > PartMask) {
                return std::None<Version>();
            }
            return std::Some<Version>(Make(major, minor, patch));
        }

        @Native @CppName(wio::runtime::std_semver::ParsePacked)
        fn ParsePacked(value: string, packed: ref u64) -> bool;

        fn ParseDetailedNative(
            value: string,
            major: ref u64,
            minor: ref u64,
            patch: ref u64,
            prerelease: ref string,
            build: ref string) -> bool
            with native, cpp::name(wio::runtime::std_semver::ParseDetailed);

        fn CompareText(left: string, right: string) -> i32
            with native, cpp::name(wio::runtime::std_semver::Compare);

        fn Parse(value: string) -> std::Option<Version> {
            mut packed = 0u64;
            if (not ParsePacked(value, ref packed)) { return std::None<Version>(); }
            mut result = Version();
            result.packed = packed;
            return std::Some<Version>(result);
        }

        fn ParseSemantic(value: string) -> std::Option<SemanticVersion> {
            mut major = 0u64;
            mut minor = 0u64;
            mut patch = 0u64;
            mut prerelease = "";
            mut build = "";
            if (not ParseDetailedNative(
                    value, ref major, ref minor, ref patch, ref prerelease, ref build)) {
                return std::None<SemanticVersion>();
            }
            let core = TryMake(major, minor, patch);
            if (core.IsNone()) { return std::None<SemanticVersion>(); }
            mut result = SemanticVersion();
            result.core = core.Value();
            result.prerelease = prerelease;
            result.build = build;
            return std::Some(result);
        }

        fn ToString(value: SemanticVersion) -> string {
            mut output = value.core.ToString();
            if (not value.prerelease.Empty()) { output += "-" + value.prerelease; }
            if (not value.build.Empty()) { output += "+" + value.build; }
            return output;
        }

        fn Compare(left: SemanticVersion, right: SemanticVersion) -> i32 {
            return CompareText(ToString(left), ToString(right));
        }

        extension VersionMethods for Version {
            public view fn Major() -> u64 { return (self.packed >> 42u64) & PartMask; }
            public view fn Minor() -> u64 { return (self.packed >> 21u64) & PartMask; }
            public view fn Patch() -> u64 { return self.packed & PartMask; }
            public view fn Packed() -> u64 { return self.packed; }
            public view fn Compare(other: Version) -> i32 {
                if (self.packed < other.packed) { return -1; }
                if (self.packed > other.packed) { return 1; }
                return 0;
            }
            public view fn ToString() -> string {
                return $"${self.Major()}.${self.Minor()}.${self.Patch()}";
            }
            public ref fn SetMajor(value: u64) {
                self.packed = ((value & PartMask) << 42u64) | (self.packed & 4398046511103u64);
            }
            public ref fn SetMinor(value: u64) {
                self.packed = (self.packed & ~(PartMask << 21u64)) | ((value & PartMask) << 21u64);
            }
            public ref fn SetPatch(value: u64) {
                self.packed = (self.packed & ~PartMask) | (value & PartMask);
            }
        }
    }
}
