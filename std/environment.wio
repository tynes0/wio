realm std {
    realm environment {
        use @CppHeader("std_process.h");

        @Native
        @CppName(wio::runtime::std_environment::TryGet)
        fn TryGet(name: string, value: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::Set)
        fn Set(name: string, value: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::Remove)
        fn Remove(name: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::TryGetUser)
        fn TryGetUser(name: string, value: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::SetUser)
        fn SetUser(name: string, value: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::RemoveUser)
        fn RemoveUser(name: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::UserPathContains)
        fn UserPathContains(entry: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::AddUserPath)
        fn AddUserPath(entry: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::RemoveUserPath)
        fn RemoveUserPath(entry: string) -> bool;

        @Native
        @CppName(wio::runtime::std_environment::DuplicateKeys)
        fn DuplicateKeys() -> string[];

        @Native
        @CppName(wio::runtime::std_environment::TemporaryDirectory)
        fn TemporaryDirectory() -> string;

        @Native
        @CppName(wio::runtime::std_environment::HomeDirectory)
        fn HomeDirectory() -> string;

        @Native
        @CppName(wio::runtime::std_environment::CacheDirectory)
        fn CacheDirectory() -> string;

        fn ConfigDirectory() -> string
            with native, cpp::name(wio::runtime::std_environment::ConfigDirectory);
        fn DataDirectory() -> string
            with native, cpp::name(wio::runtime::std_environment::DataDirectory);
        fn RuntimeDirectory() -> string
            with native, cpp::name(wio::runtime::std_environment::RuntimeDirectory);
        fn CurrentDirectory() -> string
            with native, cpp::name(wio::runtime::std_environment::CurrentDirectory);
        fn SetCurrentDirectory(path: string) -> bool
            with native, cpp::name(wio::runtime::std_environment::SetCurrentDirectory);

        fn Get(name: string, fallback: string) -> string {
            mut value = "";
            if (TryGet(name, ref value)) {
                return value;
            }
            return fallback;
        }

        fn Get(name: string) -> string {
            return Get(name, "");
        }

        fn Has(name: string) -> bool {
            mut value = "";
            return TryGet(name, ref value);
        }

        fn GetUser(name: string, fallback: string) -> string {
            mut value = "";
            return TryGetUser(name, ref value) ? value : fallback;
        }

        fn GetUser(name: string) -> string {
            return GetUser(name, "");
        }

        fn HasUser(name: string) -> bool {
            mut value = "";
            return TryGetUser(name, ref value);
        }
    }
}
