use std::convert as convert;
use std::option as option;
use std::result as result;
use std::async as futures;

realm std {
    realm net {
        using cpp::header("std_net.h");
        using cpp::header("std_async_net.h");

        component Uri {
            valid: bool;
            scheme: string;
            host: string;
            port: u16;
            path: string;
            query: string;
            fragment: string;
            secure: bool;
        }

        fn ParseUri(value: string) -> std::Result<Uri> {
            mut result = Uri();
            let schemeEnd = value.IndexOf("://");
            if (schemeEnd < 0isize) {
                return std::Err<Uri>(std::MakeResultError(
                    std::ResultDomain::runtime, 1, "URI requires a scheme and authority."));
            }
            result.scheme = value.Take(schemeEnd fit usize).ToLower();
            result.secure = result.scheme == "https" or result.scheme == "wss";
            let remainder = value.Skip((schemeEnd fit usize) + 3usize);
            let slash = remainder.IndexOf("/");
            mut authority = remainder;
            mut tail = "";
            if (slash >= 0isize) {
                authority = remainder.Take(slash fit usize);
                tail = remainder.Skip(slash fit usize);
            }
            if (authority.Empty()) {
                return std::Err<Uri>(std::MakeResultError(
                    std::ResultDomain::runtime, 1, "URI host cannot be empty."));
            }

            if (authority.StartsWith("[")) {
                let close = authority.IndexOf("]");
                if (close < 0isize) {
                    return std::Err<Uri>(std::MakeResultError(
                        std::ResultDomain::runtime, 1, "Invalid bracketed IPv6 authority."));
                }
                result.host = authority.Slice(1usize, (close fit usize) - 1usize);
                if ((close fit usize) + 1usize < authority.Count()) {
                    let portText = authority.Skip((close fit usize) + 2usize);
                    let parsedPort = convert::ParseU16(portText);
                    if (parsedPort.IsError()) { return std::Err<Uri>(parsedPort.ErrorValue()); }
                    result.port = parsedPort.Value();
                }
            } else {
                let colon = authority.LastIndexOf(":");
                if (colon >= 0isize) {
                    result.host = authority.Take(colon fit usize);
                    let parsedPort = convert::ParseU16(authority.Skip((colon fit usize) + 1usize));
                    if (parsedPort.IsError()) { return std::Err<Uri>(parsedPort.ErrorValue()); }
                    result.port = parsedPort.Value();
                } else {
                    result.host = authority;
                }
            }
            if (result.port == 0u16) {
                result.port = result.secure ? 443u16 : 80u16;
            }

            let fragmentIndex = tail.IndexOf("#");
            if (fragmentIndex >= 0isize) {
                result.fragment = tail.Skip((fragmentIndex fit usize) + 1usize);
                tail = tail.Take(fragmentIndex fit usize);
            }
            let queryIndex = tail.IndexOf("?");
            if (queryIndex >= 0isize) {
                result.query = tail.Skip((queryIndex fit usize) + 1usize);
                result.path = tail.Take(queryIndex fit usize);
            } else {
                result.path = tail;
            }
            if (result.path.Empty()) { result.path = "/"; }
            result.valid = true;
            return std::Ok(result);
        }

        fn ResolveNative(host: string, port: u16, addresses: ref string[], error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::Resolve);
        fn ConnectNative(host: string, port: u16, timeout: u64, handle: ref opaque?, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::TcpConnect);
        fn ListenNative(address: string, port: u16, backlog: i32, handle: ref opaque?, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::TcpListen);
        fn AcceptNative(listener: opaque, handle: ref opaque?, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::TcpAccept);
        fn SetTimeoutNative(handle: opaque, milliseconds: u64, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::SetTimeout);
        fn LocalPortNative(handle: opaque) -> u16
            with native, cpp::name(wio::runtime::std_net::LocalPort);
        fn SendNative(handle: opaque, bytes: string, sent: ref usize, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::Send);
        fn ReceiveNative(handle: opaque, maximumBytes: usize, bytes: ref string, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::Receive);
        fn CloseNative(handle: opaque) with native, cpp::name(wio::runtime::std_net::Close);
        fn LiveSocketCount() -> u64 with native, cpp::name(wio::runtime::std_net::LiveSocketCount);
        fn UdpBindNative(address: string, port: u16, handle: ref opaque?, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::UdpBind);
        fn UdpSendToNative(handle: opaque, host: string, port: u16, bytes: string,
            sent: ref usize, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::UdpSendTo);
        fn UdpReceiveFromNative(handle: opaque, maximumBytes: usize, bytes: ref string,
            remoteAddress: ref string, remotePort: ref u16, error: ref string) -> bool
            with native, cpp::name(wio::runtime::std_net::UdpReceiveFrom);
        fn ResolveAsyncNative(host: string, port: u16) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::Resolve);
        fn SendAsyncNative(handle: opaque, bytes: string) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::Send);
        fn ReceiveAsyncNative(handle: opaque, maximumBytes: usize) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::Receive);
        fn AcceptAsyncNative(handle: opaque) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::Accept);
        fn UdpSendToAsyncNative(handle: opaque, host: string, port: u16, bytes: string) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::UdpSendTo);
        fn UdpReceiveFromAsyncNative(handle: opaque, maximumBytes: usize) -> coroutine<string>
            with native, cpp::name(wio::runtime::std_async_net::UdpReceiveFrom);
        fn DecodeAsyncAddresses(payload: string, succeeded: ref bool,
            addresses: ref string[], error: ref string)
            with native, cpp::name(wio::runtime::std_async_net::DecodeAddresses);
        fn DecodeAsyncSend(payload: string, succeeded: ref bool,
            count: ref usize, error: ref string)
            with native, cpp::name(wio::runtime::std_async_net::DecodeSend);
        fn DecodeAsyncReceive(payload: string, succeeded: ref bool,
            bytes: ref string, error: ref string)
            with native, cpp::name(wio::runtime::std_async_net::DecodeReceive);
        fn DecodeAsyncAccept(payload: string, succeeded: ref bool,
            error: ref string)
            with native, cpp::name(wio::runtime::std_async_net::DecodeAccept);
        fn DecodeAsyncDatagram(payload: string, succeeded: ref bool, bytes: ref string,
            remoteAddress: ref string, remotePort: ref u16, error: ref string)
            with native, cpp::name(wio::runtime::std_async_net::DecodeDatagram);

        fn NetError(message: string) -> std::ResultError {
            return std::MakeResultError(std::ResultDomain::runtime, 1, message);
        }

        fn Resolve(host: string, port: u16) -> std::Result<string[]> {
            mut addresses: string[] = [];
            mut error = "";
            if (ResolveNative(host, port, ref addresses, ref error)) { return std::Ok(addresses); }
            return std::Err<string[]>(NetError(error));
        }

        async fn ResolveAsync(host: string, port: u16) -> std::Result<string[]> {
            let payload = await ResolveAsyncNative(host, port);
            mut succeeded = false; mut addresses: string[] = []; mut error = "";
            DecodeAsyncAddresses(payload, ref succeeded, ref addresses, ref error);
            if (succeeded) { return std::Ok<string[]>(addresses); }
            return std::Err<string[]>(NetError(error));
        }

        object Socket {
            private handle: opaque;
            private closed: bool;
            public fn OnConstruct(handle: opaque) { self.handle = handle; self.closed = false; }
            public fn OnDestruct() { self.Close(); }
            public fn Close() { if (not self.closed) { CloseNative(self.handle); self.closed = true; } }
            public fn IsClosed() -> bool { return self.closed; }
            public fn SetTimeout(milliseconds: u64) -> std::UnitResult {
                mut error = "";
                if (SetTimeoutNative(self.handle, milliseconds, ref error)) { return std::OkUnit(); }
                return std::ErrUnit(NetError(error));
            }
            public fn Send(bytes: string) -> std::Result<usize> {
                mut sent: usize = 0usize;
                mut error = "";
                if (SendNative(self.handle, bytes, ref sent, ref error)) { return std::Ok(sent); }
                return std::Err<usize>(NetError(error));
            }
            public fn Receive(maximumBytes: usize) -> std::Result<string> {
                mut bytes = "";
                mut error = "";
                if (ReceiveNative(self.handle, maximumBytes, ref bytes, ref error)) { return std::Ok(bytes); }
                return std::Err<string>(NetError(error));
            }
            public async fn SendAsync(bytes: string) -> std::Result<usize> {
                if (self.closed) { return std::Err<usize>(NetError("socket is closed")); }
                let payload = await SendAsyncNative(self.handle, bytes);
                mut succeeded = false; mut sent = 0usize; mut error = "";
                DecodeAsyncSend(payload, ref succeeded, ref sent, ref error);
                if (succeeded) { return std::Ok<usize>(sent); }
                return std::Err<usize>(NetError(error));
            }
            public async fn ReceiveAsync(maximumBytes: usize) -> std::Result<string> {
                if (self.closed) { return std::Err<string>(NetError("socket is closed")); }
                let payload = await ReceiveAsyncNative(self.handle, maximumBytes);
                mut succeeded = false; mut bytes = ""; mut error = "";
                DecodeAsyncReceive(payload, ref succeeded, ref bytes, ref error);
                if (succeeded) { return std::Ok<string>(bytes); }
                return std::Err<string>(NetError(error));
            }
        }

        fn Connect(host: string, port: u16, timeoutMilliseconds: u64) -> std::Result<Socket> {
            mut handle: opaque? = null;
            mut error = "";
            if (ConnectNative(host, port, timeoutMilliseconds, ref handle, ref error)) {
                if (handle != null) { return std::Ok(Socket(handle)); }
            }
            return std::Err<Socket>(NetError(error));
        }

        async fn ConnectAsync(host: string, port: u16, timeoutMilliseconds: u64) -> std::Result<Socket> {
            let action: fn() -> std::Result<Socket> = () => Connect(host, port, timeoutMilliseconds);
            return await futures::RunBlocking<std::Result<Socket> >(action);
        }

        object Listener {
            private handle: opaque;
            private closed: bool;
            public fn OnConstruct(handle: opaque) { self.handle = handle; self.closed = false; }
            public fn OnDestruct() { self.Close(); }
            public fn Close() { if (not self.closed) { CloseNative(self.handle); self.closed = true; } }
            public fn LocalPort() -> u16 { return LocalPortNative(self.handle); }
            public fn Accept() -> std::Result<Socket> {
                mut accepted: opaque? = null;
                mut error = "";
                if (AcceptNative(self.handle, ref accepted, ref error)) {
                    if (accepted != null) { return std::Ok(Socket(accepted)); }
                }
                return std::Err<Socket>(NetError(error));
            }
            public async fn AcceptAsync() -> std::Result<Socket> {
                if (self.closed) { return std::Err<Socket>(NetError("listener is closed")); }
                let payload = await AcceptAsyncNative(self.handle);
                mut succeeded = false;
                mut error = "";
                DecodeAsyncAccept(payload, ref succeeded, ref error);
                if (succeeded) {
                    return self.Accept();
                }
                return std::Err<Socket>(NetError(error));
            }
        }

        fn Listen(address: string, port: u16, backlog: i32) -> std::Result<Listener> {
            mut handle: opaque? = null;
            mut error = "";
            if (ListenNative(address, port, backlog, ref handle, ref error)) {
                if (handle != null) { return std::Ok(Listener(handle)); }
            }
            return std::Err<Listener>(NetError(error));
        }

        component Datagram {
            public bytes: string;
            public remoteAddress: string;
            public remotePort: u16;

            OnConstruct(bytes: string, remoteAddress: string, remotePort: u16) {
                self.bytes = bytes;
                self.remoteAddress = remoteAddress;
                self.remotePort = remotePort;
            }
        }

        object UdpSocket {
            private handle: opaque;
            private closed: bool;
            public fn OnConstruct(handle: opaque) { self.handle = handle; self.closed = false; }
            public fn OnDestruct() { self.Close(); }
            public fn Close() { if (not self.closed) { CloseNative(self.handle); self.closed = true; } }
            public fn LocalPort() -> u16 { return LocalPortNative(self.handle); }
            public fn SetTimeout(milliseconds: u64) -> std::UnitResult {
                mut error = "";
                if (SetTimeoutNative(self.handle, milliseconds, ref error)) { return std::OkUnit(); }
                return std::ErrUnit(NetError(error));
            }
            public fn SendTo(host: string, port: u16, bytes: string) -> std::Result<usize> {
                mut sent = 0usize;
                mut error = "";
                if (UdpSendToNative(self.handle, host, port, bytes, ref sent, ref error)) {
                    return std::Ok(sent);
                }
                return std::Err<usize>(NetError(error));
            }
            public fn ReceiveFrom(maximumBytes: usize) -> std::Result<Datagram> {
                mut bytes = "";
                mut address = "";
                mut port = 0u16;
                mut error = "";
                if (UdpReceiveFromNative(self.handle, maximumBytes, ref bytes, ref address, ref port, ref error)) {
                    return std::Ok(Datagram(bytes, address, port));
                }
                return std::Err<Datagram>(NetError(error));
            }
            public async fn SendToAsync(host: string, port: u16, bytes: string) -> std::Result<usize> {
                if (self.closed) { return std::Err<usize>(NetError("socket is closed")); }
                let payload = await UdpSendToAsyncNative(self.handle, host, port, bytes);
                mut succeeded = false; mut sent = 0usize; mut error = "";
                DecodeAsyncSend(payload, ref succeeded, ref sent, ref error);
                if (succeeded) { return std::Ok<usize>(sent); }
                return std::Err<usize>(NetError(error));
            }
            public async fn ReceiveFromAsync(maximumBytes: usize) -> std::Result<Datagram> {
                if (self.closed) { return std::Err<Datagram>(NetError("socket is closed")); }
                let payload = await UdpReceiveFromAsyncNative(self.handle, maximumBytes);
                mut succeeded = false; mut bytes = ""; mut address = "";
                mut port = 0u16; mut error = "";
                DecodeAsyncDatagram(payload, ref succeeded, ref bytes, ref address, ref port, ref error);
                if (succeeded) { return std::Ok<Datagram>(Datagram(bytes, address, port)); }
                return std::Err<Datagram>(NetError(error));
            }
        }

        fn BindUdp(address: string, port: u16) -> std::Result<UdpSocket> {
            mut handle: opaque? = null;
            mut error = "";
            if (UdpBindNative(address, port, ref handle, ref error)) {
                if (handle != null) { return std::Ok(UdpSocket(handle)); }
            }
            return std::Err<UdpSocket>(NetError(error));
        }
    }
}
