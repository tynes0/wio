use std::result as result;
use std::option;

realm std {
    realm collections {
        object Queue<T> {
            private values: T[];
            private head: usize;

            public fn OnConstruct() {
                self.values = [];
                self.head = 0usize;
            }

            public fn Count() -> usize {
                return self.values.Count() - self.head;
            }

            public fn Empty() -> bool {
                return self.head >= self.values.Count();
            }

            public fn Capacity() -> usize {
                return self.values.Capacity();
            }

            public fn Reserve(capacity: usize) {
                self.values.Reserve(self.head + capacity);
            }

            public fn ShrinkToFit() {
                if (self.head > 0usize) {
                    self.values = self.values.Slice(self.head);
                    self.head = 0usize;
                }
                self.values.ShrinkToFit();
            }

            public fn Enqueue(value: T) {
                self.values.Push(value);
            }

            public fn Push(value: T) {
                self.Enqueue(value);
            }

            public fn Peek() -> T {
                if (self.Empty()) {
                    std::Panic("Queue<T>.Peek cannot read an empty queue.");
                }
                return self.values[self.head];
            }

            public fn PeekOption() -> std::Option<T> {
                if (self.Empty()) { return std::None<T>(); }
                return std::Some<T>(self.values[self.head]);
            }

            public fn First() -> std::Option<T> {
                return self.PeekOption();
            }

            public fn Last() -> std::Option<T> {
                if (self.Empty()) { return std::None<T>(); }
                return std::Some<T>(self.values[self.values.Count() - 1usize]);
            }

            public fn Contains(value: T) -> bool {
                mut index = self.head;
                while (index < self.values.Count()) {
                    if (self.values[index] == value) { return true; }
                    index += 1usize;
                }
                return false;
            }

            public fn Dequeue() -> T {
                if (self.Empty()) {
                    std::Panic("Queue<T>.Dequeue cannot read an empty queue.");
                }

                let value = self.values[self.head];
                self.head += 1usize;
                if (self.head >= 32usize and self.head * 2usize >= self.values.Count()) {
                    self.values = self.values.Slice(self.head);
                    self.head = 0usize;
                }
                return value;
            }

            public fn Pop() -> T {
                return self.Dequeue();
            }

            public fn TryDequeue(value: ref T) -> bool {
                if (self.Empty()) {
                    return false;
                }
                value = self.Dequeue();
                return true;
            }

            public fn DequeueOption() -> std::Option<T> {
                if (self.Empty()) { return std::None<T>(); }
                return std::Some<T>(self.Dequeue());
            }

            public fn Clear() {
                self.values.Clear();
                self.head = 0usize;
            }

            public fn ToArray() -> T[] {
                return self.values.Slice(self.head);
            }

            public fn Clone() -> Queue<T> {
                mut copy = Queue<T>();
                for (value in self.ToArray()) {
                    copy.Enqueue(value);
                }
                return copy;
            }

            public fn SequenceEqual(other: Queue<T>) -> bool {
                if (self.Count() != other.Count()) { return false; }
                let left = self.ToArray();
                let right = other.ToArray();
                mut index = 0usize;
                while (index < left.Count()) {
                    if (left[index] != right[index]) { return false; }
                    index += 1usize;
                }
                return true;
            }
        }
    }

    realm queue {
        type Queue<T> = collections::Queue<T>;
    }

    type Queue<T> = collections::Queue<T>;
}
