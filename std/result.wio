realm std {
    using cpp::header("std_assert.h");

    @Native
    @CppName(wio::runtime::std_assert::Fail)
    fn Panic(message: string);

    @Type(i32)
    enum ResultDomain {
        none = 0,
        console = 1,
        io = 2,
        fs = 3,
        runtime = 4,
        custom = 5
    };

    component ResultUnit {}

    component ResultError {
        domain: ResultDomain;
        code: i32;
        nativeCode: i64;
        message: string;
    }

    object Result<T> {
        private ok: bool;
        private value: T;
        private error: ResultError;

        OnConstruct(value: T) {
            self.ok = true;
            self.value = value;
            self.error = ResultError();
            self.error.domain = ResultDomain::none;
            self.error.code = 0;
            self.error.nativeCode = 0;
            self.error.message = "";
        }

        OnConstruct(error: ResultError) {
            self.ok = false;
            self.error = error;
        }

        public fn IsOk() -> bool {
            return self.ok;
        }

        public fn IsError() -> bool {
            return not self.ok;
        }

        public fn HasValue() -> bool {
            return self.ok;
        }

        public fn Value() -> T {
            if (self.ok) {
                return self.value;
            }

            Panic("Result<T> does not contain a success value.");
            return self.value;
        }

        public fn Unwrap() -> T {
            if (self.ok) {
                return self.value;
            }

            if (self.error.message != "") {
                Panic(self.error.message);
            }

            Panic("Result<T> does not contain a success value.");
            return self.value;
        }

        public fn ValueOr(fallback: T) -> T {
            if (self.ok) {
                return self.value;
            }

            return fallback;
        }

        public fn ErrorValue() -> ResultError {
            return self.error;
        }

        public fn Map<U>(transform: fn(T) -> U) -> Result<U> {
            if (self.ok) {
                return std::Ok<U>(transform(self.value));
            }

            return std::Err<U>(self.error);
        }

        public fn MapError(transform: fn(ResultError) -> ResultError) -> Result<T> {
            if (self.ok) {
                return std::Ok<T>(self.value);
            }

            return std::Err<T>(transform(self.error));
        }

        public fn AndThen<U>(transform: fn(T) -> Result<U>) -> Result<U> {
            if (self.ok) {
                return transform(self.value);
            }

            return std::Err<U>(self.error);
        }

        public fn OrElse(recover: fn(ResultError) -> Result<T>) -> Result<T> {
            if (self.ok) {
                return std::Ok<T>(self.value);
            }

            return recover(self.error);
        }

        public fn Inspect(action: fn(T)) -> Result<T> {
            if (self.ok) {
                action(self.value);
                return std::Ok<T>(self.value);
            }

            return std::Err<T>(self.error);
        }

        public fn InspectError(action: fn(ResultError)) -> Result<T> {
            if (not self.ok) {
                action(self.error);
                return std::Err<T>(self.error);
            }

            return std::Ok<T>(self.value);
        }
    }

    type ResultValue<T> = Result<T>;
    type UnitResult = Result<ResultUnit>;

    fn MakeResultError(domain: ResultDomain, code: i32, message: string) -> ResultError {
        mut error = ResultError();
        error.domain = domain;
        error.code = code;
        error.nativeCode = 0;
        error.message = message;
        return error;
    }

    fn MakeResultError(domain: ResultDomain, code: i32, nativeCode: i64, message: string) -> ResultError {
        mut error = ResultError();
        error.domain = domain;
        error.code = code;
        error.nativeCode = nativeCode;
        error.message = message;
        return error;
    }

    fn Ok<T>(value: T) -> Result<T> {
        return Result<T>(value);
    }

    fn OkUnit() -> UnitResult {
        return UnitResult(ResultUnit());
    }

    fn Err<T>(error: ResultError) -> Result<T> {
        return Result<T>(error);
    }

    fn ErrUnit(error: ResultError) -> UnitResult {
        return UnitResult(error);
    }

    fn OkResultValue<T>(value: T) -> Result<T> {
        return Ok<T>(value);
    }

    fn OkUnitResult() -> UnitResult {
        return OkUnit();
    }

    fn ErrResultValue<T>(error: ResultError) -> Result<T> {
        return Err<T>(error);
    }

    fn Flatten<T>(nested: Result<Result<T> >) -> Result<T> {
        if (nested.IsOk()) {
            return nested.Value();
        }

        return Err<T>(nested.ErrorValue());
    }

    fn ErrLike<T>(error: ResultError, typeHint: T) -> Result<T> {
        return Err<T>(error);
    }

    fn Collect<T>(values: Result<T>[]) -> Result<T[]> {
        mut collected: T[] = [];
        collected.Reserve(values.Count());
        for (value in values) {
            if (value.IsError()) {
                return ErrLike(value.ErrorValue(), collected);
            }
            collected.Push(value.Value());
        }
        return Ok(collected);
    }

    fn Sequence<T>(values: Result<T>[]) -> Result<T[]> {
        return Collect<T>(values);
    }

    realm result {
        type Domain = ResultDomain;
        type Unit = ResultUnit;
        type Error = ResultError;
        type Result<T> = std::Result<T>;
        type UnitResult = std::UnitResult;

        fn MakeError(domain: Domain, code: i32, message: string) -> Error {
            return MakeResultError(domain, code, message);
        }

        fn MakeError(domain: Domain, code: i32, nativeCode: i64, message: string) -> Error {
            return MakeResultError(domain, code, nativeCode, message);
        }

        fn Ok<T>(value: T) -> Result<T> {
            return std::Ok<T>(value);
        }

        fn OkUnit() -> UnitResult {
            return std::OkUnit();
        }

        fn ErrUnit(error: Error) -> UnitResult {
            return std::ErrUnit(error);
        }

        fn Err<T>(error: Error) -> Result<T> {
            return std::Err<T>(error);
        }

        fn Flatten<T>(nested: Result<Result<T> >) -> Result<T> {
            return std::Flatten<T>(nested);
        }

        fn Collect<T>(values: Result<T>[]) -> Result<T[]> {
            return std::Collect<T>(values);
        }

        fn Sequence<T>(values: Result<T>[]) -> Result<T[]> {
            return std::Sequence<T>(values);
        }
    }
}
