realm std {
    realm reflect {
        use @CppHeader("enum_reflection.h");

        @Native
        @CppName(wio::runtime::EnumCount)
        fn Count<T>() -> usize;

        @Native
        @CppName(wio::runtime::EnumName)
        fn Name<T>(value: T) -> string;

        @Native
        @CppName(wio::runtime::EnumValue)
        fn Value<T>(index: usize) -> T;

        @Native
        @CppName(wio::runtime::EnumIndex)
        fn Index<T>(value: T) -> isize;

        @Native
        @CppName(wio::runtime::EnumUnderlyingTypeName)
        fn UnderlyingType<T>() -> string;

        @Native
        @CppName(wio::runtime::EnumSize)
        fn Size<T>() -> usize;

        fn Has<T>(value: T, mask: T) -> bool {
            return (value & mask) == mask;
        }

        fn HasAny<T>(value: T, mask: T) -> bool {
            return (value & mask) != (mask ^ mask);
        }

        fn With<T>(value: T, mask: T) -> T {
            return value | mask;
        }

        fn Without<T>(value: T, mask: T) -> T {
            return value ^ (value & mask);
        }

        fn Toggle<T>(value: T, mask: T) -> T {
            return value ^ mask;
        }

        fn Clear<T>(value: T) -> T {
            return value ^ value;
        }
    }
}
