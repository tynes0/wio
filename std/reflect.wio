use std::option;

realm std {
    realm reflect {
        using cpp::header("enum_reflection.h");
        using cpp::header("type_reflection.h");

        @Native
        @Type(u8)
        @CppName(wio::runtime::ReflectedTypeKind)
        enum Kind {
            unknown = 0u8,
            primitive_type = 1u8,
            enum_type = 2u8,
            flagset_type = 3u8,
            component_type = 4u8,
            object_type = 5u8,
            interface_type = 6u8,
            array_type = 7u8,
            dictionary_type = 8u8,
            reference_type = 9u8
        };

        component FieldInfo {
            name: string;
            typeName: string;
            access: string;
        }

        component BehavioralProcessorInfo {
            attributeName: string;
            processorType: string;
            phase: string;
            hook: string;
            mode: string;
        }

        component MethodInfo {
            name: string;
            signature: string;
            access: string;
            behavioralPipeline: BehavioralProcessorInfo[];
        }

        component TypeInfo {
            name: string;
            kind: Kind;
            size: usize;
            alignment: usize;
            genericParameters: string[];
            genericArguments: string[];
            fields: FieldInfo[];
            methods: MethodInfo[];
            baseTypes: string[];
        }

        component AttributeArgumentInfo {
            name: string;
            typeName: string;
            value: string;
            usedDefault: bool;
        }

        component AttributeInfo {
            name: string;
            stableTypeId: u64;
            retention: string;
            origin: string;
            arguments: AttributeArgumentInfo[];
        }

        @Native
        @CppName(wio::runtime::ReflectedTypeName)
        fn TypeName<T>() -> string;

        @Native
        @CppName(wio::runtime::ReflectedKind)
        fn TypeKind<T>() -> Kind;

        @Native
        @CppName(wio::runtime::ReflectedSize)
        fn TypeSize<T>() -> usize;

        @Native
        @CppName(wio::runtime::ReflectedAlignment)
        fn TypeAlignment<T>() -> usize;

        @Native
        @CppName(wio::runtime::ReflectedFieldCount)
        fn FieldCount<T>() -> usize;

        @Native
        @CppName(wio::runtime::ReflectedFieldNames)
        fn FieldNames<T>() -> string[];

        @Native
        @CppName(wio::runtime::ReflectedFieldTypes)
        fn FieldTypes<T>() -> string[];

        @Native
        @CppName(wio::runtime::ReflectedFieldAccess)
        fn FieldAccess<T>() -> string[];

        @Native
        @CppName(wio::runtime::ReflectedMethodCount)
        fn MethodCount<T>() -> usize;

        @Native
        @CppName(wio::runtime::ReflectedMethodNames)
        fn MethodNames<T>() -> string[];

        @Native
        @CppName(wio::runtime::ReflectedMethodSignatures)
        fn MethodSignatures<T>() -> string[];

        @Native
        @CppName(wio::runtime::ReflectedMethodAccess)
        fn MethodAccess<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorAttributeNames)]
        fn MethodBehaviorAttributeNamesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorProcessorTypes)]
        fn MethodBehaviorProcessorTypesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorPhases)]
        fn MethodBehaviorPhasesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorHooks)]
        fn MethodBehaviorHooksNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorModes)]
        fn MethodBehaviorModesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedMethodBehaviorOffsets)]
        fn MethodBehaviorOffsetsNative<T>() -> usize[];

        @Native
        @CppName(wio::runtime::ReflectedBaseTypes)
        fn BaseTypes<T>() -> string[];

        fn GenericParameterNames<T>() -> string[]
            with native, cpp::name(wio::runtime::ReflectedGenericParameterNames);

        fn GenericArguments<T>() -> string[]
            with native, cpp::name(wio::runtime::ReflectedGenericArguments);

        fn TypeAttributes<T>() -> string[]
            with native, cpp::name(wio::runtime::ReflectedTypeAttributes);

        [Native, CppName(wio::runtime::ReflectedTypeAttributeNames)]
        fn TypeAttributeNamesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeStableIds)]
        fn TypeAttributeStableIdsNative<T>() -> u64[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeRetentions)]
        fn TypeAttributeRetentionsNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeOrigins)]
        fn TypeAttributeOriginsNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeArgumentNames)]
        fn TypeAttributeArgumentNamesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeArgumentTypes)]
        fn TypeAttributeArgumentTypesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeArgumentValues)]
        fn TypeAttributeArgumentValuesNative<T>() -> string[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeArgumentUsedDefaults)]
        fn TypeAttributeArgumentUsedDefaultsNative<T>() -> u8[];

        [Native, CppName(wio::runtime::ReflectedTypeAttributeArgumentOffsets)]
        fn TypeAttributeArgumentOffsetsNative<T>() -> usize[];

        fn TypeAttributeInfo<T>() -> AttributeInfo[] {
            let names = TypeAttributeNamesNative<T>();
            let stableIds = TypeAttributeStableIdsNative<T>();
            let retentions = TypeAttributeRetentionsNative<T>();
            let origins = TypeAttributeOriginsNative<T>();
            let argumentNames = TypeAttributeArgumentNamesNative<T>();
            let argumentTypes = TypeAttributeArgumentTypesNative<T>();
            let argumentValues = TypeAttributeArgumentValuesNative<T>();
            let argumentDefaults = TypeAttributeArgumentUsedDefaultsNative<T>();
            let argumentOffsets = TypeAttributeArgumentOffsetsNative<T>();

            mut result: AttributeInfo[] = [];
            mut attributeIndex = 0usize;
            while (attributeIndex < names.Count()) {
                mut info = AttributeInfo();
                info.name = names[attributeIndex];
                info.stableTypeId = stableIds[attributeIndex];
                info.retention = retentions[attributeIndex];
                info.origin = origins[attributeIndex];

                mut argumentIndex = argumentOffsets[attributeIndex];
                while (argumentIndex < argumentOffsets[attributeIndex + 1usize]) {
                    mut argument = AttributeArgumentInfo();
                    argument.name = argumentNames[argumentIndex];
                    argument.typeName = argumentTypes[argumentIndex];
                    argument.value = argumentValues[argumentIndex];
                    argument.usedDefault = argumentDefaults[argumentIndex] != 0u8;
                    info.arguments.Push(argument);
                    argumentIndex += 1usize;
                }
                result.Push(info);
                attributeIndex += 1usize;
            }
            return result;
        }

        fn FieldAttributeNamesNative<T>() -> string[]
            with native, cpp::name(wio::runtime::ReflectedFieldAttributeNames);

        fn FieldAttributeOffsetsNative<T>() -> usize[]
            with native, cpp::name(wio::runtime::ReflectedFieldAttributeOffsets);

        fn FieldAttributes<T>(fieldName: string) -> string[] {
            let fields = FieldNames<T>();
            let names = FieldAttributeNamesNative<T>();
            let offsets = FieldAttributeOffsetsNative<T>();
            mut index = 0usize;
            while (index < fields.Count()) {
                if (fields[index] == fieldName and offsets.Count() > index + 1usize) {
                    mut result: string[] = [];
                    mut cursor = offsets[index];
                    while (cursor < offsets[index + 1usize]) {
                        result.Push(names[cursor]);
                        cursor += 1usize;
                    }
                    return result;
                }
                index += 1usize;
            }
            return [];
        }

        fn MethodBehavioralPipeline<T>(methodName: string) -> BehavioralProcessorInfo[] {
            let methods = MethodNames<T>();
            let attributeNames = MethodBehaviorAttributeNamesNative<T>();
            let processorTypes = MethodBehaviorProcessorTypesNative<T>();
            let phases = MethodBehaviorPhasesNative<T>();
            let hooks = MethodBehaviorHooksNative<T>();
            let modes = MethodBehaviorModesNative<T>();
            let offsets = MethodBehaviorOffsetsNative<T>();

            mut methodIndex = 0usize;
            while (methodIndex < methods.Count()) {
                if (methods[methodIndex] == methodName and offsets.Count() > methodIndex + 1usize) {
                    mut result: BehavioralProcessorInfo[] = [];
                    mut cursor = offsets[methodIndex];
                    while (cursor < offsets[methodIndex + 1usize]) {
                        mut processor = BehavioralProcessorInfo();
                        processor.attributeName = attributeNames[cursor];
                        processor.processorType = processorTypes[cursor];
                        processor.phase = phases[cursor];
                        processor.hook = hooks[cursor];
                        processor.mode = modes[cursor];
                        result.Push(processor);
                        cursor += 1usize;
                    }
                    return result;
                }
                methodIndex += 1usize;
            }
            return [];
        }

        fn Describe<T>() -> TypeInfo {
            mut result = TypeInfo();
            result.name = TypeName<T>();
            result.kind = TypeKind<T>();
            result.size = TypeSize<T>();
            result.alignment = TypeAlignment<T>();
            result.genericParameters = GenericParameterNames<T>();
            result.genericArguments = GenericArguments<T>();
            result.baseTypes = BaseTypes<T>();

            let fieldNames = FieldNames<T>();
            let fieldTypes = FieldTypes<T>();
            let fieldAccess = FieldAccess<T>();
            mut fieldIndex = 0usize;
            while (fieldIndex < fieldNames.Count()) {
                mut field = FieldInfo();
                field.name = fieldNames[fieldIndex];
                field.typeName = fieldTypes[fieldIndex];
                field.access = fieldAccess[fieldIndex];
                result.fields.Push(field);
                fieldIndex += 1usize;
            }

            let methodNames = MethodNames<T>();
            let methodSignatures = MethodSignatures<T>();
            let methodAccess = MethodAccess<T>();
            mut methodIndex = 0usize;
            while (methodIndex < methodNames.Count()) {
                mut method = MethodInfo();
                method.name = methodNames[methodIndex];
                method.signature = methodSignatures[methodIndex];
                method.access = methodAccess[methodIndex];
                method.behavioralPipeline = MethodBehavioralPipeline<T>(method.name);
                result.methods.Push(method);
                methodIndex += 1usize;
            }
            return result;
        }

        @Native
        @CppName(wio::runtime::EnumCount)
        fn Count<T>() -> usize;

        @Native
        @CppName(wio::runtime::EnumName)
        fn Name<T>(value: T) -> string;

        @Native
        @CppName(wio::runtime::EnumValue)
        fn Value<T>(index: usize) -> T;

        @Native
        @CppName(wio::runtime::EnumIndex)
        fn Index<T>(value: T) -> isize;

        @Native
        @CppName(wio::runtime::EnumUnderlyingTypeName)
        fn UnderlyingType<T>() -> string;

        @Native
        @CppName(wio::runtime::EnumSize)
        fn Size<T>() -> usize;

        @Native
        @CppName(wio::runtime::EnumIsValid)
        fn IsValid<T>(value: T) -> bool;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: i8, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: i8) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: i16, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: i16) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: i32, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: i32) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: i64, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: i64) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: isize, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: isize) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: u8, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: u8) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: u16, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: u16) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: u32, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: u32) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: u64, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: u64) -> T;

        @Native
        @CppName(wio::runtime::EnumTryFromRaw)
        fn TryFromValueNative<T>(value: usize, output: ref T) -> bool;

        @Native
        @CppName(wio::runtime::EnumFromRaw)
        fn FromValue<T>(value: usize) -> T;

        fn TryFromValue<T>(value: i8) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: i16) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: i32) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: i64) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: isize) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: u8) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: u16) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: u32) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: u64) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn TryFromValue<T>(value: usize) -> std::Option<T> {
            mut output: T;
            if (TryFromValueNative<T>(value, ref output)) { return std::Some<T>(output); }
            return std::None<T>();
        }

        fn Has<T>(value: T, mask: T) -> bool {
            return (value & mask) == mask;
        }

        fn HasAny<T>(value: T, mask: T) -> bool {
            return (value & mask) != (mask ^ mask);
        }

        fn With<T>(value: T, mask: T) -> T {
            return value | mask;
        }

        fn Without<T>(value: T, mask: T) -> T {
            return value ^ (value & mask);
        }

        fn Toggle<T>(value: T, mask: T) -> T {
            return value ^ mask;
        }

        fn Clear<T>(value: T) -> T {
            return value ^ value;
        }
    }
}
