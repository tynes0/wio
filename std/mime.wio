realm std {
    realm mime {
        fn FromExtension(extension: string) -> string {
            mut value = extension.ToLower();
            if (value.StartsWith(".")) { value = value.Skip(1usize); }
            return match (value) {
                "txt": "text/plain; charset=utf-8";
                "html", "htm": "text/html; charset=utf-8";
                "css": "text/css; charset=utf-8";
                "js", "mjs": "text/javascript; charset=utf-8";
                "json": "application/json";
                "xml": "application/xml";
                "csv": "text/csv; charset=utf-8";
                "png": "image/png";
                "jpg", "jpeg": "image/jpeg";
                "gif": "image/gif";
                "svg": "image/svg+xml";
                "pdf": "application/pdf";
                "zip": "application/zip";
                "wasm": "application/wasm";
                assumed: "application/octet-stream";
            };
        }

        fn IsText(value: string) -> bool {
            return value.StartsWith("text/") or value.Contains("json") or
                value.Contains("xml") or value.Contains("javascript");
        }
    }
}
