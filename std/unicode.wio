use std::result as result;

realm std {
    realm unicode {
        using cpp::header("std_unicode.h");

        component DecodeError {
            byteOffset: usize;
        }

        @Type(u8)
        enum NormalizationForm {
            nfc = 0u8,
            nfd = 1u8,
            nfkc = 2u8,
            nfkd = 3u8
        };

        fn TryDecodeNative(value: string, output: ref u32[], errorOffset: ref usize) -> bool
            with native, cpp::name(wio::runtime::std_unicode::TryDecode);
        fn TryEncodeNative(value: u32[], output: ref string, errorIndex: ref usize) -> bool
            with native, cpp::name(wio::runtime::std_unicode::TryEncode);
        fn TryDecodeUtf16Native(value: u16[], output: ref string, errorIndex: ref usize) -> bool
            with native, cpp::name(wio::runtime::std_unicode::TryDecodeUtf16);
        fn ToUtf16Native(value: string) -> u16[]
            with native, cpp::name(wio::runtime::std_unicode::EncodeUtf16);
        fn IsValidUtf8(value: string) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsValidUtf8);
        fn FromUtf8Native(value: string) -> text
            with native, cpp::name(wio::runtime::TextFromUtf8);
        fn ToUtf8(value: text) -> string
            with native, cpp::name(wio::runtime::TextToUtf8);
        fn CodePointCount(value: string) -> usize
            with native, cpp::name(wio::runtime::std_unicode::CodePointCount);
        fn Slice(value: string, start: usize, count: usize) -> string
            with native, cpp::name(wio::runtime::std_unicode::SliceCodePoints);
        fn TryAppendCodePoint(value: ref string, codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::TryAppendCodePoint);
        fn AppendByteCharacter(value: ref string, character: char)
            with native, cpp::name(wio::runtime::std_unicode::AppendByteCharacter);
        fn ByteAt(value: string, index: usize) -> u8
            with native, cpp::name(wio::runtime::std_unicode::ByteAt);
        fn AppendByte(value: ref string, byte: u8)
            with native, cpp::name(wio::runtime::std_unicode::AppendByte);
        fn IsWhitespace(codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsWhitespace);
        fn IsAscii(codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsAscii);
        fn IsDigit(codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsDigit);
        fn IsLetter(codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsLetter);
        fn ToLower(codePoint: u32) -> u32
            with native, cpp::name(wio::runtime::std_unicode::ToLower);
        fn ToUpper(codePoint: u32) -> u32
            with native, cpp::name(wio::runtime::std_unicode::ToUpper);
        fn IsCombiningMark(codePoint: u32) -> bool
            with native, cpp::name(wio::runtime::std_unicode::IsCombiningMark);
        fn GraphemeCount(value: string) -> usize
            with native, cpp::name(wio::runtime::std_unicode::GraphemeCount);
        fn SliceGraphemes(value: string, start: usize, count: usize) -> string
            with native, cpp::name(wio::runtime::std_unicode::SliceGraphemes);
        fn DisplayWidth(value: string) -> usize
            with native, cpp::name(wio::runtime::std_unicode::DisplayWidth);
        fn CaseFold(value: string) -> string
            with native, cpp::name(wio::runtime::std_unicode::CaseFold);
        fn TryNormalizeNative(value: string, form: NormalizationForm, output: ref string) -> bool
            with native, cpp::name(wio::runtime::std_unicode::TryNormalize);

        fn Normalize(value: string, form: NormalizationForm) -> std::Result<string> {
            mut output = "";
            if (TryNormalizeNative(value, form, ref output)) {
                return std::Ok(output);
            }
            return std::Err<string>(std::MakeResultError(
                std::ResultDomain::runtime, 5, "Unicode normalization failed: invalid UTF-8 or form."
            ));
        }

        fn Normalize(value: text, form: NormalizationForm) -> std::Result<text> {
            let normalized = Normalize(ToUtf8(value), form);
            if (normalized.IsError()) {
                return std::Err<text>(normalized.ErrorValue());
            }
            return std::Ok(FromUtf8Native(normalized.Value()));
        }

        fn NormalizeNfc(value: string) -> std::Result<string> {
            return Normalize(value, NormalizationForm::nfc);
        }
        fn NormalizeNfd(value: string) -> std::Result<string> {
            return Normalize(value, NormalizationForm::nfd);
        }
        fn NormalizeNfkc(value: string) -> std::Result<string> {
            return Normalize(value, NormalizationForm::nfkc);
        }
        fn NormalizeNfkd(value: string) -> std::Result<string> {
            return Normalize(value, NormalizationForm::nfkd);
        }
        fn IsNormalized(value: string, form: NormalizationForm) -> bool {
            let normalized = Normalize(value, form);
            return normalized.IsOk() and normalized.Value() == value;
        }

        fn FromUtf8(value: string) -> std::Result<text> {
            if (IsValidUtf8(value)) {
                return std::Ok(FromUtf8Native(value));
            }
            return std::Err<text>(std::MakeResultError(
                std::ResultDomain::runtime, 1, "Invalid UTF-8 text."
            ));
        }

        fn FromUtf16(value: u16[]) -> std::Result<text> {
            mut output = "";
            mut errorIndex: usize = 0usize;
            if (TryDecodeUtf16Native(value, ref output, ref errorIndex)) {
                return std::Ok(FromUtf8Native(output));
            }
            return std::Err<text>(std::MakeResultError(
                std::ResultDomain::runtime,
                3,
                $"Invalid UTF-16 at code-unit index ${errorIndex}."
            ));
        }

        fn ToUtf16(value: text) -> u16[] {
            return ToUtf16Native(ToUtf8(value));
        }

        fn FromUtf32(value: u32[]) -> std::Result<text> {
            mut output = "";
            mut errorIndex: usize = 0usize;
            if (TryEncodeNative(value, ref output, ref errorIndex)) {
                return std::Ok(FromUtf8Native(output));
            }
            return std::Err<text>(std::MakeResultError(
                std::ResultDomain::runtime,
                4,
                $"Invalid UTF-32 scalar at index ${errorIndex}."
            ));
        }

        fn ToUtf32(value: text) -> u32[] {
            return value.CodePoints();
        }

        fn Decode(value: string) -> std::Result<u32[]> {
            mut output: u32[] = [];
            mut errorOffset: usize = 0usize;
            if (TryDecodeNative(value, ref output, ref errorOffset)) {
                return std::Ok(output);
            }
            return std::Err<u32[]>(std::MakeResultError(
                std::ResultDomain::runtime,
                1,
                $"Invalid UTF-8 at byte ${errorOffset}."
            ));
        }

        fn Encode(value: u32[]) -> std::Result<string> {
            mut output = "";
            mut errorIndex: usize = 0usize;
            if (TryEncodeNative(value, ref output, ref errorIndex)) {
                return std::Ok(output);
            }
            return std::Err<string>(std::MakeResultError(
                std::ResultDomain::runtime,
                2,
                $"Invalid Unicode scalar at index ${errorIndex}."
            ));
        }

        fn AppendCodePoint(value: ref string, codePoint: u32) -> std::UnitResult {
            if (TryAppendCodePoint(value, codePoint)) {
                return std::OkUnit();
            }
            return std::ErrUnit(std::MakeResultError(
                std::ResultDomain::runtime, 2, "Invalid Unicode scalar value."
            ));
        }
    }
}
