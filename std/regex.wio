use std::result as result;

realm std {
    realm regex {
        using cpp::header("std_regex.h");

        @Native
        @Type(u8)
        @CppName(wio::runtime::std_regex::RegexError)
        enum Error {
            none = 0u8,
            invalid_pattern = 1u8,
            runtime_error = 2u8,
            limit_exceeded = 3u8
        };

        component Capture {
            matched: bool;
            byteIndex: usize;
            byteLength: usize;
            value: string;
        }

        component Match {
            found: bool;
            index: usize;
            length: usize;
            value: string;
            groups: string[];
            captures: Capture[];
        }

        @Native
        @CppName(wio::runtime::std_regex::ToString)
        fn ErrorName(error: Error) -> string;

        @Native
        @CppName(wio::runtime::std_regex::ErrorValue)
        fn ErrorCode(error: Error) -> i32;

        @Native
        @CppName(wio::runtime::std_regex::TryIsMatch)
        fn TryIsMatchNative(
            input: string,
            pattern: string,
            ignoreCase: bool,
            matched: ref bool,
            error: ref Error,
            message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_regex::TryFind)
        fn TryFindNative(
            input: string,
            pattern: string,
            ignoreCase: bool,
            found: ref bool,
            index: ref usize,
            length: ref usize,
            value: ref string,
            groups: ref string[],
            error: ref Error,
            message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_regex::TryFindAll)
        fn TryFindAllNative(
            input: string,
            pattern: string,
            ignoreCase: bool,
            matches: ref string[],
            error: ref Error,
            message: ref string) -> bool;

        fn TryFindAllDetailedNative(
            input: string,
            pattern: string,
            ignoreCase: bool,
            maxMatches: usize,
            maxCaptureGroups: usize,
            values: ref string[],
            indices: ref usize[],
            lengths: ref usize[],
            captureValues: ref string[],
            captureIndices: ref usize[],
            captureLengths: ref usize[],
            captureMatched: ref u8[],
            captureCounts: ref usize[],
            error: ref Error,
            message: ref string) -> bool
            with native, cpp::name(wio::runtime::std_regex::TryFindAllDetailed);

        @Native
        @CppName(wio::runtime::std_regex::TryReplace)
        fn TryReplaceNative(
            input: string,
            pattern: string,
            replacement: string,
            ignoreCase: bool,
            output: ref string,
            error: ref Error,
            message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_regex::TrySplit)
        fn TrySplitNative(
            input: string,
            pattern: string,
            ignoreCase: bool,
            output: ref string[],
            error: ref Error,
            message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_regex::Escape)
        fn Escape(value: string) -> string;

        fn PatternLooksSafe(pattern: string) -> bool
            with native, cpp::name(wio::runtime::std_regex::PatternLooksSafe);

        component Limits {
            maxInputBytes: usize;
            maxPatternBytes: usize;
            maxMatches: usize;
            maxCaptureGroups: usize;
        }

        fn DefaultLimits() -> Limits {
            mut limits = Limits();
            limits.maxInputBytes = 1048576usize;
            limits.maxPatternBytes = 4096usize;
            limits.maxMatches = 10000usize;
            limits.maxCaptureGroups = 64usize;
            return limits;
        }

        fn CheckSafety(input: string, pattern: string, limits: Limits) -> std::UnitResult {
            if (input.Count() > limits.maxInputBytes or pattern.Count() > limits.maxPatternBytes) {
                return std::ErrUnit(std::MakeResultError(
                    std::ResultDomain::runtime, 3, "Regular-expression input limit exceeded."));
            }
            if (not PatternLooksSafe(pattern)) {
                return std::ErrUnit(std::MakeResultError(
                    std::ResultDomain::runtime, 4, "Potentially unsafe regular-expression pattern rejected."));
            }
            return std::OkUnit();
        }

        fn IsMatchSafe(input: string, pattern: string, limits: Limits) -> std::Result<bool> {
            let safety = CheckSafety(input, pattern, limits);
            if (safety.IsError()) { return std::Err<bool>(safety.ErrorValue()); }
            return IsMatch(input, pattern);
        }

        fn MakeError(error: Error, message: string) -> std::ResultError {
            mut finalMessage = message;
            if (finalMessage == "") {
                finalMessage = "regex error " + ErrorName(error);
            }
            return std::MakeResultError(std::ResultDomain::runtime, ErrorCode(error), finalMessage);
        }

        fn IsMatch(input: string, pattern: string, ignoreCase: bool) -> std::Result<bool> {
            mut matched = false;
            mut error = Error::none;
            mut message = "";
            if (TryIsMatchNative(input, pattern, ignoreCase, ref matched, ref error, ref message)) {
                return std::Ok<bool>(matched);
            }
            return std::Err<bool>(MakeError(error, message));
        }

        fn IsMatch(input: string, pattern: string) -> std::Result<bool> {
            return IsMatch(input, pattern, false);
        }

        fn Find(input: string, pattern: string, ignoreCase: bool) -> std::Result<Match> {
            mut result = Match();
            mut error = Error::none;
            mut message = "";
            if (TryFindNative(
                    input,
                    pattern,
                    ignoreCase,
                    ref result.found,
                    ref result.index,
                    ref result.length,
                    ref result.value,
                    ref result.groups,
                    ref error,
                    ref message)) {
                return std::Ok<Match>(result);
            }
            return std::Err<Match>(MakeError(error, message));
        }

        fn Find(input: string, pattern: string) -> std::Result<Match> {
            return Find(input, pattern, false);
        }

        fn FindAll(input: string, pattern: string, ignoreCase: bool) -> std::Result<string[]> {
            mut matches: string[] = [];
            mut error = Error::none;
            mut message = "";
            if (TryFindAllNative(input, pattern, ignoreCase, ref matches, ref error, ref message)) {
                return std::Ok<string[]>(matches);
            }
            return std::Err<string[]>(MakeError(error, message));
        }

        fn FindAll(input: string, pattern: string) -> std::Result<string[]> {
            return FindAll(input, pattern, false);
        }

        fn FindAllMatchesSafe(
            input: string,
            pattern: string,
            ignoreCase: bool,
            limits: Limits
        ) -> std::Result<Match[]> {
            let safety = CheckSafety(input, pattern, limits);
            if (safety.IsError()) { return std::Err<Match[]>(safety.ErrorValue()); }

            mut values: string[] = [];
            mut indices: usize[] = [];
            mut lengths: usize[] = [];
            mut captureValues: string[] = [];
            mut captureIndices: usize[] = [];
            mut captureLengths: usize[] = [];
            mut captureMatched: u8[] = [];
            mut captureCounts: usize[] = [];
            mut error = Error::none;
            mut message = "";
            if (not TryFindAllDetailedNative(
                    input,
                    pattern,
                    ignoreCase,
                    limits.maxMatches,
                    limits.maxCaptureGroups,
                    ref values,
                    ref indices,
                    ref lengths,
                    ref captureValues,
                    ref captureIndices,
                    ref captureLengths,
                    ref captureMatched,
                    ref captureCounts,
                    ref error,
                    ref message)) {
                return std::Err<Match[]>(MakeError(error, message));
            }

            mut matches: Match[] = [];
            mut captureOffset = 0usize;
            mut matchIndex = 0usize;
            while (matchIndex < values.Count()) {
                mut found = Match();
                found.found = true;
                found.index = indices[matchIndex];
                found.length = lengths[matchIndex];
                found.value = values[matchIndex];
                found.groups = [];
                found.captures = [];
                mut groupIndex = 0usize;
                while (groupIndex < captureCounts[matchIndex]) {
                    let flatIndex = captureOffset + groupIndex;
                    mut capture = Capture();
                    capture.matched = captureMatched[flatIndex] != 0u8;
                    capture.byteIndex = captureIndices[flatIndex];
                    capture.byteLength = captureLengths[flatIndex];
                    capture.value = captureValues[flatIndex];
                    found.groups.Push(capture.value);
                    found.captures.Push(capture);
                    groupIndex += 1usize;
                }
                captureOffset += captureCounts[matchIndex];
                matches.Push(found);
                matchIndex += 1usize;
            }
            return std::Ok(matches);
        }

        fn FindAllMatches(input: string, pattern: string, ignoreCase: bool) -> std::Result<Match[]> {
            return FindAllMatchesSafe(input, pattern, ignoreCase, DefaultLimits());
        }

        fn FindAllMatches(input: string, pattern: string) -> std::Result<Match[]> {
            return FindAllMatches(input, pattern, false);
        }

        fn Replace(input: string, pattern: string, replacement: string, ignoreCase: bool) -> std::Result<string> {
            mut output = "";
            mut error = Error::none;
            mut message = "";
            if (TryReplaceNative(input, pattern, replacement, ignoreCase, ref output, ref error, ref message)) {
                return std::Ok<string>(output);
            }
            return std::Err<string>(MakeError(error, message));
        }

        fn Replace(input: string, pattern: string, replacement: string) -> std::Result<string> {
            return Replace(input, pattern, replacement, false);
        }

        fn Split(input: string, pattern: string, ignoreCase: bool) -> std::Result<string[]> {
            mut output: string[] = [];
            mut error = Error::none;
            mut message = "";
            if (TrySplitNative(input, pattern, ignoreCase, ref output, ref error, ref message)) {
                return std::Ok<string[]>(output);
            }
            return std::Err<string[]>(MakeError(error, message));
        }

        fn Split(input: string, pattern: string) -> std::Result<string[]> {
            return Split(input, pattern, false);
        }

        object Regex {
            private pattern: string;
            private ignoreCase: bool;

            public fn OnConstruct(pattern: string) {
                self.pattern = pattern;
                self.ignoreCase = false;
            }

            public fn OnConstruct(pattern: string, ignoreCase: bool) {
                self.pattern = pattern;
                self.ignoreCase = ignoreCase;
            }

            public fn IsMatch(input: string) -> std::Result<bool> {
                return regex::IsMatch(input, self.pattern, self.ignoreCase);
            }

            public fn Find(input: string) -> std::Result<Match> {
                return regex::Find(input, self.pattern, self.ignoreCase);
            }

            public fn FindAll(input: string) -> std::Result<string[]> {
                return regex::FindAll(input, self.pattern, self.ignoreCase);
            }

            public fn FindAllMatches(input: string) -> std::Result<Match[]> {
                return regex::FindAllMatches(input, self.pattern, self.ignoreCase);
            }

            public fn Replace(input: string, replacement: string) -> std::Result<string> {
                return regex::Replace(input, self.pattern, replacement, self.ignoreCase);
            }

            public fn Split(input: string) -> std::Result<string[]> {
                return regex::Split(input, self.pattern, self.ignoreCase);
            }
        }
    }
}
