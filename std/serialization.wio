use std::convert as convert;

realm std {
    realm serialization {
        using cpp::header("std_serialization.h");

        @Native @CppName(wio::runtime::std_serialization::JsonEscape)
        fn EscapeJson(value: string) -> string;

        @Native @CppName(wio::runtime::std_serialization::JsonQuote)
        fn QuoteJson(value: string) -> string;

        @Native @CppName(wio::runtime::std_serialization::JsonUnquote)
        fn UnquoteJson(value: string) -> string;

        fn IsValidJsonNumber(value: string) -> bool
            with native, cpp::name(wio::runtime::std_serialization::JsonNumberIsValid);

        fn IsJsonInteger(value: string) -> bool
            with native, cpp::name(wio::runtime::std_serialization::JsonNumberIsInteger);

        // A format-neutral serialization capability. A codec carries two
        // statically typed functions; the same value may therefore have
        // multiple codecs without relying on global registration.
        object Codec<TValue, TWire> {
            private encoder: fn(TValue) -> std::Result<TWire>;
            private decoder: fn(TWire) -> std::Result<TValue>;

            OnConstruct(
                encoder: fn(TValue) -> std::Result<TWire>,
                decoder: fn(TWire) -> std::Result<TValue>
            ) {
                self.encoder = encoder;
                self.decoder = decoder;
            }

            public fn Encode(value: TValue) -> std::Result<TWire> {
                return self.encoder(value);
            }

            public fn Decode(value: TWire) -> std::Result<TValue> {
                return self.decoder(value);
            }
        }

        fn MakeCodec<TValue, TWire>(
            encoder: fn(TValue) -> std::Result<TWire>,
            decoder: fn(TWire) -> std::Result<TValue>
        ) -> Codec<TValue, TWire> {
            return Codec<TValue, TWire>(encoder, decoder);
        }

        fn EncodeWith<TValue, TWire>(
            value: TValue,
            codec: Codec<TValue, TWire>
        ) -> std::Result<TWire> {
            return codec.Encode(value);
        }

        fn DecodeWith<TValue, TWire>(
            value: TWire,
            codec: Codec<TValue, TWire>
        ) -> std::Result<TValue> {
            return codec.Decode(value);
        }

        fn ToJson(value: string) -> string { return QuoteJson(value); }
        fn ToJson(value: bool) -> string {
            if (value) { return "true"; }
            return "false";
        }
        fn ToJson(value: i32) -> string { return std::ToString<i32>(value); }
        fn ToJson(value: i64) -> string { return std::ToString<i64>(value); }
        fn ToJson(value: u32) -> string { return std::ToString<u32>(value); }
        fn ToJson(value: u64) -> string { return std::ToString<u64>(value); }
        fn ToJson(value: f32) -> string { return std::ToString<f32>(value); }
        fn ToJson(value: f64) -> string { return std::ToString<f64>(value); }
        fn NullJson() -> string { return "null"; }

        fn ArrayJson(values: string[]) -> string {
            return "[" + values.Join(",") + "]";
        }

        fn FieldJson(name: string, encodedValue: string) -> string {
            return QuoteJson(name) + ":" + encodedValue;
        }

        fn ObjectJson(fields: string[]) -> string {
            return "{" + fields.Join(",") + "}";
        }
    }

}
