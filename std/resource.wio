realm std {
    realm resource {
        mut liveResourceCount: usize = 0usize;

        object Borrowed<T> {
            private value: T;

            OnConstruct(value: T) {
                self.value = value;
            }

            public fn Value() -> T {
                return self.value;
            }
        }

        object Owned<T> {
            private value: T;
            private closer: fn(T);
            private disposed: bool;

            OnConstruct(value: T, closer: fn(T)) {
                self.value = value;
                self.closer = closer;
                self.disposed = false;
                liveResourceCount += 1usize;
            }

            OnDestruct() {
                if (not self.disposed) {
                    self.disposed = true;
                    liveResourceCount -= 1usize;
                    self.closer(self.value);
                }
            }

            public fn IsDisposed() -> bool {
                return self.disposed;
            }

            public fn Dispose() -> bool {
                if (self.disposed) {
                    return false;
                }

                self.disposed = true;
                liveResourceCount -= 1usize;
                self.closer(self.value);
                return true;
            }

            public fn Value() -> T {
                if (self.disposed) {
                    std::Panic("resource::Owned<T>.Value cannot access a disposed resource.");
                }

                return self.value;
            }

            public fn Release() -> T {
                if (self.disposed) {
                    std::Panic("resource::Owned<T>.Release cannot release a disposed resource.");
                }

                self.disposed = true;
                liveResourceCount -= 1usize;
                return self.value;
            }

            public fn Borrow() -> Borrowed<T> {
                if (self.disposed) {
                    std::Panic("resource::Owned<T>.Borrow cannot borrow a disposed resource.");
                }

                return Borrowed<T>(self.value);
            }
        }

        fn MakeOwned<T>(value: T, closer: fn(T)) -> Owned<T> {
            return Owned<T>(value, closer);
        }

        fn MakeBorrowed<T>(value: T) -> Borrowed<T> {
            return Borrowed<T>(value);
        }

        fn LiveResourceCount() -> usize {
            return liveResourceCount;
        }
    }
}
