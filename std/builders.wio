use std::result as result;
use std::unicode as unicode;

realm std
{
    realm builders
    {
        using cpp::header("std_builders.h");

        [native, cpp::name(wio::runtime::std_builders::ReserveString)]
        fn ReserveStringNative(value: ref string, capacity: usize);

        [native, cpp::name(wio::runtime::std_builders::AppendBytes)]
        fn AppendBytesNative(value: ref u8[], source: string);

        [native, cpp::name(wio::runtime::std_builders::ReadBytes)]
        fn ReadBytesNative(value: u8[], start: usize, count: usize) -> string;

        [Type(i32)]
        enum ReadErrorCode
        {
            unexpectedEnd = 1101,
            invalidVarUInt = 1102,
            invalidUtf8 = 1103
        };

        fn ReadFailure(code: ReadErrorCode, message: string) -> std::ResultError
        {
            return std::MakeResultError(std::ResultDomain::io, code.Value(), message);
        }

        fn EndOfInput<T>() -> std::Result<T>
        {
            return std::Err<T>(ReadFailure(ReadErrorCode::unexpectedEnd, "ByteReader reached the end of the input."));
        }

        object StringBuilder
        {
            private value: string;

            public fn OnConstruct()
            {
                self.value = "";
            }

            public fn OnConstruct(initial: string)
            {
                self.value = initial;
            }

            public fn OnConstruct(capacity: usize)
            {
                self.value = "";
                ReserveStringNative(ref self.value, capacity);
            }

            public fn Reserve(capacity: usize)
            {
                ReserveStringNative(ref self.value, capacity);
            }

            public fn Length() -> usize
            {
                return self.value.Count();
            }

            public fn Empty() -> bool
            {
                return self.value.Empty();
            }

            public fn Clear()
            {
                self.value = "";
            }

            public fn Append(value: string)
            {
                self.value += value;
            }

            public fn AppendChar(value: char)
            {
                unicode::AppendByteCharacter(ref self.value, value);
            }

            public fn AppendLine(value: string)
            {
                self.value += value + "\n";
            }

            public fn AppendCodePoint(value: u32) -> std::UnitResult
            {
                return unicode::AppendCodePoint(ref self.value, value);
            }

            public fn ToString() -> string
            {
                return self.value;
            }

        }

        object ByteWriter
        {
            private bytes: u8[];

            public fn OnConstruct()
            {
                self.bytes = [];
            }

            public fn OnConstruct(capacity: usize)
            {
                self.bytes = [];
                self.bytes.Reserve(capacity);
            }

            public fn Length() -> usize
            {
                return self.bytes.Count();
            }

            public fn Clear()
            {
                self.bytes.Clear();
            }

            public fn WriteU8(value: u8)
            {
                self.bytes.Push(value);
            }

            public fn WriteU16LE(value: u16)
            {
                self.bytes.Push((value & 0xffu16) fit u8);
                self.bytes.Push(((value >> 8u16) & 0xffu16) fit u8);
            }

            public fn WriteU32LE(value: u32)
            {
                self.bytes.Push((value & 0xffu32) fit u8);
                self.bytes.Push(((value >> 8u32) & 0xffu32) fit u8);
                self.bytes.Push(((value >> 16u32) & 0xffu32) fit u8);
                self.bytes.Push(((value >> 24u32) & 0xffu32) fit u8);
            }

            public fn WriteU64LE(value: u64)
            {
                mut shift = 0u64;
                while (shift < 64u64)
                {
                    self.bytes.Push(((value >> shift) & 0xffu64) fit u8);
                    shift += 8u64;
                }

            }

            public fn WriteU16BE(value: u16)
            {
                self.bytes.Push(((value >> 8u16) & 0xffu16) fit u8);
                self.bytes.Push((value & 0xffu16) fit u8);
            }

            public fn WriteU32BE(value: u32)
            {
                self.bytes.Push(((value >> 24u32) & 0xffu32) fit u8);
                self.bytes.Push(((value >> 16u32) & 0xffu32) fit u8);
                self.bytes.Push(((value >> 8u32) & 0xffu32) fit u8);
                self.bytes.Push((value & 0xffu32) fit u8);
            }

            public fn WriteVarUInt(value: u64)
            {
                mut remaining = value;
                while (remaining >= 0x80u64)
                {
                    self.bytes.Push(((remaining & 0x7fu64) | 0x80u64) fit u8);
                    remaining >>= 7u64;
                }

                self.bytes.Push(remaining fit u8);
            }

            public fn WriteString(value: string)
            {
                self.WriteVarUInt(value.Count() fit u64);
                AppendBytesNative(ref self.bytes, value);
            }

            public fn WriteBytes(value: u8[])
            {
                self.bytes.Extend(value);
            }

            public fn ToArray() -> u8[]
            {
                return self.bytes;
            }

        }

        object ByteReader
        {
            private bytes: u8[];

            private position: usize;

            public fn OnConstruct(value: u8[])
            {
                self.bytes = value;
                self.position = 0usize;
            }

            public fn Position() -> usize
            {
                return self.position;
            }

            public fn Remaining() -> usize
            {
                return self.bytes.Count() - self.position;
            }

            public fn ReadU8() -> std::Result<u8>
            {
                if (self.position >= self.bytes.Count()) return EndOfInput<u8>();
                let value = self.bytes[self.position];
                self.position += 1usize;
                return std::Ok(value);
            }

            public fn ReadU16LE() -> std::Result<u16>
            {
                if (self.Remaining() < 2usize) return EndOfInput<u16>();
                let first = self.bytes[self.position] fit u16;
                let second = self.bytes[self.position + 1usize] fit u16;
                self.position += 2usize;
                return std::Ok<u16>((first | (second << 8u16)) fit u16);
            }

            public fn ReadU32LE() -> std::Result<u32>
            {
                if (self.Remaining() < 4usize) return EndOfInput<u32>();
                mut value = 0u32;
                mut index = 0usize;
                while (index < 4usize)
                {
                    value |= (self.bytes[self.position + index] fit u32) << ((index fit u32) * 8u32);
                    index += 1usize;
                }

                self.position += 4usize;
                return std::Ok(value);
            }

            public fn ReadU64LE() -> std::Result<u64>
            {
                if (self.Remaining() < 8usize) return EndOfInput<u64>();
                mut value = 0u64;
                mut index = 0usize;
                while (index < 8usize)
                {
                    value |= (self.bytes[self.position + index] fit u64) << ((index fit u64) * 8u64);
                    index += 1usize;
                }

                self.position += 8usize;
                return std::Ok(value);
            }

            public fn ReadU16BE() -> std::Result<u16>
            {
                if (self.Remaining() < 2usize) return EndOfInput<u16>();
                let value = ((self.bytes[self.position] fit u16) << 8u16) |
                    (self.bytes[self.position + 1usize] fit u16);
                self.position += 2usize;
                return std::Ok(value);
            }

            public fn ReadU32BE() -> std::Result<u32>
            {
                if (self.Remaining() < 4usize) return EndOfInput<u32>();
                mut value = 0u32;
                mut index = 0usize;
                while (index < 4usize)
                {
                    value = (value << 8u32) | (self.bytes[self.position + index] fit u32);
                    index += 1usize;
                }

                self.position += 4usize;
                return std::Ok(value);
            }

            public fn ReadVarUInt() -> std::Result<u64>
            {
                mut value = 0u64;
                mut shift = 0u64;
                mut cursor = self.position;
                while (cursor < self.bytes.Count() and shift <= 63u64)
                {
                    let byte = self.bytes[cursor];
                    if (shift == 63u64 and (byte & 0xfeu8) != 0u8)
                    {
                        return std::Err<u64>(ReadFailure(ReadErrorCode::invalidVarUInt, "VarUInt exceeds 64 bits."));
                    }

                    value |= ((byte & 0x7fu8) fit u64) << shift;
                    cursor += 1usize;
                    if ((byte & 0x80u8) == 0u8)
                    {
                        self.position = cursor;
                        return std::Ok(value);
                    }

                    shift += 7u64;
                }

                return EndOfInput<u64>();
            }

            public fn ReadBytes(count: usize) -> std::Result<u8[]>
            {
                if (count > self.Remaining()) return EndOfInput<u8[]>();
                let value = self.bytes.Slice(self.position, count);
                self.position += count;
                return std::Ok(value);
            }

            public fn ReadString() -> std::Result<string>
            {
                let original = self.position;
                let length = self.ReadVarUInt();
                if (length.IsError())
                {
                    return std::Err<string>(length.ErrorValue());
                }

                if (length.Value() > (self.Remaining() fit u64))
                {
                    self.position = original;
                    return std::Err<string>(ReadFailure(
                        ReadErrorCode::unexpectedEnd, "String length exceeds the remaining input."));
                }

                let count = length.Value() fit usize;
                let value = ReadBytesNative(self.bytes, self.position, count);
                if (not unicode::IsValidUtf8(value))
                {
                    self.position = original;
                    return std::Err<string>(ReadFailure(ReadErrorCode::invalidUtf8, "String contains invalid UTF-8."));
                }

                self.position += count;
                return std::Ok(value);
            }

            public fn Reset()
            {
                self.position = 0usize;
            }

        }

    }

}
