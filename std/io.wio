use std::result;

realm std {
    realm io {
        using cpp::header("std_io.h");

        @Native
        @CppName(wio::runtime::std_io::File)
        component File {}

        type NativeErrorCode = u64;

        @Native
        @Type(u32)
        @CppName(wio::runtime::std_io::OpenMode)
        flagset OpenMode {
            none = 0u32,
            read = 1u32 << 0u32,
            write = 1u32 << 1u32,
            append = 1u32 << 2u32,
            create = 1u32 << 3u32,
            create_new = 1u32 << 4u32,
            truncate = 1u32 << 5u32,
            binary = 1u32 << 6u32,
            text = 1u32 << 7u32,
            share_read = 1u32 << 8u32,
            share_write = 1u32 << 9u32,
            share_delete = 1u32 << 10u32,
            sequential = 1u32 << 11u32,
            random_access = 1u32 << 12u32,
            write_through = 1u32 << 13u32,
            temporary = 1u32 << 14u32,
            delete_on_close = 1u32 << 15u32,
            inheritable = 1u32 << 16u32
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::std_io::FileError)
        enum FileError {
            none = 0u8,
            null_path = 1u8,
            empty_path = 2u8,
            invalid_path = 3u8,
            invalid_utf8 = 4u8,
            allocation_failed = 5u8,
            invalid_argument = 6u8,
            invalid_mode = 7u8,
            unsupported_mode = 8u8,
            already_open = 9u8,
            not_open = 10u8,
            open_failed = 11u8,
            close_failed = 12u8,
            sync_failed = 13u8,
            seek_failed = 14u8,
            tell_failed = 15u8,
            size_failed = 16u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::std_io::SeekOrigin)
        enum SeekOrigin {
            begin = 0u8,
            current = 1u8,
            end = 2u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::detail::io::ReadError)
        enum ReadError {
            none = 0u8,
            null_file = 1u8,
            invalid_argument = 2u8,
            eof = 3u8,
            io_error = 4u8,
            partial_read = 5u8,
            platform_error = 6u8
        };

        @Native
        @Type(u8)
        @CppName(wio::runtime::detail::io::WriteError)
        enum WriteError {
            none = 0u8,
            null_file = 1u8,
            null_data = 2u8,
            size_overflow = 3u8,
            io_error = 4u8,
            partial_write = 5u8
        };

        const OpenModeNone: OpenMode = OpenMode::none;
        const OpenModeRead: OpenMode = OpenMode::read;
        const OpenModeWrite: OpenMode = OpenMode::write;
        const OpenModeAppend: OpenMode = OpenMode::append;
        const OpenModeCreate: OpenMode = OpenMode::create;
        const OpenModeCreateNew: OpenMode = OpenMode::create_new;
        const OpenModeTruncate: OpenMode = OpenMode::truncate;
        const OpenModeBinary: OpenMode = OpenMode::binary;
        const OpenModeText: OpenMode = OpenMode::text;
        const OpenModeShareRead: OpenMode = OpenMode::share_read;
        const OpenModeShareWrite: OpenMode = OpenMode::share_write;
        const OpenModeShareDelete: OpenMode = OpenMode::share_delete;
        const OpenModeSequential: OpenMode = OpenMode::sequential;
        const OpenModeRandomAccess: OpenMode = OpenMode::random_access;
        const OpenModeWriteThrough: OpenMode = OpenMode::write_through;
        const OpenModeTemporary: OpenMode = OpenMode::temporary;
        const OpenModeDeleteOnClose: OpenMode = OpenMode::delete_on_close;
        const OpenModeInheritable: OpenMode = OpenMode::inheritable;

        const OpenRead: OpenMode = OpenMode::read | OpenMode::share_read | OpenMode::sequential;
        const OpenReadBinary: OpenMode = OpenRead | OpenMode::binary;
        const OpenWrite: OpenMode = OpenMode::write | OpenMode::create | OpenMode::truncate | OpenMode::share_read;
        const OpenWriteBinary: OpenMode = OpenWrite | OpenMode::binary;
        const OpenAppend: OpenMode = OpenMode::write | OpenMode::append | OpenMode::create | OpenMode::share_read;
        const OpenAppendBinary: OpenMode = OpenAppend | OpenMode::binary;
        const OpenReadWriteExisting: OpenMode = OpenMode::read | OpenMode::write | OpenMode::share_read;
        const OpenReadWriteCreate: OpenMode = OpenMode::read | OpenMode::write | OpenMode::create | OpenMode::share_read;
        const OpenReadWriteTruncate: OpenMode = OpenMode::read | OpenMode::write | OpenMode::create | OpenMode::truncate | OpenMode::share_read;

        const FileErrorNone: FileError = FileError::none;
        const FileErrorNullPath: FileError = FileError::null_path;
        const FileErrorEmptyPath: FileError = FileError::empty_path;
        const FileErrorInvalidPath: FileError = FileError::invalid_path;
        const FileErrorInvalidUtf8: FileError = FileError::invalid_utf8;
        const FileErrorAllocationFailed: FileError = FileError::allocation_failed;
        const FileErrorInvalidArgument: FileError = FileError::invalid_argument;
        const FileErrorInvalidMode: FileError = FileError::invalid_mode;
        const FileErrorUnsupportedMode: FileError = FileError::unsupported_mode;
        const FileErrorAlreadyOpen: FileError = FileError::already_open;
        const FileErrorNotOpen: FileError = FileError::not_open;
        const FileErrorOpenFailed: FileError = FileError::open_failed;
        const FileErrorCloseFailed: FileError = FileError::close_failed;
        const FileErrorSyncFailed: FileError = FileError::sync_failed;
        const FileErrorSeekFailed: FileError = FileError::seek_failed;
        const FileErrorTellFailed: FileError = FileError::tell_failed;
        const FileErrorSizeFailed: FileError = FileError::size_failed;

        const SeekBegin: SeekOrigin = SeekOrigin::begin;
        const SeekCurrent: SeekOrigin = SeekOrigin::current;
        const SeekEnd: SeekOrigin = SeekOrigin::end;

        const ReadErrorNone: ReadError = ReadError::none;
        const ReadErrorNullFile: ReadError = ReadError::null_file;
        const ReadErrorInvalidArgument: ReadError = ReadError::invalid_argument;
        const ReadErrorEndOfFile: ReadError = ReadError::eof;
        const ReadErrorIoError: ReadError = ReadError::io_error;
        const ReadErrorPartialRead: ReadError = ReadError::partial_read;
        const ReadErrorPlatformError: ReadError = ReadError::platform_error;

        const WriteErrorNone: WriteError = WriteError::none;
        const WriteErrorNullFile: WriteError = WriteError::null_file;
        const WriteErrorNullData: WriteError = WriteError::null_data;
        const WriteErrorSizeOverflow: WriteError = WriteError::size_overflow;
        const WriteErrorIoError: WriteError = WriteError::io_error;
        const WriteErrorPartialWrite: WriteError = WriteError::partial_write;

        fn HasOpenModeFlag(value: OpenMode, mask: OpenMode) -> bool {
            return (value & mask) != OpenMode::none;
        }

        @Native
        @CppName(wio::runtime::std_io::ToString)
        fn FileErrorName(error: FileError) -> string;

        @Native
        @CppName(wio::runtime::std_io::ToString)
        fn ReadErrorName(error: ReadError) -> string;

        @Native
        @CppName(wio::runtime::std_io::ToString)
        fn WriteErrorName(error: WriteError) -> string;

        @Native
        @CppName(wio::runtime::std_io::FileErrorValue)
        fn FileErrorCode(error: FileError) -> i32;

        @Native
        @CppName(wio::runtime::std_io::ReadErrorValue)
        fn ReadErrorCode(error: ReadError) -> i32;

        @Native
        @CppName(wio::runtime::std_io::WriteErrorValue)
        fn WriteErrorCode(error: WriteError) -> i32;

        @Native
        @CppName(wio::runtime::std_io::NativeErrorCodeValue)
        fn NativeErrorCodeValue(value: NativeErrorCode) -> i64;

        @Native
        @CppName(wio::runtime::std_io::InvalidNativeFileHandleValue)
        fn InvalidNativeHandle() -> usize;

        @Native
        @CppName(wio::runtime::std_io::IsOpen)
        fn IsOpen(file: File) -> bool;

        @Native
        @CppName(wio::runtime::std_io::IsReadable)
        fn IsReadable(file: File) -> bool;

        @Native
        @CppName(wio::runtime::std_io::IsWritable)
        fn IsWritable(file: File) -> bool;

        @Native
        @CppName(wio::runtime::std_io::IsAppendOnly)
        fn IsAppendOnly(file: File) -> bool;

        @Native
        @CppName(wio::runtime::std_io::OpenStringArg)
        fn OpenRaw(path: string, mode: OpenMode) -> File;

        @Native
        @CppName(wio::runtime::std_io::AttachRaw)
        fn Attach(handle: usize, mode: OpenMode) -> File;

        @Native
        @CppName(wio::runtime::std_io::ResetRaw)
        fn Reset(file: ref File, handle: usize, mode: OpenMode);

        @Native
        @CppName(wio::runtime::std_io::ReleaseRaw)
        fn Release(file: ref File) -> usize;

        @Native
        @CppName(wio::runtime::std_io::Close)
        fn CloseRaw(file: ref File);

        @Native
        @CppName(wio::runtime::std_io::Sync)
        fn Sync(file: ref File);

        @Native
        @CppName(wio::runtime::std_io::Seek)
        fn Seek(file: ref File, offset: i64, origin: SeekOrigin);

        fn Seek(file: ref File, offset: i64) {
            Seek(file, offset, SeekOrigin::begin);
        }

        @Native
        @CppName(wio::runtime::std_io::Tell)
        fn Tell(file: File) -> i64;

        @Native
        @CppName(wio::runtime::std_io::Size)
        fn SizeRaw(file: File) -> u64;

        @Native
        @CppName(wio::runtime::std_io::ReadSome)
        fn ReadSome(file: ref File, maxSize: usize) -> string;

        @Native
        @CppName(wio::runtime::std_io::ReadSomeByteValues)
        fn ReadSomeBytes(file: ref File, maxSize: usize) -> u8[];

        @Native
        @CppName(wio::runtime::std_io::Read)
        fn ReadRaw(file: ref File, size: usize) -> string;

        @Native
        @CppName(wio::runtime::std_io::ReadByteValues)
        fn ReadBytes(file: ref File, size: usize) -> u8[];

        @Native
        @CppName(wio::runtime::std_io::ReadChar)
        fn ReadChar(file: ref File) -> char;

        @Native
        @CppName(wio::runtime::std_io::ReadCount)
        fn ReadCount(file: ref File, count: usize) -> string;

        @Native
        @CppName(wio::runtime::std_io::ReadAll)
        fn ReadAllRaw(file: ref File) -> string;

        @Native
        @CppName(wio::runtime::std_io::ReadUntil)
        fn ReadUntil(file: ref File, delimiter: char, includeDelimiter: bool, stopOnEof: bool) -> string;

        fn ReadUntil(file: ref File, delimiter: char, includeDelimiter: bool) -> string {
            return ReadUntil(file, delimiter, includeDelimiter, true);
        }

        @Native
        @CppName(wio::runtime::std_io::ReadLine)
        fn ReadLineRaw(file: ref File, trimCarriageReturn: bool) -> string;

        fn ReadLineRaw(file: ref File) -> string {
            return ReadLineRaw(file, true);
        }

        @Native
        @CppName(wio::runtime::std_io::ReadWord)
        fn ReadWord(file: ref File) -> string;

        @Native
        @CppName(wio::runtime::std_io::WriteStringArg)
        fn WriteRaw(file: ref File, value: string) -> usize;

        @Native
        @CppName(wio::runtime::std_io::WriteByteValues)
        fn WriteBytes(file: ref File, bytes: u8[]) -> usize;

        @Native
        @CppName(wio::runtime::std_io::WriteLine)
        fn WriteLineRaw(file: ref File) -> usize;

        @Native
        @CppName(wio::runtime::std_io::WriteLine)
        fn WriteLineRaw(file: ref File, value: string) -> usize;

        @Native
        @CppName(wio::runtime::std_io::TryOpenStringArg)
        fn TryOpenResultNative(path: string, mode: OpenMode, file: ref File, error: ref FileError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryCloseResult)
        fn TryCloseResultNative(file: ref File, error: ref FileError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TrySizeResult)
        fn TrySizeResultNative(file: File, value: ref u64, error: ref FileError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryReadResult)
        fn TryReadResultNative(file: ref File, size: usize, value: ref string, error: ref ReadError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryReadAllResult)
        fn TryReadAllResultNative(file: ref File, value: ref string, error: ref ReadError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryReadLineResult)
        fn TryReadLineResultNative(file: ref File, trimCarriageReturn: bool, value: ref string, error: ref ReadError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryWriteStringArgResult)
        fn TryWriteResultNative(file: ref File, value: string, written: ref usize, error: ref WriteError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryWriteLineResult)
        fn TryWriteLineResultNative(file: ref File, written: ref usize, error: ref WriteError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        @Native
        @CppName(wio::runtime::std_io::TryWriteLineStringArgResult)
        fn TryWriteLineValueResultNative(file: ref File, value: string, written: ref usize, error: ref WriteError, nativeError: ref NativeErrorCode, message: ref string) -> bool;

        fn FileResultError(error: FileError, nativeError: NativeErrorCode, message: string) -> ResultError {
            return MakeResultError(ResultDomain::io, FileErrorCode(error), NativeErrorCodeValue(nativeError), message);
        }

        fn ReadResultError(error: ReadError, nativeError: NativeErrorCode, message: string) -> ResultError {
            return MakeResultError(ResultDomain::io, ReadErrorCode(error), NativeErrorCodeValue(nativeError), message);
        }

        fn WriteResultError(error: WriteError, nativeError: NativeErrorCode, message: string) -> ResultError {
            return MakeResultError(ResultDomain::io, WriteErrorCode(error), NativeErrorCodeValue(nativeError), message);
        }

        fn OpenReadText(path: string) -> Result<File> {
            return Open(path, OpenRead);
        }

        fn OpenReadBinaryFile(path: string) -> Result<File> {
            return Open(path, OpenReadBinary);
        }

        fn OpenWriteText(path: string) -> Result<File> {
            return Open(path, OpenWrite);
        }

        fn OpenWriteBinaryFile(path: string) -> Result<File> {
            return Open(path, OpenWriteBinary);
        }

        fn OpenAppendText(path: string) -> Result<File> {
            return Open(path, OpenAppend);
        }

        fn OpenAppendBinaryFile(path: string) -> Result<File> {
            return Open(path, OpenAppendBinary);
        }

        fn Open(path: string, mode: OpenMode) -> Result<File> {
            mut file = File();
            mut error = FileError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryOpenResultNative(path, mode, ref file, ref error, ref nativeError, ref message)) {
                return Result<File>(file);
            }

            return Result<File>(FileResultError(error, nativeError, message));
        }

        fn Close(file: ref File) -> UnitResult {
            mut error = FileError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryCloseResultNative(file, ref error, ref nativeError, ref message)) {
                return UnitResult(ResultUnit());
            }

            return UnitResult(FileResultError(error, nativeError, message));
        }

        fn Size(file: File) -> Result<u64> {
            mut value = 0u64;
            mut error = FileError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TrySizeResultNative(file, ref value, ref error, ref nativeError, ref message)) {
                return Result<u64>(value);
            }

            return Result<u64>(FileResultError(error, nativeError, message));
        }

        fn Read(file: ref File, size: usize) -> Result<string> {
            mut value = "";
            mut error = ReadError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryReadResultNative(file, size, ref value, ref error, ref nativeError, ref message)) {
                return Result<string>(value);
            }

            return Result<string>(ReadResultError(error, nativeError, message));
        }

        fn ReadAll(file: ref File) -> Result<string> {
            mut value = "";
            mut error = ReadError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryReadAllResultNative(file, ref value, ref error, ref nativeError, ref message)) {
                return Result<string>(value);
            }

            return Result<string>(ReadResultError(error, nativeError, message));
        }

        fn ReadLine(file: ref File, trimCarriageReturn: bool) -> Result<string> {
            mut value = "";
            mut error = ReadError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryReadLineResultNative(file, trimCarriageReturn, ref value, ref error, ref nativeError, ref message)) {
                return Result<string>(value);
            }

            return Result<string>(ReadResultError(error, nativeError, message));
        }

        fn ReadLine(file: ref File) -> Result<string> {
            return ReadLine(file, true);
        }

        fn Write(file: ref File, value: string) -> Result<usize> {
            mut written = 0usize;
            mut error = WriteError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryWriteResultNative(file, value, ref written, ref error, ref nativeError, ref message)) {
                return Result<usize>(written);
            }

            return Result<usize>(WriteResultError(error, nativeError, message));
        }

        fn WriteLine(file: ref File) -> Result<usize> {
            mut written = 0usize;
            mut error = WriteError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryWriteLineResultNative(file, ref written, ref error, ref nativeError, ref message)) {
                return Result<usize>(written);
            }

            return Result<usize>(WriteResultError(error, nativeError, message));
        }

        fn WriteLine(file: ref File, value: string) -> Result<usize> {
            mut written = 0usize;
            mut error = WriteError::none;
            mut nativeError = 0u64;
            mut message = "";

            if (TryWriteLineValueResultNative(file, value, ref written, ref error, ref nativeError, ref message)) {
                return Result<usize>(written);
            }

            return Result<usize>(WriteResultError(error, nativeError, message));
        }

        fn OpenResult(path: string, mode: OpenMode) -> Result<File> {
            return Open(path, mode);
        }

        fn CloseResult(file: ref File) -> UnitResult {
            return Close(file);
        }

        fn SizeResult(file: File) -> Result<u64> {
            return Size(file);
        }

        fn ReadResult(file: ref File, size: usize) -> Result<string> {
            return Read(file, size);
        }

        fn ReadAllResult(file: ref File) -> Result<string> {
            return ReadAll(file);
        }

        fn ReadLineResult(file: ref File, trimCarriageReturn: bool) -> Result<string> {
            return ReadLine(file, trimCarriageReturn);
        }

        fn ReadLineResult(file: ref File) -> Result<string> {
            return ReadLine(file);
        }

        fn WriteResult(file: ref File, value: string) -> Result<usize> {
            return Write(file, value);
        }

        fn WriteLineResult(file: ref File) -> Result<usize> {
            return WriteLine(file);
        }

        fn WriteLineResult(file: ref File, value: string) -> Result<usize> {
            return WriteLine(file, value);
        }
    }
}
