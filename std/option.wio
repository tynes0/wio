use std::result as result;

realm std {
    component OptionPair<A, B> {
        public first: A;
        public second: B;

        OnConstruct(first: A, second: B) {
            self.first = first;
            self.second = second;
        }
    }

    object Option<T> {
        private present: bool;
        private value: T;

        OnConstruct(value: T) {
            self.present = true;
            self.value = value;
        }

        OnConstruct() {
            self.present = false;
        }

        public fn IsSome() -> bool { return self.present; }
        public fn IsNone() -> bool { return not self.present; }

        public fn Value() -> T {
            if (self.present) { return self.value; }
            std::Panic("Option<T> does not contain a value.");
            return self.value;
        }

        public fn Unwrap() -> T { return self.Value(); }

        public fn ValueOr(fallback: T) -> T {
            if (self.present) { return self.value; }
            return fallback;
        }

        public fn Map<U>(transform: fn(T) -> U) -> Option<U> {
            if (self.present) { return std::Some<U>(transform(self.value)); }
            return std::None<U>();
        }

        public fn AndThen<U>(transform: fn(T) -> Option<U>) -> Option<U> {
            if (self.present) { return transform(self.value); }
            return std::None<U>();
        }

        public fn Filter(predicate: fn(T) -> bool) -> Option<T> {
            if (self.present and predicate(self.value)) { return std::Some<T>(self.value); }
            return std::None<T>();
        }

        public fn OrElse(fallback: fn() -> Option<T>) -> Option<T> {
            if (self.present) { return std::Some<T>(self.value); }
            return fallback();
        }

        public fn ToResult(error: ResultError) -> Result<T> {
            if (self.present) { return std::Ok<T>(self.value); }
            return std::Err<T>(error);
        }

        public fn Inspect(action: fn(T)) -> Option<T> {
            if (self.present) {
                action(self.value);
                return std::Some<T>(self.value);
            }
            return std::None<T>();
        }

        public fn ForEach(action: fn(T)) {
            if (self.present) { action(self.value); }
        }

        public fn ToArray() -> T[] {
            if (self.present) { return [self.value]; }
            return [];
        }

        public fn Zip<U>(other: Option<U>) -> Option<OptionPair<T, U> > {
            if (self.present and other.IsSome()) {
                let pair: OptionPair<T, U> = OptionPair<T, U>(self.value, other.Value());
                return std::Some(pair);
            }
            return Option<OptionPair<T, U> >();
        }

    }

    fn Some<T>(value: T) -> Option<T> { return Option<T>(value); }
    fn None<T>() -> Option<T> { return Option<T>(); }

    fn ResultToOption<T>(resultValue: Result<T>) -> Option<T> {
        if (resultValue.IsOk()) { return Some<T>(resultValue.Value()); }
        return None<T>();
    }

    fn TransposeOptionResult<T>(optionValue: Option<Result<T> >) -> Result<Option<T> > {
        if (optionValue.IsNone()) { return std::Ok(std::None<T>()); }
        let resultValue = optionValue.Value();
        if (resultValue.IsError()) {
            return std::ErrLike(resultValue.ErrorValue(), std::None<T>());
        }
        return std::Ok(std::Some<T>(resultValue.Value()));
    }

    realm option {
        type Option<T> = std::Option<T>;
        type Pair<A, B> = std::OptionPair<A, B>;
        fn Some<T>(value: T) -> Option<T> { return std::Some<T>(value); }
        fn None<T>() -> Option<T> { return std::None<T>(); }
        fn FromResult<T>(resultValue: std::Result<T>) -> Option<T> {
            return std::ResultToOption<T>(resultValue);
        }
        fn Transpose<T>(optionValue: Option<std::Result<T> >) -> std::Result<Option<T> > {
            return std::TransposeOptionResult<T>(optionValue);
        }
    }

    realm result {
        fn ToOption<T>(resultValue: std::Result<T>) -> std::Option<T> {
            return std::ResultToOption<T>(resultValue);
        }
    }
}
