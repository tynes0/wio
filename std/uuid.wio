realm std {
    realm uuid {
        use @CppHeader("std_utility.h");

        @Native @CppName(wio::runtime::std_uuid::NewV4)
        fn NewV4() -> string;

        @Native @CppName(wio::runtime::std_uuid::IsValid)
        fn IsValid(value: string) -> bool;

        fn Version(value: string) -> i32
            with native, cpp::name(wio::runtime::std_uuid::Version);
        fn Variant(value: string) -> string
            with native, cpp::name(wio::runtime::std_uuid::Variant);
        fn Normalize(value: string) -> string
            with native, cpp::name(wio::runtime::std_uuid::Normalize);
    }
}
