use telemetry_model;

mut gAccepted: i32 = 0;
mut gWarnings: i32 = 0;
mut gCriticals: i32 = 0;
mut gLastScore1000: i32 = 0;
mut gLastFingerprint: u64 = 0u64;

fn ResetGlobalPipeline() {
    gAccepted = 0;
    gWarnings = 0;
    gCriticals = 0;
    gLastScore1000 = 0;
    gLastFingerprint = 0u64;
}

fn IngestGlobal(sensorId: i32, rawValue: f32, baseline: f32, timestampMs: u64, gain: f32, offset: f32) -> i32 {
    let snapshot = BuildSnapshot(sensorId, rawValue, baseline, timestampMs, gain, offset);
    mut levelCode = 0;
    if (snapshot.level == AlertLevel::Critical) {
        levelCode = 2;
    }
    else if (snapshot.level == AlertLevel::Warning) {
        levelCode = 1;
    }

    gAccepted += 1;
    gLastScore1000 = (snapshot.score * 1000.0f) fit i32;
    gLastFingerprint = snapshot.fingerprint;

    if (levelCode >= 2) {
        gCriticals += 1;
    }
    else if (levelCode == 1) {
        gWarnings += 1;
    }

    return levelCode;
}

@ModuleApiVersion
fn RuntimeAbi() -> u32 {
    return 1u32;
}

@ModuleLoad
fn StartTelemetryPipeline() -> i32 {
    ResetGlobalPipeline();
    return 0;
}

@ModuleUpdate
fn UpdateTelemetryPipeline(deltaTime: f32) {
}

@ModuleUnload
fn StopTelemetryPipeline() {
    ResetGlobalPipeline();
}

@Export
@Command("telemetry.ingest")
@CppName(WioTelemetryIngest)
fn TelemetryIngest(sensorId: i32, rawValue: f32, baseline: f32, timestampMs: u64, gain: f32, offset: f32) -> i32 {
    return IngestGlobal(sensorId, rawValue, baseline, timestampMs, gain, offset);
}

@Export
@Command("telemetry.accepted")
@CppName(WioTelemetryAccepted)
fn TelemetryAccepted() -> i32 {
    return gAccepted;
}

@Export
@Command("telemetry.warnings")
@CppName(WioTelemetryWarnings)
fn TelemetryWarnings() -> i32 {
    return gWarnings;
}

@Export
@Command("telemetry.criticals")
@CppName(WioTelemetryCriticals)
fn TelemetryCriticals() -> i32 {
    return gCriticals;
}

@Export
@Command("telemetry.last-score-1000")
@CppName(WioTelemetryLastScore1000)
fn TelemetryLastScore1000() -> i32 {
    return gLastScore1000;
}

@Export
@Command("telemetry.last-fingerprint")
@CppName(WioTelemetryLastFingerprint)
fn TelemetryLastFingerprint() -> u64 {
    return gLastFingerprint;
}

@Export
@Event("telemetry.sample")
@CppName(WioTelemetrySampleEvent)
fn TelemetrySampleEvent(sensorId: i32, rawValue: f32, baseline: f32, timestampMs: u64) {
    IngestGlobal(sensorId, rawValue, baseline, timestampMs, 1.0f, 0.0f);
}
