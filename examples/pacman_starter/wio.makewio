schemaVersion = 1
name = "PacmanStarter"
template = "wio-native-app"

[toolchain]
buildDir = "build"
config = "Release"

[wio]
entry = "wio/main.wio"
target = "exe"
sourceRoots = ["wio"]
includeDirs = ["native/include", "../atlas_desk/native/include"]
linkDirs = ["../atlas_desk/native/lib"]
linkLibraries = ["raylib", "opengl32", "gdi32", "winmm"]
nativeSources = []
backendArgs = ["-O2"]

[host]
enabled = false

[build]
buildDir = ".wio-build"
config = "Release"

[outputs]
directory = ".wio-build/interop"
baseName = "pacman_starter"
wioName = "pacman_starter"
hostName = "pacman_starter.host"

[run]
passLibraryPath = false
args = []
workingDirectory = "."
