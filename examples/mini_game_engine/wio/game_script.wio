@Export
object GameScript {
    public title: string;
    public frame: i32;
    public score: i32;
    public bestScore: i32;
    public level: i32;
    public crashCount: i32;
    public gravity: f32;
    public flapImpulse: f32;
    public pipeSpeed: f32;
    public pipeGap: f32;
    public spawnInterval: f32;
    public skyR: i32;
    public skyG: i32;
    public skyB: i32;
    public birdR: i32;
    public birdG: i32;
    public birdB: i32;
    public pipeR: i32;
    public pipeG: i32;
    public pipeB: i32;

    public OnConstruct() {
        self.title = "Wio Sky Hopper";
        self.frame = 0;
        self.score = 0;
        self.bestScore = 0;
        self.level = 1;
        self.crashCount = 0;
        self.gravity = 1050.0f;
        self.flapImpulse = -365.0f;
        self.pipeSpeed = 185.0f;
        self.pipeGap = 215.0f;
        self.spawnInterval = 1.55f;
        self.skyR = 104;
        self.skyG = 196;
        self.skyB = 232;
        self.birdR = 255;
        self.birdG = 210;
        self.birdB = 70;
        self.pipeR = 64;
        self.pipeG = 180;
        self.pipeB = 92;
    }

    public fn Start() {
        self.frame = 0;
        self.score = 0;
        self.bestScore = 0;
        self.level = 1;
        self.crashCount = 0;
    }

    public fn Tick(deltaTime: f32, alive: bool, headless: bool) -> i32 {
        self.frame += 1;
        if (headless and self.frame >= 720) {
            return 1;
        }
        return 0;
    }

    public fn BirdVelocity(currentVelocity: f32, flapPressed: bool, deltaTime: f32) -> f32 {
        if (flapPressed) {
            return self.flapImpulse;
        }
        return currentVelocity + self.gravity * deltaTime;
    }

    public fn PipeSpeed() -> f32 { return self.pipeSpeed; }
    public fn PipeGap() -> f32 { return self.pipeGap; }
    public fn SpawnInterval() -> f32 { return self.spawnInterval; }

    public fn OnPipePassed() -> i32 {
        self.score += 1;
        if (self.score > self.bestScore) {
            self.bestScore = self.score;
        }

        self.level = 1 + (self.score / 4);
        self.pipeSpeed = 185.0f + ((self.level - 1) fit f32 * 16.0f);
        self.pipeGap = 215.0f - ((self.level - 1) fit f32 * 10.0f);
        if (self.pipeGap < 155.0f) {
            self.pipeGap = 155.0f;
        }

        self.spawnInterval = 1.55f - ((self.level - 1) fit f32 * 0.05f);
        if (self.spawnInterval < 1.15f) {
            self.spawnInterval = 1.15f;
        }

        self.skyR = 104 - ((self.level - 1) % 4) * 5;
        self.skyB = 232 - ((self.level - 1) % 3) * 8;
        return self.score;
    }

    public fn OnCrash() -> i32 {
        self.crashCount += 1;
        if (self.score > self.bestScore) {
            self.bestScore = self.score;
        }
        self.score = 0;
        self.level = 1;
        self.pipeSpeed = 185.0f;
        self.pipeGap = 215.0f;
        self.spawnInterval = 1.55f;
        return self.bestScore;
    }
}

@ModuleApiVersion
fn ScriptApiVersion() -> u32 { return 1u32; }

@ModuleLoad
fn LoadGameScript() -> i32 { return 0; }

@ModuleUpdate
fn UpdateGameScript(deltaTime: f32) { }

@ModuleUnload
fn UnloadGameScript() { }
