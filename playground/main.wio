use std::console as Console;
use std::vector;
use std::io as io;

fn Entry() -> void
{
    let openResult = std::io::Open("test.txt", std::io::OpenReadWriteCreate);
    if (openResult.IsOk())
    {
        mut f = openResult.Value();
        let writeResult = std::io::Write(ref f, "Hello, World!");
        if (writeResult.IsOk()) {
            std::io::Close(ref f);
        }
    }
}
