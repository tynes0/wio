schemaVersion = 1
name = "WioPlayground"
template = "wio-native-app"

[toolchain]
buildDir = "build"
config = "Debug"

[wio]
entry = "wio/main.wio"
target = "exe"
sourceRoots = ["wio"]
includeDirs = ["native/include"]
linkDirs = []
linkLibraries = []
nativeSources = ["native/src/playground_native.cpp"]
backendArgs = []

[host]
enabled = false

[build]
buildDir = ".wio-build"
config = "Debug"

[outputs]
# Follow --build-dir, so launcher backend/profile outputs stay isolated.
directory = ""
baseName = "wio_playground"
wioName = "wio_playground"
hostName = "wio_playground.host"

[run]
passLibraryPath = false
args = []
workingDirectory = "."
