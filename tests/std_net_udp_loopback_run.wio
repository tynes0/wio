use std::assert as assert;
use std::console as console;
use std::net as net;

fn Entry() -> i32 {
    let receiverResult = net::BindUdp("127.0.0.1", 0u16);
    assert::Expect(receiverResult.IsOk(), "bind UDP receiver");
    let receiver = receiverResult.Value();
    assert::Expect(receiver.SetTimeout(2000u64).IsOk(), "UDP receive timeout");

    let senderResult = net::BindUdp("127.0.0.1", 0u16);
    assert::Expect(senderResult.IsOk(), "bind UDP sender");
    let sender = senderResult.Value();
    let sent = sender.SendTo("127.0.0.1", receiver.LocalPort(), "wio-udp");
    assert::Expect(sent.IsOk() and sent.Value() == 7usize, "UDP send");

    let datagram = receiver.ReceiveFrom(64usize);
    assert::Expect(datagram.IsOk(), "UDP receive");
    assert::ExpectEqual(datagram.Value().bytes, "wio-udp", "UDP payload");
    assert::Expect(datagram.Value().remotePort != 0u16, "UDP remote endpoint");
    console::PrintLine("std-net-udp-loopback-ok");
    return 0;
}
