fn Entry() -> i32
{
    for (mut round = 0; round < 30; round += 1)
    {
        {
            if (Call<i32[]>(Change, [7])[0] != 9)
            {
                return 1;
            }
            let reversed = Reverse((writable, readonly) =>
            {
                writable = [readonly[0] + 2];
                return readonly;
            }, [7]);
            if (reversed[0] != 9)
            {
                return 2;
            }
            let empty = Call<i32[]>((readonly, writable) =>
            {
                writable = [23];
                return readonly;
            }, []);
            if (empty[0] != 23)
            {
                return 3;
            }
            let bits = Call<bool[]>((readonly, writable) =>
            {
                writable = [not readonly[0], true];
                return readonly;
            }, [true]);
            if (bits[0] or not bits[1])
            {
                return 4;
            }
            let words = Call<string[]>((readonly, writable) =>
            {
                writable = [readonly[0] + "\0z"];
                return readonly;
            }, ["🌍"]);
            if (words[0] != "🌍\0z")
            {
                return 5;
            }
            let texts = Call<text[]>((readonly, writable) =>
            {
                writable = [readonly[0] + u"\0z"];
                return readonly;
            }, [u"👩‍💻"]);
            if (texts[0] != u"👩‍💻\0z")
            {
                return 6;
            }
            let points = Call<Point[]>((readonly, writable) =>
            {
                writable = [Point(readonly[0].x + 2)];
                return readonly;
            }, [Point(7)]);
            if (points[0].x != 9)
            {
                return 7;
            }
            let nested = Call<i32[][]>((readonly, writable) =>
            {
                writable = [[readonly[0][0] + 2], [23]];
                return readonly;
            }, [[7]]);
            if (nested[0][0] != 9 or nested[1][0] != 23)
            {
                return 8;
            }
            let map: Dict<string, i32[]> = {"key": [7]};
            let changed = Call<Dict<string, i32[]>>((readonly, writable) =>
            {
                writable = {"key": [readonly["key"][0] + 2]};
                return readonly;
            }, map);
            if (changed["key"][0] != 9 or map["key"][0] != 7)
            {
                return 9;
            }
            let original = Item(7);
            let items = Call<Item[]>((readonly, writable) =>
            {
                writable = [Item(9), readonly[0]];
                return readonly;
            }, [original]);
            if (items[0].Read() != 9 or items[1] != original)
            {
                return 10;
            }
            let nullable: Item?[] = [null, original];
            let echo = Call<Item?[]>((readonly, writable) =>
            {
                writable = [readonly[1], null];
                return readonly;
            }, nullable);
            if (echo[0] != original or echo[1] != null)
            {
                return 11;
            }
            let tree: Tree<string, Item> = {< "key": original >};
            let ordered = Call<Tree<string, Item>>((readonly, writable) =>
            {
                writable = {< "key": Item(9) >};
                return readonly;
            }, tree);
            if (ordered["key"].Read() != 9)
            {
                return 12;
            }
            let scalar: any = 7;
            let boxed = Call<any>((readonly, writable) =>
            {
                writable = "changed\0🌍";
                return readonly;
            }, scalar);
            if ((boxed fit string) != "changed\0🌍")
            {
                return 13;
            }
            let item = Call<Item>((readonly, writable) =>
            {
                writable = Item(readonly.Read() + 2);
                return deref readonly;
            }, original);
            if (item.Read() != 9 or item == original)
            {
                return 14;
            }
            let reader = Call<IRead>((readonly, writable) =>
            {
                writable = Item(9) fit IRead;
                return deref readonly;
            }, original fit IRead);
            if (reader.Read() != 9)
            {
                return 15;
            }
            let present: Item? = original;
            let none = Call<Item?>((readonly: view Item?, writable: ref Item?) =>
            {
                writable = null;
                return deref readonly;
            }, present);
            if (none != null)
            {
                return 16;
            }
            let some = Call<Item?>((readonly: view Item?, writable: ref Item?) =>
            {
                writable = Item(9);
                return deref readonly;
            }, null);
            if (some == null)
            {
                return 17;
            }
            Store(Change, [7]);
            if (Run() != 2 or Run() != 2)
            {
                return 18;
            }
            Clear();
            if (Hosted(Processor()) != 0)
            {
                return 19;
            }
            let appended = Call<i32[]>((readonly, writable) =>
            {
                writable.Push(23);
                return readonly;
            }, [7]);
            if (appended.Count() != 2usize or appended[1] != 23)
            {
                return 22;
            }
            let assigned = Call<Dict<string, i32[]>>((readonly, writable) =>
            {
                writable["key"] = [23];
                return readonly;
            }, map);
            if (assigned["key"][0] != 23 or map["key"][0] != 7)
            {
                return 23;
            }
            let objectBox: any = original;
            let changedBox = Call<any>((readonly, writable) =>
            {
                writable = Item(9);
                return readonly;
            }, objectBox);
            if ((changedBox fit Item).Read() != 9 or (objectBox fit Item) != original)
            {
                return 24;
            }
            mut blank: any;
            let nulled = Call<any>((readonly, writable) =>
            {
                writable = blank;
                return readonly;
            }, scalar);
            if (nulled != null)
            {
                return 25;
            }
            if (View<Item>((readonly: view Item) => readonly.Read(), original) != 7
                or View<Item[]>((readonly: view Item[]) => readonly[0].Read(), [original]) != 7
                or View<any>((readonly: view any) => ((deref readonly) fit Item).Read(), objectBox) != 7)
            {
                return 26;
            }
        }
        if (not Balanced())
        {
            return 20;
        }
    }
    if (AtomicProbe((first, second) => 0) != 0)
    {
        return 21;
    }
    Print();
    return 0;
}
