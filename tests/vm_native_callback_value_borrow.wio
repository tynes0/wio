fn Change(readonly: view i32[], writable: ref i32[]) -> i32[]
{
    writable = [readonly[0] + 2, 23];
    return readonly;
}
fn HostArray()
{
    CaptureArray(Change, [7]);
}

fn HostMap()
{
    let initial: Dict<string, i32[]> = {"key": [7]};
    CaptureMap((readonly, writable) =>
    {
        writable = {"key": [9, 23]};
        return readonly;
    }, initial);
}
fn HostAny()
{
    let initial: any = 7;
    CaptureAny((readonly, writable) =>
    {
        writable = "changed\0🌍";
        return readonly;
    }, initial);
}
fn HostObject()
{
    CaptureObject((readonly, writable) =>
    {
        writable = Item(readonly.Read() + 2);
        return deref readonly;
    }, Item(7));
}
fn HostNullable()
{
    CaptureNullable((readonly, writable) =>
    {
        writable = Item(9);
        return deref readonly;
    }, null);
}
fn HostPanic()
{
    CaptureArray((readonly, writable) =>
    {
        writable = [99];
        Fail();
        return readonly;
    }, [7]);
}

fn HostBorrowCapture()
{
    CaptureArray((readonly, writable) =>
    {
        writable = [99];
        let escaped = () => readonly[0];
        let ignored = escaped();
        return readonly;
    }, [7]);
}

fn HostReceiver() -> u64
{
