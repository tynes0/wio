}
[From(IRead)]
object Item
{
    value: i32;
    public OnConstruct(value: i32)
    {
        self.value = value;
        Constructed();
    }

    OnDestruct()
    {
        Destroyed();
    }

    public fn Read() -> i32
    {
        return self.value;
    }

    public fn Set(value: i32)
    {
        self.value = value;
    }
}
object Processor
{
    first: i32[];
    second: i32[];
    held: Item[];
    public OnConstruct()
    {
        self.first = [7];
        self.second = [19];
        self.held = [Item(31)];
    }

    public fn Apply(callback: fn(view i32[], ref i32[]) -> i32[]) -> i32
    {
        mut values: i32[] = [7];
        let result = callback(ref values, ref values);
        if (result.Count() != values.Count())
        {
            return -1;
        }
        return values[1];
    }
    public fn Forward(callback: fn(view i32[], ref i32[]) -> i32[]) -> i32
    {
        return Call<i32[]>(callback, [7])[1];
    }
    public fn Pair(callback: fn(ref i32[], ref i32[]) -> i32) -> i32
    {
        return callback(ref self.first, ref self.second);
    }
    public fn First() -> i32
    {
        return self.first[0];
    }

    public fn Second() -> i32
    {
        return self.second[0];
    }
}

