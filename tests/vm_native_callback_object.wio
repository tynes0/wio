[Native, CppName(vm_callback_object::Fail)] fn Fail();
[Native, CppName(vm_callback_object::Print)] fn Print();
[Native, CppName(vm_callback_object::Call), Instantiate(Item), Instantiate(Item?), Instantiate(IRead), Instantiate(IRead?), Instantiate(Holder<i32, 7>), Instantiate(Holder<string, 9>)]
fn Call<T>(callback: fn(T) -> T, value: T) -> T;
[Native, CppName(vm_callback_object::Pair)]
fn Pair(callback: fn(Item, Item) -> Item, first: Item, second: Item) -> Item;
