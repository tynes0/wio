// This type appears only inside a callback signature, never as a free native
// parameter or result. Object adapter discovery must walk function types.
object CallbackOnly
{
    public OnConstruct()
    {
        Constructed();
    }
    OnDestruct()
    {
        Destroyed();
    }
    public fn Read() -> i32
