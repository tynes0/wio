fn Entry() -> i32
{
    for (mut round = 0; round < 30; round += 1)
    {
        {
            let first = Item(7);
            let second = Item(19);
            let same = Call<Item>((value) => value, first);
            if (same != first or same.Read() != 7)
            {
                return 1;
            }
            let chosen = Pair((left, right) => right, first, second);
            if (chosen != second)
            {
                return 2;
            }
            if (Mutate((value) => value.Set(23), first) != 23 or first.Read() != 23)
            {
                return 3;
            }
            let created = Call<Item>((value) => Item(value.Read() + 2), first);
            if (created == first or created.Read() != 25)
            {
                return 4;
            }
            let nullable: Item? = Call<Item?>((value) => value, null);
            if (nullable != null)
            {
                return 5;
            }
            let next: Item? = Call<Item?>((value) => Item(29), null);
            if (next == null or next.Read() != 29)
            {
                return 6;
            }
            let cleared = Call<Item?>((value) => null, next);
            if (cleared != null)
            {
                return 7;
            }
            let reader = Other(31) fit IRead;
            let echoed = Call<IRead>((value) => value, reader);
            if (echoed != reader or echoed.Read() != 31)
            {
                return 8;
            }
            let swapped = Call<IRead>((value: IRead) => first fit IRead, reader);
            if (swapped != (first fit IRead) or swapped.Read() != 23)
            {
                return 9;
            }
            let optionalReader: IRead? = Call<IRead?>((value: IRead?) => Other(41) fit IRead, null);
            if (optionalReader == null or optionalReader.Read() != 41)
            {
                return 10;
            }
            if (Call<IRead?>((value) => null, optionalReader) != null)
            {
                return 11;
            }
            let integer = Holder<i32, 7>(47);
            let textValue = Holder<string, 9>("a\0🌍");
            if (Call<Holder<i32, 7>>((value) => value, integer) != integer)
            {
                return 12;
            }
            if (Call<Holder<string, 9>>((value) => value, textValue).Read() != "a\0🌍")
            {
                return 13;
            }
            if (Factory(() => CallbackOnly()) != 37)
            {
                return 14;
            }
            StoreCall((value) => value, first);
            if (not Expired())
            {
                return 15;
            }
            StoreCaller((value) => value, second);
            if (Run() != 19)
            {
                return 16;
            }
            Clear();
        }
        StoreCaptured();
        if (Run() != 50 or Worker() != 50)
        {
            return 17;
        }
        Clear();
        if (not Balanced())
        {
            return 18;
        }
    }
    Print();
    return 0;
}
