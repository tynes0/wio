    value: i32;
    public OnConstruct(seed: i32)
    {
        self.value = seed;
        Constructed();
    }
    OnDestruct()
    {
        Destroyed();
    }
    public fn Read() -> i32
    {
        return self.value;
    }
    public fn Set(value: i32)
