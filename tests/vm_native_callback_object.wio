fn StoreCaptured()
{
    let captured = Item(43);
    StoreAny((value) => Item(value.Read() + captured.Read()), Item(7));
}
fn HostCapture()
{
    let captured = Item(43);
    Capture((value) => Item(value.Read() + captured.Read()), Item(7));
}
fn HostNullable()
{
    CaptureNullable((value) => value, null);
}
fn HostCaller()
{
    let captured = Item(43);
    CaptureCaller((value) => Item(value.Read() + captured.Read()), Item(7));
}
fn PanicCapture()
{
    Capture((value) => {
        Fail();
        return value;
    }, Item(7));
}
fn FailingCleanup()
{
    let captured = FailingCapture();
    StoreAny((value) => Item(value.Read() + captured.Read()), Item(7));
}
