use std::assert as assert;
use std::console as console;
use std::meta as meta;

const SecondIndexAlias: usize = 1usize;
const PenultimateDistanceAlias: usize = 1usize + 1usize;
const LastDistanceAlias: usize = 1usize;

type SecondAlias<Ts...> = Ts[SecondIndexAlias];
type PenultimateAlias<Ts...> = Ts[Ts.size - PenultimateDistanceAlias];
type LastAlias<Ts...> = Ts[Ts.size - LastDistanceAlias];

fn GetSecond<Args...>(args: Args...) -> Args[SecondIndexAlias] {
    return args[SecondIndexAlias];
}

fn GetPenultimate<Args...>(args: Args...) -> Args[Args.size - PenultimateDistanceAlias] {
    return args[Args.size - PenultimateDistanceAlias];
}

fn GetLast<Args...>(args: Args...) -> Args[Args.size - LastDistanceAlias] {
    return args[Args.size - LastDistanceAlias];
}

fn Entry() -> i32 {
    let secondTypeValue: SecondAlias<i32, bool, string> = true;
    let penultimateTypeValue: PenultimateAlias<i32, bool, string> = false;
    let lastTypeValue: LastAlias<i32, bool, string> = "ok";

    let secondValue = GetSecond(10i32, 20i32, 30i32);
    let penultimateValue = GetPenultimate(1i32, 2i32, 3i32, 4i32);
    let lastValue = GetLast(5i32, 6i32, 7i32);

    let metaSecondValue = meta::SecondValue(40i32, 50i32, 60i32);
    let metaPenultimateValue = meta::PenultimateValue(70i32, 80i32, 90i32, 100i32);
    let values: meta::Values<i32, i32, i32, i32> = meta::Values(11i32, 22i32, 33i32, 44i32);

    values.ReplaceSecond(55i32);
    values.ReplacePenultimate(66i32);

    assert::ExpectTrue(secondTypeValue, "const-index second type alias failed");
    assert::ExpectFalse(penultimateTypeValue, "const-index penultimate type alias failed");
    assert::ExpectEqual(lastTypeValue, "ok", "const-index last type alias failed");
    assert::ExpectEqual(secondValue, 20, "const-index second value failed");
    assert::ExpectEqual(penultimateValue, 3, "const-index penultimate value failed");
    assert::ExpectEqual(lastValue, 7, "const-index last value failed");
    assert::ExpectEqual(metaSecondValue, 50, "meta::SecondValue failed");
    assert::ExpectEqual(metaPenultimateValue, 90, "meta::PenultimateValue failed");
    assert::ExpectEqual(values.Second(), 55, "meta::Values.Second failed");
    assert::ExpectEqual(values.Penultimate(), 66, "meta::Values.Penultimate failed");
    assert::ExpectEqual(values.Last(), 44, "meta::Values.Last should stay unchanged");

    console::Print("Std meta wave 3: ok");
    return 0;
}
