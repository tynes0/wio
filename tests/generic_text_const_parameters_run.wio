use std::assert as assert;
use std::console as console;
use std::reflect as reflect;

const ProductName: string = "Wio" + " Language";
const TurkishGreeting: text = u$"Merhaba ${u"🌍"}";
const LiteralComparison: bool = "same" == "same";

component Named<const Name: string = "unnamed"> {
    value: i32;
}

type NamedAlias<const Name: string> = Named<Name>;

component Tagged<const Name: string> {
    value: i32;
}

@Specialize("special")
component Tagged {
    value: i32;
    specialized: bool;
}

component Wrapper<T> {
    value: T;
}

component Pair<A, B> {
    first: A;
    second: B;
}

@Specialize(T, Wrapper<U>)
component Pair<T, U> {
    first: T;
    second: Wrapper<U>;
    specialized: bool;
}

interface TextProvider<const Label: text> {
    fn GetLabel() -> text;
}

@From(TextProvider<Label>)
object TextBox<const Label: text> {
    value: i32;

    OnConstruct(value: i32) {
        self.value = value;
    }

    public fn GetLabel() -> text {
        return Label;
    }
}

fn StringValue<const Value: string>() -> string {
    return Value;
}

fn TextValue<const Value: text>() -> text {
    return Value;
}

fn ReadText<const Label: text>(value: view TextProvider<Label>) -> text {
    return value.GetLabel();
}

fn Entry() -> i32 {
    let direct: Named<"direct"> = Named<"direct">(1);
    let folded: Named<ProductName> = Named<ProductName>(2);
    let aliased: NamedAlias<ProductName> = Named<ProductName>(6);
    let defaults: Named = Named(3);
    let special = Tagged<"special">(4, true);
    let box = TextBox<TurkishGreeting>(5);
    let partial = Pair<i32, Wrapper<string>>(7, Wrapper<string>("wrapped"), true);

    assert::ExpectEqual(direct.value, 1, "direct string const generic");
    assert::Expect(LiteralComparison, "literal string comparison uses value semantics");
    assert::ExpectEqual(folded.value, 2, "folded const declaration generic argument");
    assert::ExpectEqual(aliased.value, 6, "string const generic type alias");
    assert::ExpectEqual(defaults.value, 3, "string const generic default");
    assert::Expect(special.specialized, "string const partial specialization");
    assert::ExpectEqual(StringValue<ProductName>(), "Wio Language", "function string const generic");
    assert::ExpectEqual(TextValue<u"İstanbul">(), u"İstanbul", "function text const generic");
    assert::ExpectEqual(box.GetLabel(), u"Merhaba 🌍", "object text const generic method");
    assert::ExpectEqual(
        ReadText<TurkishGreeting>(box),
        u"Merhaba 🌍",
        "interface preserves text const generic identity"
    );

    let namedParameterNames = reflect::GenericParameterNames<Named<ProductName>>();
    let namedArguments = reflect::GenericArguments<Named<ProductName>>();
    assert::ExpectEqual(namedParameterNames.Count(), 1usize, "generic reflection parameter count");
    assert::ExpectEqual(namedParameterNames[0], "Name", "generic reflection source parameter name");
    assert::ExpectEqual(namedArguments.Count(), 1usize, "generic reflection argument count");
    assert::ExpectEqual(namedArguments[0], "Wio Language", "generic reflection folded string value");

    let specializedInfo = reflect::Describe<Tagged<"special">>();
    assert::ExpectEqual(specializedInfo.genericParameters[0], "Name", "specialization parameter identity");
    assert::ExpectEqual(specializedInfo.genericArguments[0], "special", "specialization argument identity");

    let textArguments = reflect::GenericArguments<TextBox<TurkishGreeting>>();
    assert::ExpectEqual(textArguments.Count(), 1usize, "text generic reflection argument count");
    assert::Expect(textArguments[0].Count() > 0usize, "text generic reflection exposes UTF-8 value");

    let partialInfo = reflect::Describe<Pair<i32, Wrapper<string>>>();
    assert::Expect(partial.specialized, "partial specialization remains usable with reflection");
    assert::ExpectEqual(partialInfo.genericParameters.Count(), 2usize, "partial generic reflection parameter count");
    assert::ExpectEqual(partialInfo.genericParameters[0], "A", "partial generic primary parameter identity");
    assert::ExpectEqual(partialInfo.genericParameters[1], "B", "partial nested parameter identity");
    assert::ExpectEqual(partialInfo.genericArguments.Count(), 2usize, "partial generic reflection argument count");
    assert::ExpectEqual(partialInfo.genericArguments[0], "i32", "partial concrete type argument");
    assert::ExpectEqual(partialInfo.genericArguments[1], "Wrapper<string>", "partial nested type argument");
    console::PrintLine("generic-text-const-parameters-ok");
    return 0;
}
