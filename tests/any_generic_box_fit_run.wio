use std::assert as assert;
use std::console as console;
use std::heap as heap;

fn Entry() -> i32 {
    let numberPayload: any = heap::box(42);
    let textPayload: any = heap::box("boxed");

    assert::ExpectTrue(numberPayload is std::Box<i32>, "any should accept direct generic box checks through the canonical std::Box alias");
    assert::ExpectTrue(textPayload is std::Box<string>, "any should accept direct generic box string checks through the canonical std::Box alias");

    if (numberPayload is std::Box<i32> fit numberBox) {
        numberBox.Set(55);
        assert::ExpectEqual(numberBox.Get(), 55, "generic box fit should recover mutable boxed values");
    } else {
        return 1;
    }

    if (textPayload is std::Box<string> fit textBox) {
        assert::ExpectEqual(textBox.Get(), "boxed", "generic box fit should recover boxed strings");
    } else {
        return 2;
    }

    console::PrintLine("any-generic-box-ok");
    return 0;
}
