fn Escape() -> any {
    return MakeSample();
}

fn Entry() -> i32 {
    mut blank: any;
    if (!IsNull(ref blank) or blank is i32) {
        return 12;
    }
    Replace(ref blank);
    if ((blank fit string) != "new\0value") {
