    let values: Dict<string, i32> = { "local": 11 };
    let dictionary: any = values;
    SetCopy(dictionary);
    let mapped = dictionary fit Dict<string, i32>;
    if (mapped["native"] != 23 or values.ContainsKey("native")) {
