fn Round() -> i32
{
    let scalar = Call<Triple>((values) => [values[0] + 2, values[1], 29], [7, 11, 13]);
    if (scalar[0] != 9 or scalar[2] != 29)
    {
        return 1;
    }
    let borrowed = Borrow<Triple>(Change, [7, 11, 13]);
    if (borrowed[0] != 9 or borrowed[1] != 23 or borrowed[2] != 29)
    {
        return 2;
    }
    let flags = Borrow<Flags>((readonly, writable) =>
    {
        writable = [!readonly[0], readonly[1]];
        return readonly;
    }, [false, true]);
    if (!flags[0] or !flags[1])
    {
        return 3;
    }
    mut addressable: Flags = [false, true];
    SetBool(ref addressable[0]);
    if (!addressable[0])
    {
        return 4;
    }
    let strings = Borrow<Strings>((readonly, writable) =>
    {
        writable = [readonly[0] + "!", "changed\0🌍"];
        return readonly;
    }, ["start", "old"]);
    if (strings[0] != "start!" or strings[1] != "changed\0🌍")
    {
        return 5;
    }
    let texts = Borrow<Texts>((readonly, writable) =>
    {
        writable = [u"new🌍", readonly[1]];
        return readonly;
    }, [u"old", u"你好"]);
    if (texts[0] != u"new🌍" or texts[1] != u"你好")
    {
        return 6;
    }
    let empty = Borrow<EmptyTexts>((readonly, writable) =>
    {
        writable = [];
        return readonly;
    }, []);
    if (empty.Count() != 0usize or Echo<Empty>([]).Count() != 0usize)
    {
        return 7;
    }
    let initialPoints: Points = [Point(7), Point(11)];
    let defaultsBefore = Defaults();
    let unchangedPoints = Call<Points>((values) => values, initialPoints);
    if (Defaults() != defaultsBefore or unchangedPoints[0].x != 7)
    {
        return 22;
    }
    let points = Borrow<Points>((readonly, writable) =>
    {
        writable = [Point(readonly[0].x + 2), Point(29)];
        return readonly;
    }, initialPoints);
    if (points[0].x != 9 or points[1].x != 29)
    {
        return 8;
    }
    let matrix = Borrow<Matrix>((readonly, writable) =>
    {
        writable = [[readonly[0][0] + 2, 23], [29, 31]];
        return readonly;
    }, [[7, 11], [13, 17]]);
    if (matrix[0][0] != 9 or matrix[1][1] != 31)
    {
        return 9;
    }
    let objects = Borrow<Items>((readonly, writable) =>
    {
        writable = [Item(readonly[0].Read() + 2), Item(29)];
        return readonly;
    }, [Item(7), Item(11)]);
    if (objects[0].Read() != 9 or objects[1].Read() != 29)
    {
        return 10;
    }
    let nullable: NullableItems = [Item(7), null];
    let optionals = Borrow<NullableItems>((readonly: view NullableItems, writable: ref NullableItems) =>
    {
        let current: Item? = readonly[0];
        if (current == null)
        {
            return readonly;
        }
        let present: NullableItems = [null, Item(current.Read() + 2)];
        writable = present;
        return readonly;
    }, nullable);
    let optional = optionals[1];
    if (optionals[0] != null)
    {
        return 11;
    }
    if (optional != null)
    {
        if (optional.Read() != 9)
        {
            return 11;
        }
    }
    else
    {
        return 11;
    }
    let interfaces: Interfaces = [Item(7) fit IRead, Item(11) fit IRead];
    let polymorphic = Call<Interfaces>((values) => [values[1], values[0]], interfaces);
    if (polymorphic[0].Read() != 11 or polymorphic[1].Read() != 7)
    {
        return 12;
    }
    let maps: Dict<string, Triple> = {"key": [7, 11, 13]};
    let mapped = Borrow<Dict<string, Triple>>((readonly, writable) =>
    {
        writable = {"key": [9, 23, 29]};
        return readonly;
    }, maps);
    if (mapped["key"][0] != 9)
    {
        return 13;
    }
    let outer: Triple[] = [[7, 11, 13], [17, 19, 23]];
    let vectors = Call<Triple[]>((values) => [values[1], values[0]], outer);
    if (vectors[0][0] != 17)
    {
        return 14;
    }
    let dynamic: DynamicPair = [[7], [11, 13]];
    let swapped = Call<DynamicPair>((values) => [values[1], values[0]], dynamic);
    if (swapped[0].Count() != 2usize or swapped[1][0] != 7)
    {
        return 15;
    }
    let boxed: any = scalar;
    let box = Borrow<any>((readonly, writable) =>
    {
        let values = (deref readonly) fit Triple;
        let replacement: Triple = [values[0] + 2, 23, 29];
        writable = replacement;
        return readonly;
    }, boxed);
    if ((box fit Triple)[0] != 11)
    {
        return 16;
    }
    let preserved = PodEcho(Bundle([7, 11, 13], [[1, 2], [3, 4]], [false, true], []));
    if (preserved.values[0] != 7 or preserved.matrix[1][1] != 4 or
        !preserved.flags[1] or preserved.empty.Count() != 0usize or Hidden(preserved) != 83)
