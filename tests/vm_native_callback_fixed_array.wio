    }
    mut standalone = Echo<Triple>(preserved.values);
    Modify<Triple>(ref standalone);
    if (standalone[0] != 9 or preserved.values[0] != 7)
    {
        return 18;
    }
    let stable: view i32 = ref standalone[0];
    if (!Alias(ref standalone[0], ref standalone) or deref stable != 11)
