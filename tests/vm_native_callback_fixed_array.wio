fn Entry() -> i32
{
    mut round = 0;
    while (round < 30)
    {
        let result = Round();
        if (result != 0)
        {
            return result;
        }
        if (!Balanced())
        {
            return 90;
        }
        round += 1;
    }
    Print();
    return 0;
}
