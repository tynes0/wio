use std::console as console;
use std::reflect as reflect;

enum Mode {
    Idle = 0,
    Play = 1,
    Pause = 2
};

flagset Permission {
    None = 0u32,
    Read = 1u32 << 0u32,
    Write = 1u32 << 1u32,
    All = Read | Write
};

const DefaultMode: Mode = Mode::Play;
const ReadOnly: Permission = Permission::Read;
const FullAccess: Permission = Permission::Read | Permission::Write;

fn Entry() -> i32 {
    if (DefaultMode != Mode::Play) {
        return 1;
    }

    if (ReadOnly != Permission::Read) {
        return 2;
    }

    if (FullAccess != Permission::All) {
        return 3;
    }

    if (reflect::Count<Mode>() != 3usize) {
        return 4;
    }

    if (reflect::Count<Permission>() != 4usize) {
        return 5;
    }

    if (reflect::Name(DefaultMode) != "Play") {
        return 6;
    }

    if (reflect::Name(ReadOnly) != "Read") {
        return 7;
    }

    if (reflect::Name(FullAccess) != "All") {
        return 8;
    }

    if (reflect::UnderlyingType<Mode>() != "i32") {
        return 9;
    }

    if (reflect::UnderlyingType<Permission>() != "u32") {
        return 10;
    }

    if (reflect::Size<Mode>() != 4usize) {
        return 11;
    }

    if (reflect::Size<Permission>() != 4usize) {
        return 12;
    }

    if (reflect::Value<Mode>(1usize) != Mode::Play) {
        return 13;
    }

    if (reflect::Value<Permission>(2usize) != Permission::Write) {
        return 14;
    }

    if (reflect::Index(DefaultMode) != 1isize) {
        return 15;
    }

    if (reflect::Index(FullAccess) != 3isize) {
        return 16;
    }

    console::PrintLine("enum-reflection-ok");
    return 0;
}
