use std::console as console;
use std::fs as fs;
use std::io as io;
use std::path as path;
use std::reflect as reflect;

fn Entry() -> i32 {
    let base = path::Join4("build", "wio_std", "io", "surface");
    let filePath = path::Join3(base, "data", "sample.bin");

    if (fs::EnsureParentDirectory(filePath).IsError()) {
        return 1;
    }

    let openWriter = io::OpenWriteBinaryFile(filePath);
    if (openWriter.IsError()) {
        return 2;
    }

    mut writer = openWriter.Value();
    let wroteTextResult = io::Write(ref writer, "AB");
    if (wroteTextResult.IsError()) {
        return 3;
    }

    let wroteText = wroteTextResult.Value() fit i32;
    let payload: u8[] = [1 fit u8, 2 fit u8, 3 fit u8];
    let wroteBytes = io::WriteBytes(ref writer, payload) fit i32;
    let wroteLineResult = io::WriteLine(ref writer, "CD");
    if (wroteLineResult.IsError()) {
        return 4;
    }

    let wroteLine = wroteLineResult.Value() fit i32;
    let closeWriter = io::Close(ref writer);
    if (closeWriter.IsError()) {
        return 5;
    }

    let openReader = io::OpenReadBinaryFile(filePath);
    if (openReader.IsError()) {
        return 6;
    }

    mut reader = openReader.Value();
    let headResult = io::Read(ref reader, 2usize);
    if (headResult.IsError()) {
        return 7;
    }

    let head = headResult.Value();
    let bytes = io::ReadBytes(ref reader, 3usize);
    let tailResult = io::ReadLine(ref reader, true);
    if (tailResult.IsError()) {
        return 8;
    }

    let tail = tailResult.Value();
    let sizeResult = io::Size(reader);
    if (sizeResult.IsError()) {
        return 9;
    }

    let size = sizeResult.Value() fit i32;
    let closeReader = io::Close(ref reader);
    if (closeReader.IsError()) {
        return 10;
    }

    if (head != "AB") {
        return 11;
    }

    if (bytes.Count() != 3usize or bytes[0usize] != (1 fit u8) or bytes[1usize] != (2 fit u8) or bytes[2usize] != (3 fit u8)) {
        return 12;
    }

    if (tail != "CD") {
        return 13;
    }

    console::Print(
        $"Std io surface: ${wroteText}/${wroteBytes}/${wroteLine}/${size}/${head}/${tail}/${reflect::Name(io::OpenRead)}/${io::FileErrorName(io::FileErrorNone)}"
    );
    return 0;
}
