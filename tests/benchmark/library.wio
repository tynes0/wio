use std::benchmark as bench;
use std::json as json;
use std::hash as hash;

fn Work(iterations: usize) -> u64
{
    mut sum = 0u64;
    for (index in 0usize..<iterations)
    {
        sum += index fit u64;
    }

    return sum;
}

fn AllocationWork() -> u64
{
    mut value = "";
    for (index in 0..<128)
    {
        value += "payload";
    }

    let snapshot = value;
    return hash::Fnv1a64(snapshot);
}

fn Entry() -> i32
{
    let summary = bench::Analyze([10.0, 20.0, 30.0, 40.0, 50.0]);
    if (summary.IsError()) return 1;
    let stats = summary.Value();
    if (stats.median != 30.0 or stats.mean != 30.0 or stats.p90 != 46.0) return 2;
    if (stats.medianAbsoluteDeviation != 10.0 or stats.stable) return 3;
    if (bench::Analyze([1.0, 2.0]).IsOk()) return 4;
    if (bench::Analyze([1.0, 0.0, 2.0]).IsOk()) return 5;
    if (bench::AnalyzeWithLimits([1.0, 1.0, 1.0], 0.0, 0.1).IsOk()) return 6;
    let stable = bench::Analyze([10.0, 10.0, 10.0, 10.0]);
    if (stable.IsError() or not stable.Value().stable) return 7;
    if (stable.Value().standardDeviation != 0.0) return 8;
    let report = bench::Run("sum", 1000usize, 1usize, 3usize, Work, 499500u64);
    if (report.IsError()) return 9;
    if (report.Value().Samples().Count() != 3usize or report.Value().Checksum() != 499500u64) return 10;
    if (bench::Run("bad", 1000usize, 0usize, 3usize, Work, 0u64).IsOk()) return 11;
    let memory = bench::Memory();
    if (memory.residentAvailable and memory.residentBytes == 0u64) return 12;
    if (bench::Environment().IsError()) return 13;
    if (bench::Percentile([4.0, 1.0, 3.0, 2.0], 0.5).Value() != 2.5) return 16;
    if (bench::Percentile([], 0.5).IsOk() or bench::Percentile([1.0], 2.0).IsOk()) return 17;
    if (bench::Calibrate(Work, 0i64, 10usize).IsOk()) return 18;
    if (bench::Calibrate(Work, 1i64, 10usize).IsError()) return 19;
    if (json::Write(json::NumberValue(0.0)) != "0.0") return 20;
    let original = 1.0000000000000002f64;
    let roundTrip = json::Parse(json::Write(json::NumberValue(original)));
    if (roundTrip.IsError() or roundTrip.Value().NumberOr(0.0) != original) return 21;
    if (bench::Input(42u64) != 42u64 or bench::Input(-42i64) != -42i64 or bench::Input(1.25f64) != 1.25f64) return 22;
    if (not bench::ReportJson(report.Value()).IsObject() or not bench::MemoryJson(memory).IsObject()) return 23;
    if (bench::AllocationAvailable())
    {
        if (bench::BeginAllocations().IsError()) return 14;
        let checksum = AllocationWork();
        let counters = bench::EndAllocations();
        if (checksum != 12315153952189776677u64 or not counters.available
            or counters.liveBlocks != 0u64 or counters.allocations == 0u64) return 15;
        if (not bench::AllocationJson(counters).IsObject()) return 24;
    }

    return 0;
}
