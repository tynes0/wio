use std::assert as assert;
use std::console as console;

system PulseSystem {
    mut ticks: i32 = 0;
    on update { self.ticks += 1; }
}

application CounterApp {
    mut count: i32 = 0;
    system pulse: PulseSystem;

    on start {
        console::Print("application-start ");
    }

    on update {
        self.count += 1;
        if (self.count == 3) { self.Exit(0); }
    }

    on close {
        assert::ExpectEqual(self.count, 3, "application update count");
        assert::ExpectEqual(self.pulse.ticks, 3, "owned system update count");
        console::PrintLine!("application-lifecycle-ok");
    }
}
