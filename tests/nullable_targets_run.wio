use std::assert as assert;
use std::console as console;

object Boxed {
    public value: i32;

    OnConstruct(value: i32) {
        self.value = value;
    }

    public fn Value() -> i32 {
        return self.value;
    }
}

fn Double(value: i32) -> i32 {
    return value * 2;
}

fn GuardedValue(value: Boxed?) -> i32 {
    if (value == null) {
        return -1;
    }
    return value.Value();
}

fn Entry() -> i32 {
    mut objectValue: Boxed? = null;
    let numberView: (view i32)? = null;
    let payload: any = null;
    let handle: opaque? = null;
    mut callback: (fn(i32) -> i32)? = null;

    assert::ExpectTrue(objectValue == null, "nullable object handles support null");
    assert::ExpectTrue(numberView == null, "nullable views support null");
    assert::ExpectTrue(payload == null, "any supports null");
    assert::ExpectTrue(handle == null, "nullable opaque handles support null");
    assert::ExpectTrue(callback == null, "nullable function values support null");

    objectValue = Boxed(7);
    assert::ExpectTrue(objectValue != null, "object handles can transition from null to an object");
    if (objectValue != null) {
        assert::ExpectEqual(objectValue.Value(), 7, "null checks narrow nullable object handles");
    }
    callback = Double;
    assert::ExpectTrue(callback != null and callback(9) == 18, "short-circuit conditions narrow nullable functions");
    assert::ExpectEqual(GuardedValue(objectValue), 7, "returning null guards narrow the following path");

    mut cursor: Boxed? = Boxed(3);
    mut total = 0;
    while (cursor != null) {
        total += cursor.Value();
        cursor = null;
    }
    assert::ExpectEqual(total, 3, "while null checks narrow the loop body");

    let values: Boxed?[] = [Boxed(11), null];
    assert::ExpectTrue(values[1] == null, "dynamic arrays can contain nullable handles");
    let first = values[0];
    if (first != null) {
        assert::ExpectEqual(first.Value(), 11, "nullable array elements narrow after extraction");
    }

    let groupedValues: (Boxed?)[] = [null, Boxed(13)];
    let second = groupedValues[1];
    if (second != null) {
        assert::ExpectEqual(second.Value(), 13, "grouped nullable types accept array suffixes");
    }

    let lookup: Dict<string, Boxed?> = {"missing": null, "found": Boxed(17)};
    assert::ExpectTrue(lookup.Get("missing").IsSome(), "dictionary option distinguishes a stored null from a missing key");
    assert::ExpectTrue(lookup.Get("missing").Value() == null, "dictionary options preserve nullable values");
    let found = lookup.Get("found").Value();
    if (found != null) {
        assert::ExpectEqual(found.Value(), 17, "generic containers preserve nullable arguments");
    }
    console::PrintLine("nullable-targets-ok");
    return 0;
}
