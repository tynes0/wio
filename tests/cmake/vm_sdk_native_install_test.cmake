cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${WIO_BUILD_DIR}" --config "${WIO_CONFIG}"
    --component WioVmRuntime --prefix "${root}/runtime SDK 🚀"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "VM install fixture runtime install failed: ${output}\n${error}")
endif()
set(prefix "${root}/runtime SDK 🚀")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}"
    "${WIO_EXECUTABLE}" "${WIO_ROOT}/tests/vm_sdk_native_dependencies_library.wio" --no-builtin
    --target shared --emit-bytecode --bytecode-output "${root}/native.wiob"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "VM install fixture bytecode failed: ${output}\n${error}")
endif()
set(generator_args -G "${WIO_GENERATOR}")
if(WIO_GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${WIO_GENERATOR_PLATFORM}")
endif()
set(configure_args -S "${WIO_ROOT}/tests/projects/vm_sdk_native_dependencies_host" -B "${root}/host"
    ${generator_args} "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_BUILD_TYPE=${WIO_CONFIG}"
    "-DWIO_TEST_BYTECODE=${root}/native.wiob" "-DWIO_TEST_FIXTURES=${WIO_ROOT}/tests/native"
    "-DWIO_TEST_HOST_SOURCE=${WIO_ROOT}/tests/vm_sdk_native_dependencies_host.cpp"
    -DWIO_TEST_INSTALL_WORKFLOW=ON)
foreach(policy IN ITEMS traversal absolute static_without_host shared_with_host not_vm archive_host duplicate_repair)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} "-DWIO_TEST_INSTALL_POLICY=${policy}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
    if("${result}" STREQUAL "0" OR NOT "${output}${error}" MATCHES
       "(VM install DESTINATION|Static VM installation|VM install HOST|requires a wio_add_vm_module|VM installation requires|VM DEPLOY_TARGET)")
        message(FATAL_ERROR "VM install policy ${policy} did not fail with its API diagnostic: ${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} -DWIO_TEST_INSTALL_POLICY=
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "VM install fixture configure failed: ${output}\n${error}")
endif()
set(build_args)
if(WIO_GENERATOR MATCHES "Visual Studio")
    set(build_args -- /m:1 /nodeReuse:false)
endif()
function(build_target target)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${root}/host" --config "${WIO_CONFIG}" --target "${target}" ${build_args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "VM install fixture ${target} build failed: ${output}\n${error}")
    endif()
endfunction()
build_target(native_host)
include("${root}/host/paths-${WIO_CONFIG}.cmake")

# Remove the build-tree bundles recoverably. Explicit deploy targets must run
# even when images are up to date, without changing image bytes/timestamps.
foreach(item IN ITEMS shared bad host)
    file(SHA256 "${test_${item}}" image_hash_${item})
    file(TIMESTAMP "${test_${item}}" image_time_${item} UTC)
endforeach()
foreach(item IN ITEMS shared static bad)
    file(READ "${test_${item}_manifest}" document)
    string(JSON bundle GET "${document}" bundle)
    set(bundle_${item} "${bundle}")
    get_filename_component(bundle_prefix "${bundle}" DIRECTORY)
    if(item STREQUAL "static")
        get_filename_component(parent "${test_host}" DIRECTORY)
    else()
        get_filename_component(parent "${test_${item}}" DIRECTORY)
    endif()
    # All paths originate from this unique test build; never rename a workspace
    # root, library source directory or an unvalidated manifest path.
    cmake_path(IS_PREFIX root "${parent}/${bundle_prefix}" NORMALIZE contained)
    if(NOT contained OR NOT bundle_prefix MATCHES "^native_(shared|static|bad)\\.vm-native$")
        message(FATAL_ERROR "Unsafe VM bundle repair fixture path")
    endif()
    file(RENAME "${parent}/${bundle_prefix}" "${parent}/${bundle_prefix}.offline")
    build_target(repair_native_${item})
    if(NOT EXISTS "${parent}/${bundle}/${test_producer_name}")
        message(FATAL_ERROR "Explicit VM deploy target did not repair an absent bundle")
    endif()
endforeach()
foreach(item IN ITEMS shared bad host)
    file(SHA256 "${test_${item}}" actual_hash)
    file(TIMESTAMP "${test_${item}}" actual_time UTC)
    if(NOT actual_hash STREQUAL image_hash_${item} OR NOT actual_time STREQUAL image_time_${item})
        message(FATAL_ERROR "Repair rebuilt or changed the up-to-date ${item} image")
    endif()
endforeach()

set(installed "${root}/installed app 🚀")
function(install_modules expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${root}/host" --config "${WIO_CONFIG}"
        --component VmFixture --prefix "${installed}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
    if((expected AND NOT "${result}" STREQUAL "0") OR (NOT expected AND "${result}" STREQUAL "0"))
        message(FATAL_ERROR "Unexpected VM module install outcome: ${output}\n${error}")
    endif()
    if(NOT expected AND NOT "${output}${error}" MATCHES "Refusing to overwrite a different VM native generation")
        message(FATAL_ERROR "Conflicting VM install did not fail on immutable native bytes: ${output}\n${error}")
    endif()
endfunction()
install_modules(TRUE)
if(WIN32)
    file(GLOB runtime_archives "${installed}/bin/*.lib")
    if(runtime_archives)
        message(FATAL_ERROR "Runtime component unexpectedly installed development/import archives")
    endif()
endif()
foreach(item IN ITEMS shared bad host)
    get_filename_component(name "${test_${item}}" NAME)
    set(installed_${item} "${installed}/bin/${name}")
    file(SHA256 "${installed_${item}}" actual_hash)
    if(NOT actual_hash STREQUAL image_hash_${item})
        # Unix install may adjust RPATH; this fixture's images have no private
        # link dependencies. Their native producers remain separate bundles.
        message(FATAL_ERROR "Installed ${item} image changed unexpectedly")
    endif()
endforeach()
foreach(item IN ITEMS shared static bad)
    set(installed_${item}_producer "${installed}/bin/${bundle_${item}}/${test_producer_name}")
    if(NOT EXISTS "${installed_${item}_producer}")
        message(FATAL_ERROR "Module install omitted its native producer")
    endif()
endforeach()
file(READ "${root}/host/install_manifest_VmFixture.txt" install_manifest)
foreach(item IN ITEMS shared static bad)
    string(FIND "${install_manifest}" "${installed_${item}_producer}" recorded)
    if(recorded EQUAL -1)
        message(FATAL_ERROR "CMake install manifest omitted a native dependency")
    endif()
endforeach()

# Installation is repeatable and can restore a missing file from its validated
# stage without touching original native output or recompiling the program.
file(RENAME "${installed_static_producer}" "${installed_static_producer}.offline")
install_modules(TRUE)
if(NOT EXISTS "${installed_static_producer}")
    message(FATAL_ERROR "Reinstall did not restore a missing native dependency")
endif()
set(private "${installed}/bin/${bundle_shared}/${test_runtime_name}")
file(RENAME "${private}" "${private}.original")
file(WRITE "${private}" "conflicting installed runtime")
install_modules(FALSE)
file(READ "${private}" retained)
file(SHA256 "${installed_shared}" current_image)
if(NOT retained STREQUAL "conflicting installed runtime" OR NOT current_image STREQUAL image_hash_shared)
    message(FATAL_ERROR "Failed install changed conflicting bytes or the current module image")
endif()
# Keep the conflicting fixture recoverable, then reinstall a complete bundle.
file(RENAME "${private}" "${private}.conflict")
install_modules(TRUE)

# Retain the old images, then rebuild a real private library. Updating a
# private dependency (not only the registry producer) must select new bundles
# and leave the previous images' complete dependency generations usable.
foreach(item IN ITEMS shared bad host)
    get_filename_component(name "${test_${item}}" NAME)
    configure_file("${installed_${item}}" "${installed}/bin/previous-${name}" COPYONLY)
    set(previous_name_${item} "previous-${name}")
endforeach()
foreach(item IN ITEMS shared static bad)
    file(SHA256 "${installed}/bin/${bundle_${item}}/${test_runtime_name}" previous_runtime_hash_${item})
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} -DWIO_TEST_INSTALL_POLICY= -DWIO_DEPLOY_BIAS=200
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Native update configure failed: ${output}\n${error}")
endif()
build_target(native_host)
include("${root}/host/paths-${WIO_CONFIG}.cmake")
foreach(item IN ITEMS shared static bad)
    file(READ "${test_${item}_manifest}" document)
    string(JSON updated_bundle_${item} GET "${document}" bundle)
    if(updated_bundle_${item} STREQUAL bundle_${item})
        message(FATAL_ERROR "Real native runtime change reused an old ${item} bundle")
    endif()
endforeach()
install_modules(TRUE)
foreach(item IN ITEMS shared static bad)
    file(SHA256 "${installed}/bin/${bundle_${item}}/${test_runtime_name}" retained_hash)
    if(NOT retained_hash STREQUAL previous_runtime_hash_${item})
        message(FATAL_ERROR "Installing an updated native runtime altered a previous generation")
    endif()
endforeach()

file(RENAME "${root}/host/original-producers" "${root}/host/producers.offline")
file(RENAME "${root}/native.wiob" "${root}/native.offline")
set(relocated "${root}/relocated app 🚀")
file(RENAME "${installed}" "${relocated}")
# Use installed basenames, not build-tree paths. The host changes CWD itself.
foreach(revision IN ITEMS previous updated)
    foreach(item IN ITEMS shared bad host)
        if(revision STREQUAL "previous")
            set(name "${previous_name_${item}}")
        else()
            get_filename_component(name "${test_${item}}" NAME)
        endif()
        set(deployed_${item} "${relocated}/bin/${name}")
    endforeach()
    foreach(item IN ITEMS shared static bad)
        if(revision STREQUAL "previous")
            set(current_bundle_${item} "${bundle_${item}}")
        else()
            set(current_bundle_${item} "${updated_bundle_${item}}")
        endif()
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=WIO_ROOT "${deployed_host}"
        "${deployed_shared}" "${relocated}/bin/${current_bundle_shared}/${test_producer_name}"
        "${relocated}/bin/${current_bundle_static}/${test_producer_name}"
        "${deployed_bad}" "${relocated}/bin/${current_bundle_bad}/${test_producer_name}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Installed/relocated ${revision} VM host failed: ${output}\n${error}")
    endif()
    message(STATUS "Installed ${revision} VM generation passed: ${output}")
endforeach()
message(STATUS "VM native install, repair, real rebuild and policy workflow passed")
