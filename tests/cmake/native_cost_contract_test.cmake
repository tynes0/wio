cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
foreach(source probe.h probe_test.cpp)
    configure_file("${WIO_ROOT}/tests/performance/native_costs/${source}" "${root}/${source}" COPYONLY)
endforeach()
set(fixture "${WIO_ROOT}/tests/performance/native_costs")
set(kinds concat builder format bytes array component object native_call result)
set(inputs costs.wio reference.cpp)
if(WIO_SUITE STREQUAL extended)
    string(APPEND fixture "/extended")
    set(kinds unicode dictionary result_error weak closure async_ready)
    list(APPEND inputs workloads.h)
    # Independently calculated modulo-2^64 fingerprints, not learned from C++.
    set(golden_unicode_1 17445855498045112857)
    set(golden_unicode_17 16810242653416937817)
    set(golden_dictionary_1 99)
    set(golden_dictionary_17 10007309852365595643)
    set(golden_result_error_1 145247952907163005)
    set(golden_result_error_17 2535633178212605909)
    foreach(kind weak closure async_ready)
        set(golden_${kind}_1 1)
        set(golden_${kind}_17 3335769950788531865)
    endforeach()
endif()
foreach(source IN LISTS inputs)
    configure_file("${fixture}/${source}" "${root}/${source}" COPYONLY)
endforeach()
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
        WORKING_DIRECTORY "${root}" TIMEOUT 240 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Cost probe command ${ARGN} failed (${result}): ${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
set(flags -std=c++20 -ffp-contract=off)
set(libraries "${WIO_RUNTIME}")
if(WIN32)
    list(APPEND flags -static -Wa,-mbig-obj)
    list(APPEND libraries -lws2_32 -lshell32)
else()
    list(APPEND libraries -pthread)
endif()
run("${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}" "${WIO_EXECUTABLE}"
    "${root}/costs.wio" --emit-cpp --include-dir "${root}")
set(configurations O0 O2)
if(WIO_SUITE STREQUAL extended)
    list(APPEND configurations O2-counter-free)
endif()
foreach(configuration IN LISTS configurations)
    set(optimization -O2)
    set(counter_flags "")
    if(configuration STREQUAL O0)
        set(optimization -O0)
    elseif(configuration STREQUAL O2-counter-free)
        set(counter_flags -DWIO_COST_NO_COUNTERS)
    endif()
    run("${WIO_BACKEND_CXX}" ${flags} ${optimization} ${counter_flags} "${root}/probe_test.cpp"
        -o "${root}/probe${WIO_EXECUTABLE_SUFFIX}")
    run("${root}/probe${WIO_EXECUTABLE_SUFFIX}")
    foreach(variant cpp wio)
        if(variant STREQUAL cpp)
            set(source reference.cpp)
            set(variant_libraries "")
            if(WIO_SUITE STREQUAL extended)
                set(variant_libraries ${libraries})
            endif()
        else()
            set(source costs.wio.cpp)
            set(variant_libraries ${libraries})
        endif()
        run("${WIO_BACKEND_CXX}" ${flags} ${optimization} ${counter_flags} "${root}/${source}" "-I${root}"
            "-I${WIO_ROOT}/runtime/include" "-I${WIO_ROOT}/sdk/include"
            ${variant_libraries} -o "${root}/${variant}${WIO_EXECUTABLE_SUFFIX}")
    endforeach()
    foreach(count 1 17)
        foreach(kind IN LISTS kinds)
            foreach(variant cpp wio)
                run("${root}/${variant}${WIO_EXECUTABLE_SUFFIX}" "${kind}" "${count}")
                if(NOT last_output MATCHES "seconds=[0-9.]+ checksum=([0-9]+) allocations=[0-9]+ requested_bytes=[0-9]+")
                    message(FATAL_ERROR "Malformed cost output: ${last_output}")
                endif()
                set(checksum "${CMAKE_MATCH_1}")
                if(configuration STREQUAL O2-counter-free AND NOT last_output MATCHES "allocations=0 requested_bytes=0")
                    message(FATAL_ERROR "Counter-free binary reported active allocation counters: ${last_output}")
                endif()
                if(WIO_SUITE STREQUAL extended)
                    set(golden "golden_${kind}_${count}")
                    if(NOT "${checksum}" STREQUAL "${${golden}}")
                        message(FATAL_ERROR "${kind}/${count}/${variant}: ${checksum}, independent golden ${${golden}}")
                    endif()
                endif()
                if(variant STREQUAL cpp)
                    set(expected "${checksum}")
                elseif(NOT "${checksum}" STREQUAL "${expected}")
                    message(FATAL_ERROR "${kind}/${count} checksum mismatch: ${last_output}, expected ${expected}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    foreach(variant cpp wio)
        list(GET kinds 0 valid_kind)
        foreach(arguments "invalid;17" "${valid_kind};0" "${valid_kind};12tail")
            execute_process(COMMAND "${root}/${variant}${WIO_EXECUTABLE_SUFFIX}" ${arguments}
                RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET WORKING_DIRECTORY "${root}" TIMEOUT 10)
            if("${invalid}" STREQUAL "0")
                message(FATAL_ERROR "Invalid diagnostic arguments succeeded: ${variant}/${arguments}")
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "Native cost counter and ${WIO_SUITE} fingerprints qualified in ${configurations}; no timing thresholds")
