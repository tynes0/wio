cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
foreach(source costs.wio reference.cpp probe.h probe_test.cpp)
    configure_file("${WIO_ROOT}/tests/performance/native_costs/${source}" "${root}/${source}" COPYONLY)
endforeach()
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
        WORKING_DIRECTORY "${root}" TIMEOUT 240 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Cost probe command ${ARGN} failed (${result}): ${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
set(flags -std=c++20 -ffp-contract=off)
set(libraries "${WIO_RUNTIME}")
if(WIN32)
    list(APPEND flags -static -Wa,-mbig-obj)
    list(APPEND libraries -lws2_32 -lshell32)
else()
    list(APPEND libraries -pthread)
endif()
run("${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}" "${WIO_EXECUTABLE}"
    "${root}/costs.wio" --emit-cpp --include-dir "${root}")
foreach(optimization -O0 -O2)
    run("${WIO_BACKEND_CXX}" ${flags} ${optimization} "${root}/probe_test.cpp"
        -o "${root}/probe${WIO_EXECUTABLE_SUFFIX}")
    run("${root}/probe${WIO_EXECUTABLE_SUFFIX}")
    foreach(variant cpp wio)
        if(variant STREQUAL cpp)
            set(source reference.cpp)
            set(variant_libraries "")
        else()
            set(source costs.wio.cpp)
            set(variant_libraries ${libraries})
        endif()
        run("${WIO_BACKEND_CXX}" ${flags} ${optimization} "${root}/${source}" "-I${root}"
            "-I${WIO_ROOT}/runtime/include" "-I${WIO_ROOT}/sdk/include"
            ${variant_libraries} -o "${root}/${variant}${WIO_EXECUTABLE_SUFFIX}")
    endforeach()
    foreach(count 1 17)
        foreach(kind concat builder format bytes array component object native_call result)
            foreach(variant cpp wio)
                run("${root}/${variant}${WIO_EXECUTABLE_SUFFIX}" "${kind}" "${count}")
                if(NOT last_output MATCHES "seconds=[0-9.]+ checksum=([0-9]+) allocations=[0-9]+ requested_bytes=[0-9]+")
                    message(FATAL_ERROR "Malformed cost output: ${last_output}")
                endif()
                if(variant STREQUAL cpp)
                    set(expected "${CMAKE_MATCH_1}")
                elseif(NOT "${CMAKE_MATCH_1}" STREQUAL "${expected}")
                    message(FATAL_ERROR "${kind}/${count} checksum mismatch: ${last_output}, expected ${expected}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    foreach(variant cpp wio)
        foreach(arguments "invalid;17" "array;0" "array;12tail")
            execute_process(COMMAND "${root}/${variant}${WIO_EXECUTABLE_SUFFIX}" ${arguments}
                RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET WORKING_DIRECTORY "${root}" TIMEOUT 10)
            if("${invalid}" STREQUAL "0")
                message(FATAL_ERROR "Invalid diagnostic arguments succeeded: ${variant}/${arguments}")
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "Native cost counter and nine checksum workloads qualified in O0/O2; no timing thresholds")
