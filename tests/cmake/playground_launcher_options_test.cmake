cmake_minimum_required(VERSION 3.20)
function(check expected pattern)
    execute_process(COMMAND "${WIO_LAUNCHER}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT "${result}" STREQUAL "${expected}" OR NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Launcher ${ARGN}: ${result}; ${output}\n${error}")
    endif()
endfunction()
check(0 "Wio playground launcher" --help)
check(0 "backend=native, profile=${WIO_CONFIG}" --dry-run)
check(0 "native-release" --cpp --release --dry-run)
check(0 "native-debug" --native --debug --dry-run)
check(0 "two words" --release --dry-run -- "two words" --vm)
check(2 "choose only one backend" --native --vm --dry-run)
check(2 "choose only one profile" --debug --release --dry-run)
check(2 "requires a value" --config)
check(2 "profile must be" --config Fast --dry-run)
check(2 "unknown launcher option" --bogus)
if(WIO_MULTI_CONFIG)
    check(0 "vm-release" --vm --release --dry-run)
    check(0 "vm-debug" --vm --debug --dry-run)
else()
    check(0 "backend=vm, profile=${WIO_CONFIG}" --vm --config "${WIO_CONFIG}" --dry-run)
    if(WIO_CONFIG STREQUAL "Release")
        check(2 "single-config" --vm --debug --dry-run)
    else()
        check(2 "single-config" --vm --release --dry-run)
    endif()
endif()
message(STATUS "Launcher defaults, selections, separator, help and invalid/conflicting options passed")
