cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}/sources" "${root}/output")
file(WRITE "${root}/sources/bridge.dll" "producer bytes")
file(WRITE "${root}/output/module.dll" "module bytes")
file(WRITE "${root}/output/host.exe" "host bytes")
set(stage "${root}/stage")
set(manifest "${root}/native.json")
set(metadata "${root}/artifacts.json")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DNATIVE_PRODUCERS=${root}/sources/bridge.dll"
    "-DNATIVE_STAGE=${stage}" "-DNATIVE_MANIFEST=${manifest}" "-DNATIVE_PREFIX=fixture.vm-native"
    -P "${WIO_ROOT}/cmake/StageWioVmNative.cmake" RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Project record fixture staging failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${manifest}" "-DSTAGE=${stage}"
    "-DDESTINATION=${root}/output" -P "${WIO_ROOT}/cmake/DeployWioVmNative.cmake" RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Project record fixture deployment failed")
endif()
function(check action expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DACTION=${action}" "-DMETADATA=${metadata}"
        -DEXPECTED_KIND=shared "-DEXPECTED_MODULE=${root}/output/module.dll"
        "-DEXPECTED_HOST=${root}/output/host.exe" "-DNATIVE_MANIFEST=${manifest}" "-DNATIVE_STAGE=${stage}"
        -P "${WIO_ROOT}/cmake/ManageWioVmProject.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if((expected AND NOT "${result}" STREQUAL "0") OR (NOT expected AND "${result}" STREQUAL "0"))
        message(FATAL_ERROR "Unexpected VM project record ${action} outcome: ${output}\n${error}")
    endif()
endfunction()
check(record TRUE)
check(verify TRUE)
file(READ "${metadata}" original)
file(WRITE "${root}/output/host.exe" "changed host")
check(verify FALSE)
file(WRITE "${root}/output/host.exe" "host bytes")
file(READ "${manifest}" native)
string(JSON bundle GET "${native}" bundle)
file(RENAME "${root}/output/${bundle}/bridge.dll" "${root}/output/${bundle}/bridge.offline")
check(verify FALSE)
check(record FALSE)
file(READ "${metadata}" retained)
if(NOT retained STREQUAL original)
    message(FATAL_ERROR "Failed project record publication overwrote the previous metadata")
endif()
file(RENAME "${root}/output/${bundle}/bridge.offline" "${root}/output/${bundle}/bridge.dll")
check(verify TRUE)
file(WRITE "${root}/output/${bundle}/bridge.dll" "wrong producer")
check(verify FALSE)
file(WRITE "${root}/output/${bundle}/bridge.dll" "producer bytes")
foreach(unsafe IN ITEMS "../outside.dll" "con.dll" "list;separator.dll")
    string(JSON changed SET "${original}" native files 0 name "\"${unsafe}\"")
    file(WRITE "${metadata}" "${changed}")
    check(verify FALSE)
endforeach()
string(JSON changed SET "${original}" native bundle "\"../outside\"")
file(WRITE "${metadata}" "${changed}")
check(verify FALSE)
string(JSON changed SET "${original}" kind "\"static\"")
file(WRITE "${metadata}" "${changed}")
check(verify FALSE)
file(WRITE "${metadata}" "${original}")
check(verify TRUE)
file(MAKE_DIRECTORY "${root}/outside")
file(CREATE_LINK "${root}/outside" "${root}/output/escaping.vm-native" SYMBOLIC RESULT link_result)
if("${link_result}" STREQUAL "0")
    string(JSON changed SET "${original}" native bundle "\"escaping.vm-native/0123456789abcdef\"")
    file(WRITE "${metadata}" "${changed}")
    check(verify FALSE)
    if(EXISTS "${root}/outside/0123456789abcdef")
        message(FATAL_ERROR "Record verification wrote through an escaping symlink")
    endif()
    file(WRITE "${metadata}" "${original}")
endif()
message(STATUS "VM project record hash/path/failed-publication policy passed")
