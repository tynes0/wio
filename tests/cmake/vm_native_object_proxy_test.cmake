foreach(required WIO_EXECUTABLE WIO_ROOT WIO_OUTPUT_DIR WIO_OBJECT_PROXY_EXECUTABLE WIO_SHARED_SUFFIX)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Object proxy qualification requires ${required}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${WIO_OUTPUT_DIR}")
set(source "${WIO_ROOT}/tests/vm_native_object_proxy.wio")
if(WIO_OBJECT_HIERARCHY)
    set(source "${WIO_ROOT}/tests/vm_native_object_hierarchy.wio")
endif()
if(WIO_OBJECT_POLYMORPHIC)
    set(source "${WIO_ROOT}/tests/vm_native_object_polymorphic.wio")
endif()
if(WIO_OBJECT_POLYMORPHIC_REFERENCES)
    set(source "${WIO_ROOT}/tests/vm_native_object_polymorphic_references.wio")
endif()
if(WIO_OBJECT_METHOD_VALUES)
    set(source "${WIO_ROOT}/tests/vm_native_object_method_values.wio")
endif()
if(WIO_OBJECT_METHOD_REFERENCES)
    set(source "${WIO_ROOT}/tests/vm_native_object_method_references.wio")
endif()
if(WIO_OBJECT_METHOD_NULLABLE)
    set(source "${WIO_ROOT}/tests/vm_native_object_method_nullable.wio")
endif()
if(WIO_OBJECT_METHOD_NULLABLE_REFERENCES)
    set(source "${WIO_ROOT}/tests/vm_native_object_method_nullable_references.wio")
endif()
if(WIO_OBJECT_METHOD_BORROWED_RESULTS)
    set(source "${WIO_ROOT}/tests/vm_native_object_method_borrowed_results.wio")
endif()
if(WIO_OBJECT_CONCRETE_GENERICS)
    set(source "${WIO_ROOT}/tests/vm_native_object_concrete_generics.wio")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}"
        "${WIO_EXECUTABLE}" file check "${WIO_ROOT}/tests/invalid/vm_native_object_generic_wrong_self.wio"
        RESULT_VARIABLE invalidResult OUTPUT_VARIABLE invalidOutput ERROR_VARIABLE invalidError TIMEOUT 30)
    string(REGEX MATCHALL "Return type mismatch" invalidDiagnostics "${invalidOutput}${invalidError}")
    list(LENGTH invalidDiagnostics invalidCount)
    if("${invalidResult}" STREQUAL "0" OR NOT invalidCount EQUAL 2)
        message(FATAL_ERROR "Generic self accepted a different type/const specialization:\n${invalidOutput}\n${invalidError}")
    endif()
endif()
set(native "${WIO_OUTPUT_DIR}/native${WIO_EXECUTABLE_SUFFIX}")
set(bridge "${WIO_OUTPUT_DIR}/bridge${WIO_SHARED_SUFFIX}")
set(bytecode "${WIO_OUTPUT_DIR}/program.wiob")
foreach(mode IN ITEMS native bridge)
    if(mode STREQUAL "native")
        set(options --target exe --output "${native}")
    else()
        set(options --target shared --output "${bridge}" --bytecode-sidecar "${bytecode}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}"
        "${WIO_EXECUTABLE}" "${source}" --cpp-backend wir
        --include-dir "${WIO_ROOT}/tests/native" ${options}
        WORKING_DIRECTORY "${WIO_ROOT}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${mode} object proxy compilation failed (${result}):\n${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${native}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Normal generated C++ object calls regressed (${result}): ${output}\n${error}")
endif()
if(WIO_AUTOMATIC_OBJECTS OR WIO_OBJECT_METHOD_VALUES OR WIO_OBJECT_METHOD_REFERENCES OR WIO_OBJECT_METHOD_NULLABLE
   OR WIO_OBJECT_METHOD_NULLABLE_REFERENCES OR WIO_OBJECT_METHOD_BORROWED_RESULTS OR WIO_OBJECT_CONCRETE_GENERICS
   OR WIO_OBJECT_HIERARCHY OR WIO_OBJECT_POLYMORPHIC OR WIO_OBJECT_POLYMORPHIC_REFERENCES)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}"
        "${WIO_EXECUTABLE}" --vm-run-bytecode "${bytecode}" --native-library "${bridge}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Automatic VM object materialization failed (${result}): ${output}\n${error}")
    endif()
    set(hostMode automatic)
    if(WIO_OBJECT_METHOD_VALUES)
        set(hostMode methods)
    endif()
    if(WIO_OBJECT_METHOD_REFERENCES)
        set(hostMode references)
    endif()
    if(WIO_OBJECT_METHOD_NULLABLE)
        set(hostMode nullable)
    endif()
    if(WIO_OBJECT_METHOD_NULLABLE_REFERENCES)
        set(hostMode nullable-references)
    endif()
    if(WIO_OBJECT_METHOD_BORROWED_RESULTS)
        set(hostMode borrowed-results)
    endif()
    if(WIO_OBJECT_CONCRETE_GENERICS)
        set(hostMode concrete-generics)
    endif()
    if(WIO_OBJECT_HIERARCHY)
        set(hostMode hierarchy)
    endif()
    if(WIO_OBJECT_POLYMORPHIC)
        set(hostMode polymorphic)
    endif()
    if(WIO_OBJECT_POLYMORPHIC_REFERENCES)
        set(hostMode polymorphic-references)
    endif()
    execute_process(COMMAND "${WIO_OBJECT_PROXY_EXECUTABLE}" "${bytecode}" "${bridge}" "${hostMode}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Automatic VM object host lifetime failed (${result}): ${output}\n${error}")
    endif()
endif()
if(WIO_OBJECT_METHOD_VALUES OR WIO_OBJECT_METHOD_REFERENCES OR WIO_OBJECT_METHOD_NULLABLE
   OR WIO_OBJECT_METHOD_NULLABLE_REFERENCES OR WIO_OBJECT_METHOD_BORROWED_RESULTS OR WIO_OBJECT_CONCRETE_GENERICS
   OR WIO_OBJECT_HIERARCHY OR WIO_OBJECT_POLYMORPHIC OR WIO_OBJECT_POLYMORPHIC_REFERENCES)
    message(STATUS "Generated C++/VM object method qualification passed")
    return()
endif()
execute_process(COMMAND "${WIO_OBJECT_PROXY_EXECUTABLE}" "${bytecode}" "${bridge}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Generated DLL/VM object proxy qualification failed: ${output}\n${error}")
endif()
message(STATUS "Generated C++ executable and DLL/VM object proxy qualification passed")
