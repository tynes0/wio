cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}/sources" "${root}/destination")
file(WRITE "${root}/sources/producer.dll" "producer-one")
file(WRITE "${root}/sources/private.dll" "private-one")
set(stage "${root}/stage")
set(manifest "${root}/manifest.json")
set(stage_script "${WIO_ROOT}/cmake/StageWioVmNative.cmake")
set(deploy_script "${WIO_ROOT}/cmake/DeployWioVmNative.cmake")
function(deploy expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${manifest}" "-DSTAGE=${stage}"
        "-DDESTINATION=${root}/destination" -P "${deploy_script}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if((expected AND NOT "${result}" STREQUAL "0") OR (NOT expected AND "${result}" STREQUAL "0"))
        message(FATAL_ERROR "Unexpected native deployment outcome: ${output}\n${error}")
    endif()
endfunction()
function(make_stage)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DNATIVE_PRODUCERS=${root}/sources/producer.dll"
        "-DRUNTIME_LIBRARIES=${root}/sources/private.dll" "-DNATIVE_STAGE=${stage}"
        "-DNATIVE_MANIFEST=${manifest}" "-DNATIVE_PREFIX=fixture.vm-native" -P "${stage_script}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Native fixture staging failed: ${output}\n${error}")
    endif()
endfunction()
make_stage()
file(READ "${manifest}" original)
string(JSON bundle GET "${original}" bundle)
get_filename_component(digest "${bundle}" NAME)
deploy(TRUE)
deploy(TRUE)
file(WRITE "${root}/destination/${bundle}/producer.dll" "existing altered bytes")
deploy(FALSE)
file(READ "${root}/destination/${bundle}/producer.dll" bytes)
if(NOT bytes STREQUAL "existing altered bytes")
    message(FATAL_ERROR "Native deployment overwrote an existing mismatched generation")
endif()
file(WRITE "${manifest}" "{\"version\":1,\"bundle\":\"../outside\",\"files\":[]}")
deploy(FALSE)
file(WRITE "${manifest}" "${original}")
file(WRITE "${stage}/${digest}/private.dll" "tampered stage")
deploy(FALSE)
if(EXISTS "${root}/outside")
    message(FATAL_ERROR "Native bundle traversal mutated an outside directory")
endif()
file(WRITE "${root}/sources/producer.dll" "producer-two")
make_stage()
file(READ "${manifest}" changed)
string(JSON new_bundle GET "${changed}" bundle)
if(new_bundle STREQUAL bundle)
    message(FATAL_ERROR "Native content changes did not produce a new bundle generation")
endif()
deploy(TRUE)
file(READ "${root}/destination/${bundle}/producer.dll" retained)
if(NOT retained STREQUAL "existing altered bytes")
    message(FATAL_ERROR "Publishing a new bundle modified the older native generation")
endif()
foreach(unsafe IN ITEMS "../producer.dll" "con.dll" "trailing.dll." "wio-native-manifest.json" "list;separator.dll")
    string(JSON corrupt SET "${changed}" files 0 name "\"${unsafe}\"")
    file(WRITE "${manifest}" "${corrupt}")
    deploy(FALSE)
endforeach()
file(WRITE "${manifest}" "${changed}")
file(MAKE_DIRECTORY "${root}/outside")
file(CREATE_LINK "${root}/outside" "${root}/destination/escape.vm-native" SYMBOLIC RESULT link_result)
if("${link_result}" STREQUAL "0")
    get_filename_component(new_digest "${new_bundle}" NAME)
    string(JSON escaped SET "${changed}" bundle "\"escape.vm-native/${new_digest}\"")
    file(WRITE "${manifest}" "${escaped}")
    deploy(FALSE)
    if(EXISTS "${root}/outside/${new_digest}")
        message(FATAL_ERROR "Native deployment created files through an escaping symlink parent")
    endif()
    file(WRITE "${manifest}" "${changed}")
else()
    message(STATUS "Native bundle symlink case unavailable: ${link_result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DNATIVE_PRODUCERS=${root}/sources/producer.dll;${root}/sources/producer.dll" "-DNATIVE_STAGE=${stage}"
    "-DNATIVE_MANIFEST=${manifest}" "-DNATIVE_PREFIX=collision.vm-native" -P "${stage_script}"
    RESULT_VARIABLE collision OUTPUT_VARIABLE output ERROR_VARIABLE error)
if("${collision}" STREQUAL "0" OR NOT "${output}${error}" MATCHES "colliding filenames")
    message(FATAL_ERROR "Duplicate native basenames were not rejected before deployment")
endif()
message(STATUS "VM native bundle hash/collision/traversal policy passed")
