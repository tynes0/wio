string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
set(project "${root}/Project Türkçe 🌍")
file(MAKE_DIRECTORY "${project}" "${project}/run cwd" "${project}/registries")
file(COPY "${WIO_ROOT}/tests/projects/vm_artifact_cli/wio" "${WIO_ROOT}/tests/projects/vm_artifact_cli/native"
    DESTINATION "${project}")
configure_file("${WIO_ROOT}/tests/projects/vm_artifact_cli/wio.makewio.in" "${project}/wio.makewio" @ONLY)
set(extra "${project}/registries/extra registry${WIO_SHARED_SUFFIX}")
configure_file("${WIO_EXTRA_REGISTRY}" "${extra}" COPYONLY)
set(build "${root}/build outputs")
set(app "${project}/deployment/VM app${WIO_EXECUTABLE_SUFFIX}")

function(cli expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}" "${WIO_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${project}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 240 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI ${ARGN} failed (${result}, expected ${expected}): ${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

function(run_app executable answer)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=WIO_ROOT "${executable}"
        manifest-arg "two words" "Türkçe 🌍" --help
        WORKING_DIRECTORY "${project}/run cwd" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "vm-project-artifact:${answer}")
        message(FATAL_ERROR "Standalone application failed (${result}): ${output}\n${error}")
    endif()
endfunction()

cli(0 project describe --build-dir "${build}")
string(JSON described_app GET "${output}" vm executable)
string(JSON described_runner GET "${output}" vm runner)
if(NOT described_app STREQUAL app OR NOT EXISTS "${described_runner}")
    message(FATAL_ERROR "Manifest did not describe its VM executable/runner: ${output}")
endif()
cli(0 project build --backend vm --build-dir "${build}")
if(NOT EXISTS "${app}")
    message(FATAL_ERROR "VM project build did not publish an executable: ${output}\n${error}")
endif()
file(GLOB first_bridge "${project}/deployment/vm_artifact_cli.vm-native.wio-*${WIO_SHARED_SUFFIX}")
list(LENGTH first_bridge bridge_count)
if(NOT bridge_count EQUAL 1)
    message(FATAL_ERROR "Expected one first-generation bridge: ${first_bridge}")
endif()
file(SHA256 "${first_bridge}" first_bridge_hash)
file(SHA256 "${app}" first_image)
cli(0 project run --backend vm --build-dir "${build}" --print-command --arg "two words" -- "Türkçe 🌍" --help)
if(NOT output MATCHES "up to date" OR NOT output MATCHES "vm-project-artifact:42" OR output MATCHES "--vm-run-bytecode")
    message(FATAL_ERROR "Project run did not reuse its standalone executable: ${output}\n${error}")
endif()
file(SHA256 "${app}" after_reuse)
if(NOT first_image STREQUAL after_reuse)
    message(FATAL_ERROR "Incremental reuse changed its image")
endif()
cli(0 project run --backend vm --build-dir "${build}" --no-build --no-manifest-args --cwd "run cwd"
    --arg manifest-arg --arg "two words" -- "Türkçe 🌍" --help)
cli(0 project run --backend vm --build-dir "${build}" --no-build
    --arg "two words" --arg "Türkçe 🌍" --arg --help)
if(NOT output MATCHES "vm-project-artifact:42")
    message(FATAL_ERROR "--arg --help was incorrectly consumed as CLI help: ${output}\n${error}")
endif()
run_app("${app}" 42)

# No-build refuses missing deployed dependencies; normal run repairs from its
# still-current build intermediates without changing the original image bytes.
file(RENAME "${first_bridge}" "${root}/first-bridge.offline")
cli(1 project run --backend vm --build-dir "${build}" --no-build --arg "two words" -- "Türkçe 🌍" --help)
cli(0 project run --backend vm --build-dir "${build}" --arg "two words" -- "Türkçe 🌍" --help)
if(NOT output MATCHES "needs repair" OR NOT output MATCHES "vm-project-artifact:42")
    message(FATAL_ERROR "Missing deployed library was not repaired: ${output}\n${error}")
endif()

# An unrelated file cannot masquerade as an up-to-date VM image or be replaced.
configure_file("${app}" "${root}/good-image" COPYONLY)
file(WRITE "${app}" "ordinary unrelated file")
file(SHA256 "${app}" foreign_before)
cli(1 project run --backend vm --build-dir "${build}" --arg "two words" -- "Türkçe 🌍" --help)
file(SHA256 "${app}" foreign_after)
if(NOT foreign_before STREQUAL foreign_after OR NOT "${output}${error}" MATCHES "non-VM")
    message(FATAL_ERROR "Foreign executable protection failed: ${output}\n${error}")
endif()
configure_file("${root}/good-image" "${app}" COPYONLY)

# A successful native rebuild gets a new immutable library name; old copies survive.
file(READ "${project}/native/fixture.h" header)
string(REPLACE "Revision = 0" "Revision = 1" header "${header}")
file(WRITE "${project}/native/fixture.h" "${header}")
cli(0 project build --backend vm --build-dir "${build}" --rebuild)
run_app("${app}" 43)
file(SHA256 "${first_bridge}" old_bridge_after_rebuild)
if(NOT first_bridge_hash STREQUAL old_bridge_after_rebuild)
    message(FATAL_ERROR "Native rebuild overwrote a library belonging to the old generation")
endif()
file(GLOB bridge_generations "${project}/deployment/vm_artifact_cli.vm-native.wio-*${WIO_SHARED_SUFFIX}")
list(LENGTH bridge_generations count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Changed native bytes did not create a second generation: ${bridge_generations}")
endif()

# An external registry update repackages without recompiling the Wio producer.
file(SHA256 "${build}/interop/vm_artifact_cli.vm-native${WIO_SHARED_SUFFIX}" producer_before)
file(APPEND "${extra}" "wio-test-overlay")
cli(0 project build --backend vm --build-dir "${build}")
file(SHA256 "${build}/interop/vm_artifact_cli.vm-native${WIO_SHARED_SUFFIX}" producer_after)
if(NOT output MATCHES "up to date" OR NOT producer_before STREQUAL producer_after)
    message(FATAL_ERROR "External registry update unnecessarily rebuilt the producer: ${output}")
endif()
run_app("${app}" 43)

# A compiler failure must leave the previously deployed bundle runnable.
file(SHA256 "${app}" good_image)
file(READ "${project}/wio.makewio" manifest)
string(REPLACE "includeDirs = [\"native\"]" "includeDirs = [\"native\"]\nbackendArgs = [\"-WioTestForcedFailure\"]" bad "${manifest}")
file(WRITE "${project}/wio.makewio" "${bad}")
cli(1 project build --backend vm --build-dir "${build}" --rebuild)
file(WRITE "${project}/wio.makewio" "${manifest}")
file(SHA256 "${app}" after_failure)
if(NOT good_image STREQUAL after_failure)
    message(FATAL_ERROR "Failed compiler invocation replaced the deployed image")
endif()
run_app("${app}" 43)

# Build-only intermediate artifacts and source files are unnecessary to no-build run/package.
file(RENAME "${build}/interop/vm_artifact_cli.wiob" "${build}/interop/bytecode.offline")
file(RENAME "${build}/interop/vm_artifact_cli.vm-native${WIO_SHARED_SUFFIX}" "${build}/interop/bridge.offline")
file(RENAME "${project}/wio/main.wio" "${project}/wio/main.offline")
cli(0 project run --backend vm --build-dir "${build}" --no-build --arg "two words" -- "Türkçe 🌍" --help)
cli(0 project package --backend vm --build-dir "${build}" --no-build --output-dir "${root}/packages")
file(GLOB metadata "${root}/packages/*/wio-package.json")
list(LENGTH metadata metadata_count)
if(NOT metadata_count EQUAL 1)
    message(FATAL_ERROR "Missing VM project package metadata: ${metadata}")
endif()
get_filename_component(package "${metadata}" DIRECTORY)
file(READ "${metadata}" metadata_json)
string(JSON backend GET "${metadata_json}" backend)
string(JSON entrypoint GET "${metadata_json}" entrypoint)
if(NOT backend STREQUAL "vm")
    message(FATAL_ERROR "Package metadata lost its backend")
endif()
run_app("${package}/${entrypoint}" 43)

# Package --clean validates its source before deleting an existing distribution.
file(GLOB active_extra "${project}/deployment/extra registry.wio-*${WIO_SHARED_SUFFIX}")
list(GET active_extra -1 absent_dependency)
file(RENAME "${absent_dependency}" "${root}/absent-registry")
# Discover which generation is active by verification rather than guessing the
# lexical hash order; move every extra generation out for this negative probe.
foreach(dependency IN LISTS active_extra)
    if(EXISTS "${dependency}")
        file(RENAME "${dependency}" "${dependency}.offline")
    endif()
endforeach()
file(SHA256 "${package}/${entrypoint}" package_before)
cli(1 project package --backend vm --build-dir "${build}" --no-build --output-dir "${root}/packages" --clean)
file(SHA256 "${package}/${entrypoint}" package_after)
if(NOT package_before STREQUAL package_after)
    message(FATAL_ERROR "Invalid input destroyed an existing VM package")
endif()
file(RENAME "${root}/absent-registry" "${absent_dependency}")
foreach(dependency IN LISTS active_extra)
    if(EXISTS "${dependency}.offline")
        file(RENAME "${dependency}.offline" "${dependency}")
    endif()
endforeach()
file(GLOB packaged_libraries "${package}/bin/*${WIO_SHARED_SUFFIX}")
list(LENGTH packaged_libraries library_count)
if(NOT library_count EQUAL 2)
    message(FATAL_ERROR "Package copied obsolete generations or omitted an active library: ${packaged_libraries}")
endif()
cli(1 project package --backend vm --build-dir "${build}" --no-build --output-dir "${root}/packages")
cli(0 project package --backend vm --build-dir "${build}" --no-build --output-dir "${root}/packages" --clean)
run_app("${package}/${entrypoint}" 43)

# Avoid native/source output collisions even before compiler invocation.
file(RENAME "${project}/wio/main.offline" "${project}/wio/main.wio")
string(REPLACE "executableOutput = \"deployment/VM app${WIO_EXECUTABLE_SUFFIX}\""
    "executableOutput = \"wio/main.wio\"" collision "${manifest}")
file(WRITE "${project}/wio.makewio" "${collision}")
cli(1 project build --backend vm --build-dir "${build}")
if(NOT "${output}${error}" MATCHES "collides")
    message(FATAL_ERROR "Source collision was not diagnosed before building: ${output}\n${error}")
endif()
file(WRITE "${project}/wio.makewio" "${manifest}")
string(REPLACE "name = \"VM Artifact CLI\"" "name = \"native\"" unsafe_manifest "${manifest}")
file(WRITE "${project}/wio.makewio" "${unsafe_manifest}")
file(SHA256 "${project}/native/fixture.h" source_before)
cli(1 project package --backend vm --build-dir "${build}" --no-build --output-dir "${project}" --clean)
file(SHA256 "${project}/native/fixture.h" source_after)
if(NOT source_before STREQUAL source_after OR NOT "${output}${error}" MATCHES "Refusing to package over")
    message(FATAL_ERROR "Unsafe package cleanup did not protect native inputs: ${output}\n${error}")
endif()
file(WRITE "${project}/wio.makewio" "${manifest}")
cli(1 project package --backend invalid --build-dir "${build}" --no-build)
message(STATUS "VM project generation, incremental run, failure preservation and standalone packaging passed")
