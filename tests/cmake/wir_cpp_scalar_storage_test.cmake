cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
configure_file("${WIO_ROOT}/tests/wir_cpp_scalar_storage_run.wio" "${root}/main.wio" COPYONLY)
configure_file("${WIO_ROOT}/tests/native/scalar_codegen_driver.cpp" "${root}/driver.cpp" COPYONLY)
function(run expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
        WORKING_DIRECTORY "${root}" TIMEOUT 180 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Scalar codegen ${ARGN} returned ${result}, expected ${expected}: ${output}\n${error}")
    endif()
endfunction()
run(0 "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}" "${WIO_EXECUTABLE}"
    "${root}/main.wio" --no-builtin --include-dir "${WIO_ROOT}/tests/native" --emit-cpp --output "${root}/main")
run(0 "${WIO_PLAN_TEST}" "${root}/phi.cpp")
set(flags -std=c++20)
set(libraries "${WIO_RUNTIME}")
if(WIN32)
    list(APPEND flags -static -Wa,-mbig-obj)
    list(APPEND libraries -lws2_32 -lshell32)
else()
    list(APPEND libraries -pthread)
endif()
foreach(optimization IN ITEMS -O0 -O2)
    set(app "${root}/scalar${optimization}${WIO_EXECUTABLE_SUFFIX}")
    run(0 "${WIO_BACKEND_CXX}" ${flags} "${optimization}" "${root}/driver.cpp"
        "-I${WIO_ROOT}/tests/native" "-I${WIO_ROOT}/runtime/include" "-I${WIO_ROOT}/sdk/include"
        ${libraries} -o "${app}")
    run(0 "${app}")
    run(0 "${WIO_BACKEND_CXX}" ${flags} "${optimization}" "${root}/phi.cpp"
        "-I${WIO_ROOT}/runtime/include" "-I${WIO_ROOT}/sdk/include" ${libraries} -o "${root}/phi${WIO_EXECUTABLE_SUFFIX}")
    run(21 "${root}/phi${WIO_EXECUTABLE_SUFFIX}")
endforeach()
message(STATUS "Zero-allocation scalar loops, early exits, closure/native borrow fallback passed at O0/O2")
