cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${WIO_OUTPUT_DIR}/${suffix}/Build Türkçe 🚀")
file(MAKE_DIRECTORY "${root}/cwd Türkçe 🚀")
file(WRITE "${root}/program.wio" "fn Entry() -> i32\n{\n    return 37;\n}\n")
file(WRITE "${root}/library.wio" "[export]\nfn Answer() -> i32\n{\n    return 37;\n}\n")
file(WRITE "${root}/broken.cpp" "#error deliberate qualification failure\n")
function(run expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${root}/cwd Türkçe 🚀"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180 ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unicode backend command ${ARGN} returned ${result}, expected ${expected}: ${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()
set(compiler "${CMAKE_COMMAND}" -E env "WIO_ROOT=${WIO_ROOT}" "${WIO_EXECUTABLE}")
set(executable "${root}/çıktı 🚀${WIO_EXECUTABLE_SUFFIX}")
run(0 ${compiler} "${root}/program.wio" --no-builtin --output "${executable}")
run(37 "${executable}")
file(SHA256 "${executable}" original_executable)
run(1 ${compiler} "${root}/program.wio" --no-builtin --output "${executable}"
    --backend-arg "${root}/broken.cpp")
file(SHA256 "${executable}" after_failure)
if(NOT original_executable STREQUAL after_failure)
    message(FATAL_ERROR "Failed executable rebuild changed the previous image")
endif()
set(archive "${root}/kitaplık 🚀.a")
run(0 ${compiler} "${root}/library.wio" --no-builtin --target static --output "${archive}")
file(SHA256 "${archive}" original_archive)
run(1 ${compiler} "${root}/library.wio" --no-builtin --target static --output "${archive}"
    --backend-arg "${root}/broken.cpp")
file(SHA256 "${archive}" after_failure)
if(NOT original_archive STREQUAL after_failure)
    message(FATAL_ERROR "Failed archive rebuild changed the previous archive")
endif()
set(bridge "${root}/köprü 🚀${WIO_SHARED_SUFFIX}")
run(0 ${compiler} "${root}/program.wio" --no-builtin --target shared --native-bridge-only
    --output "${bridge}" --bytecode-sidecar "${root}/program.wiob")
run(0 "${WIO_VM_RUNNER}" --package "${root}/program.wiob" --output "${root}/paket 🚀${WIO_EXECUTABLE_SUFFIX}"
    --native-library "${bridge}")
run(37 "${root}/paket 🚀${WIO_EXECUTABLE_SUFFIX}")
file(GLOB leaked "${root}/cwd Türkçe 🚀/.wio-backend-*" "${root}/.wio-backend-*")
if(leaked)
    message(FATAL_ERROR "Native backend leaked owned workspace files: ${leaked}")
endif()
message(STATUS "Unicode native exe/shared/archive outputs, publication rollback and workspace cleanup passed")
