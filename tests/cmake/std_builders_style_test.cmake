cmake_minimum_required(VERSION 3.20)
foreach(name IN ITEMS builders binary)
    set(path "${WIO_ROOT}/std/${name}.wio")
    file(READ "${path}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    if(source MATCHES "@[A-Za-z]" OR source MATCHES "with[ \t]+native" OR
       source MATCHES "std::(Option|Some|None)" OR source MATCHES "fn[ \t]+Try[A-Z]")
        message(FATAL_ERROR "Legacy attachment/failure API in ${path}")
    endif()
    if(source MATCHES "fn[^\n]*\\{[^\n]*\\}" OR source MATCHES "(if|for|while|match)\\(")
        message(FATAL_ERROR "Compact body or control-flow spacing in ${path}")
    endif()
    if(source MATCHES "\\};?\n[^\n]" OR source MATCHES "\\};?\n\n\n")
        message(FATAL_ERROR "Closing block requires exactly one blank line in ${path}")
    endif()
    string(FIND "${source}" "\t" tab)
    if(NOT tab EQUAL -1)
        message(FATAL_ERROR "Literal tab in ${path}")
    endif()
    file(STRINGS "${path}" lines)
    foreach(line IN LISTS lines)
        string(LENGTH "${line}" length)
        if(length GREATER 120)
            message(FATAL_ERROR "Builder cleanup slice exceeds proposed 120-column width: ${line}")
        endif()
    endforeach()
endforeach()
message(STATUS "Builder/binary scoped source-style and Result-first guard passed")
