fn Forward(values: ref any[]) -> ref any
{
    return Array(values, ref values[0usize], values[0usize]);
}

fn Probe() -> i32
{
    let seed: any = 7;
    mut values: any[] = [seed];
    return (deref Array(ref values, ref values[0usize], seed)) fit i32;
}

fn AliasProbe() -> i32
{
    let seed: any = 7;
    mut values: any[] = [seed];
    return (deref Repeat(ref values, ref values[0usize], ref values[0usize])) fit i32;
}

fn LifetimeProbe(action: i32) -> i32
{
    let seed: any = 7;
    mut values: any[] = [seed, seed];
    let held: ref any = Forward(ref values);
    if (action == 0)
    {
        values.Push(seed);
    }
    if (action == 1)
    {
        values = [seed];
    }
    if (action == 2)
    {
        return (deref Shrink(ref values, held)) fit i32;
    }
    if (action == 3)
    {
        return (deref Grow(ref values, held)) fit i32;
    }
    if (action == 4)
    {
        return (deref Foreign(ref values, held)) fit i32;
    }
    if (action == 5)
    {
        return (deref Fail(ref values, held)) fit i32;
    }
    return (deref held) fit i32;
}

fn RemovedProbe() -> i32
{
    let seed: any = 7;
    mut values: Dict<string, any> = {"kept": seed, "other": seed};
    return (deref Erase(ref values, ref values["kept"])) fit i32;
