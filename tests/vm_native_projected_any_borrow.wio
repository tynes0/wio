[Native, CppName(vm_projected_any_borrow::Sample)]
component Sample
{
    public value: i32;
}

object Item
{
    value: i32;
    public OnConstruct(value: i32)
    {
        self.value = value;
        Constructed();
    }
    OnDestruct()
    {
        Destroyed();
    }
    public fn Read() -> i32
    {
        return self.value;
    }
}

object FailingItem
{
    public OnConstruct()
    {
        Constructed();
    }
    OnDestruct()
    {
        Destroyed();
        CleanupFailure();
    }
}

