fn ClearedProbe() -> i32
{
    let seed: any = 7;
    mut values: Dict<string, any> = {"kept": seed};
    let held: ref any = Dictionary(ref values, ref values["kept"], seed);
    values.Clear();
    return (deref held) fit i32;
}

fn CleanupProbe() -> i32
{
    mut values: Dict<string, any> = {"kept": FailingItem()};
    let next: any = 11;
    let held: ref any = Dictionary(ref values, ref values["kept"], next);
    return (deref held) fit i32;
}

