use std::assert as assert;
use std::console as console;

[Default(public)]
object Counter {
    value: i32;

    OnConstruct(value: i32) {
        self.value = value;
    }

    fn Exercise() -> i32 {
        let prefix = ++self.value;
        let postfix = self.value++;
        let decrementedPrefix = --self.value;
        let decrementedPostfix = self.value--;

        assert::ExpectEqual(prefix, 2, "prefix increment returns the updated value");
        assert::ExpectEqual(postfix, 2, "postfix increment returns the previous value");
        assert::ExpectEqual(decrementedPrefix, 2, "prefix decrement returns the updated value");
        assert::ExpectEqual(decrementedPostfix, 2, "postfix decrement returns the previous value");
        return ReadFinalValue();
    }

    fn ReadFinalValue() -> i32 {
        return self.value;
    }
}

fn Entry() -> i32 {
    mut counter = Counter(1);
    assert::ExpectEqual(counter.Exercise(), 1, "increment/decrement must persist exactly one mutation");
    console::PrintLine("increment-decrement-ok");
    return 0;
}
