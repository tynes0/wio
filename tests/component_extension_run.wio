use std::assert as assert;
use std::console as console;

component Counter {
    public value: i32;
}

extension CounterOps for Counter {
    public view fn Read() -> i32 {
        return self.value;
    }

    public ref fn Add(amount: i32) -> i32 {
        self.value += amount;
        return self.value;
    }
}

fn Entry() -> i32 {
    mut counter = Counter(7);
    assert::ExpectEqual(counter.Read(), 7, "view extension should read the receiver");
    assert::ExpectEqual(counter.Add(5), 12, "ref extension should mutate the receiver");
    assert::ExpectEqual(counter.value, 12, "extension mutation should affect the original component");
    console::Print("Component extension: ok");
    return 0;
}
