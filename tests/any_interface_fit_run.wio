use std::assert as assert;
use std::console as console;

realm combat {
    interface IDamageable {
        fn TakeDamage(amount: i32);
        fn GetHp() -> i32;
    }

    @From(combat::IDamageable)
    object Boss {
        public hp: i32;

        OnConstruct() {
            self.hp = 12;
        }

        public fn TakeDamage(amount: i32) {
            self.hp -= amount;
        }

        public fn GetHp() -> i32 {
            return self.hp;
        }
    }
}

fn Entry() -> i32 {
    let payload: any = combat::Boss();

    assert::ExpectTrue(payload is combat::IDamageable, "any should recognize interface views over boxed object payloads");

    if (payload is combat::IDamageable fit damageable) {
        damageable.TakeDamage(5);
        assert::ExpectEqual(damageable.GetHp(), 7, "any fit should recover interface payloads");
    } else {
        return 1;
    }

    let boss: combat::Boss = payload fit combat::Boss;
    assert::ExpectEqual(boss.hp, 7, "interface dispatch through any should mutate the underlying object payload");

    let damageable: combat::IDamageable = payload fit combat::IDamageable;
    damageable.TakeDamage(2);
    assert::ExpectEqual(boss.hp, 5, "direct interface fit from any should stay connected to the same object payload");

    console::PrintLine("any-interface-ok");
    return 0;
}
