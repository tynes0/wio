using cpp::header("vm_object_polymorphic_fixture.h");
use std::attribute as attribute;

interface IRead { fn Read() -> i32; }
interface IWrite { fn Set(value: i32); }

[From(IRead)]
object Base {
    seed: i32 = 5;
    public OnConstruct() { self.seed += 2; Constructed(0); }
    OnDestruct() { Destroyed(0); }
    public fn Read() -> i32 { return self.seed; }
    public fn BaseSeed() -> i32 { return self.seed; }
}

[From(Base), From(IRead), From(IWrite)]
object Derived {
    value: i32;
    public OnConstruct() { self.value = 37; Constructed(1); }
    OnDestruct() { Destroyed(1); }
    public fn Read() -> i32 { return self.value; }
    public fn Set(value: i32) { self.value = value; }
}

[From(Derived)]
object Leaf {
    public OnConstruct() { Constructed(2); }
    OnDestruct() { Destroyed(2); }
    public fn Read() -> i32 { return super.Read() + 100; }
}

[From(IRead)]
object Sibling {
    public OnConstruct() { Constructed(3); }
    OnDestruct() { Destroyed(3); }
    public fn Read() -> i32 { return 19; }
}

[Native, CppName(vm_object_polymorphic::Constructed)] fn Constructed(kind: i32);
[Native, CppName(vm_object_polymorphic::Destroyed)] fn Destroyed(kind: i32);
[Native, CppName(vm_object_polymorphic::Constructions)] fn Constructions(kind: i32) -> i32;
[Native, CppName(vm_object_polymorphic::Destructions)] fn Destructions(kind: i32) -> i32;
[Native, CppName(vm_object_polymorphic::EchoBase)] fn EchoBase(value: Base) -> Base;
[Native, CppName(vm_object_polymorphic::EchoReader)] fn EchoReader(value: IRead) -> IRead;
[Native, CppName(vm_object_polymorphic::EchoNullableBase)] fn EchoNullableBase(value: Base?) -> Base?;
[Native, CppName(vm_object_polymorphic::EchoNullableReader)] fn EchoNullableReader(value: IRead?) -> IRead?;
[Native, CppName(vm_object_polymorphic::ReadBase)] fn ReadBase(value: Base) -> i32;
[Native, CppName(vm_object_polymorphic::ReadReader)] fn ReadReader(value: IRead) -> i32;
[Native, CppName(vm_object_polymorphic::Write)] fn Write(value: IWrite, next: i32);
[Native, CppName(vm_object_polymorphic::HoldBase)] fn HoldBase(value: Base);
[Native, CppName(vm_object_polymorphic::HoldReader)] fn HoldReader(value: IRead);
[Native, CppName(vm_object_polymorphic::ReadHeldBase)] fn ReadHeldBase() -> i32;
[Native, CppName(vm_object_polymorphic::ReadHeldReader)] fn ReadHeldReader() -> i32;
[Native, CppName(vm_object_polymorphic::ClearBase)] fn ClearBase();
[Native, CppName(vm_object_polymorphic::ClearReader)] fn ClearReader();
[Native, CppName(vm_object_polymorphic::Same), Instantiate(Base, IRead)]
fn Same<A, B>(left: A, right: B) -> bool;
[Native, CppName(vm_object_polymorphic::ToBase), Instantiate(IRead, Base)]
fn ToBase<R, B>(value: R) -> B;

fn MakeLeaf() -> Leaf { return Leaf(); }
fn MakeSibling() -> Sibling { return Sibling(); }
fn Roundtrip(value: Base) -> Base { return EchoBase(value); }

fn Entry() -> i32 {
    mut round = 0;
    while (round < 30) {
        {
            let leaf = Leaf();
            let base = EchoBase(leaf fit Base);
            let reader = EchoReader(leaf fit IRead);
            let recovered = ToBase<IRead, Base>(reader);
            if (not (base is Leaf) or not (reader is Leaf) or not (recovered is Leaf)) { return 1; }
            if (not Same<Base, IRead>(base, reader)) { return 2; }
            if (ReadBase(base) != 137 or ReadReader(reader) != 137) { return 3; }
            Write(leaf fit IWrite, 23);
            if (base.Read() != 123 or reader.Read() != 123 or recovered.Read() != 123) { return 4; }
            if ((recovered fit Leaf).BaseSeed() != 7) { return 5; }
            let nullableBase: Base? = leaf fit Base;
            let nullableReader: IRead? = leaf fit IRead;
            let echoedBase = EchoNullableBase(nullableBase);
            let echoedReader = EchoNullableReader(nullableReader);
            if (echoedBase == null) { return 6; }
            if (echoedReader == null) { return 6; }
            if (echoedBase != base or echoedBase.Read() != 123 or echoedReader.Read() != 123) { return 6; }
            let sibling = Sibling();
            let siblingReader = EchoReader(sibling fit IRead);
            if (not (siblingReader is Sibling) or ReadReader(siblingReader) != 19) { return 7; }
            HoldBase(base);
            HoldReader(reader);
        }
        if (Destructions(2) != round or ReadHeldBase() != 123 or ReadHeldReader() != 123) { return 10; }
        ClearBase();
        if (Destructions(2) != round or ReadHeldReader() != 123) { return 11; }
        ClearReader();
        if (Destructions(2) != round + 1) { return 12; }
        if (EchoNullableBase(null) != null or EchoNullableReader(null) != null) { return 8; }
        round += 1;
    }
    if (Constructions(0) != 30 or Destructions(0) != 30 or
        Constructions(1) != 30 or Destructions(1) != 30 or
        Constructions(2) != 30 or Destructions(2) != 30 or
        Constructions(3) != 30 or Destructions(3) != 30) { return 9; }
    return 0;
}
