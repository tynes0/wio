using cpp::header("vm_object_reference_fixture.h");
use std::attribute as attribute;

object Counter {
    value: i32;
    public OnConstruct(seed: i32) {
        self.value = seed;
        Constructed();
    }
    OnDestruct() {
        Destroyed();
    }
    public fn Read() -> i32 {
        return self.value;
    }
    public fn Same() -> Counter {
        return deref self;
    }
    public fn ReadFrom(source: view Counter) -> i32 {
        return source.Read();
    }
    public fn ReadPair(left: view Counter, right: view Counter) -> i32 {
        return left.Read() + right.Read();
    }
    public fn MakeTarget(target: ref Counter, seed: i32) {
        target = Counter(seed);
    }
    public fn AssignAndReturn(target: ref Counter, source: Counter) -> Counter {
        target = source;
        return deref target;
    }
    public fn MakePair(left: ref Counter, right: ref Counter, seed: i32) {
        left = Counter(seed);
        right = Counter(seed + 1);
    }
    public fn Alias(target: ref Counter, observed: view Counter, source: Counter) -> i32 {
        target = source;
        return observed.Read();
    }
    public fn Twice(left: ref Counter, right: ref Counter, source: Counter) -> i32 {
        left = source;
        return right.Read();
    }
    public fn FailReplace(target: ref Counter, source: Counter, divisor: i32) -> i32 {
        target = source;
        return self.value / divisor;
    }
}

[Native, CppName(vm_object_references::Constructed)]
fn Constructed();
[Native, CppName(vm_object_references::Destroyed)]
fn Destroyed();
[Native, CppName(vm_object_references::Constructions)]
fn Constructions() -> i32;
[Native, CppName(vm_object_references::Destructions)]
fn Destructions() -> i32;
[Native, CppName(vm_object_references::Exercise)]
fn Exercise(owner: Counter) -> i32;
[Native, CppName(vm_object_references::PanicReplace)]
fn PanicReplace(owner: Counter, target: ref Counter) -> bool;
[Native, CppName(vm_object_references::ReadonlyReplace)]
fn ReadonlyReplace(owner: Counter, target: ref Counter) -> bool;
[Native, CppName(vm_object_references::Capture)]
fn Capture(value: Counter) -> u64;
[Native, CppName(vm_object_references::ClearCapture)]
fn ClearCapture();

fn CaptureEntry() -> u64 {
    let value = Counter(37);
    return Capture(value);
}

fn SafePoint() -> i32 {
    return 0;
}

fn Entry() -> i32 {
    {
        let owner = Counter(17);
        if (Exercise(owner) != 0) {
            return 1;
        }
    }
    if (Constructions() != 61 or Destructions() != 61) {
        return 2;
    }
    return 0;
}

// VM-only: C++ integer division by zero is not a catchable Wio VM panic.
fn PanicEntry() -> i32 {
    {
        let owner = Counter(23);
        mut target = Counter(99);
        if (not ReadonlyReplace(owner, ref target) or target.Read() != 99) {
            return 1;
        }
        if (not PanicReplace(owner, ref target) or target != owner) {
            return 2;
        }
    }
    if (Constructions() != Destructions()) {
        return 3;
    }
    return 0;
}
