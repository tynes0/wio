use std::attribute as attribute;

[Native, CppName(NativeBuffer)]
component Buffer<T, const N: usize> {
    public value: T;
}

[Specialize(T, 4)]
component Buffer<T> {
    public values: [T; 4];
    public bonus: i32;
}

fn Entry() -> i32 {
    let invalid = Buffer<string, 4>(["a", "b", "c", "d"], 1);
    return 0;
}
