component Box<T> {
    value: T;
}

component Choice<A, B> {
    value: i32;
}

@Specialize(T, Box<i32>)
component Choice<T> {
    value: i32;
}

@Specialize(i32, Box<U>)
component Choice<U> {
    value: i32;
}

fn Entry() -> i32 {
    let value = Choice<i32, Box<i32>>(1);
    return value.value;
}
