        Clear();
        if (Borrow<Point>(PointCell, Point(7)).x != 7) { return 20; }
        if (Borrow<Item>(ItemCell, Item(7)).Read() != 7) { return 21; }
        let nothing: Item? = null;
        if (Borrow<Item?>(NullableCell, nothing) != null) { return 22; }
        let some: Item? = Item(7);
        let returned = Borrow<Item?>(NullableCell, some);
        if (returned != null) { if (returned.Read() != 7) { return 23; } }
        else { return 24; }
