        if (LocalBorrow() != 18) { return 34; }
        if (RejectMutatedFactory(MutatingFactory) != 0) { return 35; }
        if (Counter(CounterFactory) != 18) { return 36; }
    }
    if (not Balanced()) { return 31; }
    Print();
    return 0;
}
