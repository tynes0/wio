fn BorrowFactory() -> Unary
{
    mut value = 7;
    let borrowed = ref value;
    return (argument: i32) => deref borrowed + argument;
}
fn NestedBorrowFactory() -> Unary
{
    let inner = BorrowFactory();
    return (argument: i32) => inner(argument);
}
fn LocalBorrow() -> i32
{
    mut value = 7;
    let borrowed = ref value;
    let callback: Unary = (argument: i32) => deref borrowed + argument;
    return callback(11);
}
fn MutatingFactory() -> Unary
{
    mut inner: Unary = (value: i32) => value + 7;
    return (argument: i32) => {
        if (argument == 0)
        {
            mut value = 7;
            let borrowed = ref value;
            inner = (value: i32) => deref borrowed + value;
            return 0;
        }
        return inner(argument);
    };
}
fn CounterFactory() -> Unary
{
    mut count = 7;
    return (argument: i32) => { count += argument; return count; };
