        let map = Borrow<Dict<string, i32>>(MapCell, {"key": 7});
        if (map["key"] != 7) { return 17; }
        let box: any = 19;
        if ((Borrow<any>(AnyCell, box) fit i32) != 19) { return 18; }
        Remember((value: i32) => value + 7);
