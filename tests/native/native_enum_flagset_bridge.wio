use std::assert as assert;
use std::console as console;
use std::reflect as reflect;

realm ffi {
    use @CppHeader("native_enum_flagset_bridge.h");

    @Native
    @Type(u8)
    @CppName(native_enum_flagset::state)
    enum State {
        idle = 0u8,
        playing = 1u8,
        paused = 2u8
    };

    @Native
    @Type(u32)
    @CppName(native_enum_flagset::feature)
    flagset Feature {
        none = 0u32,
        audio = 1u32 << 0u32,
        debug = 1u32 << 1u32,
        all = audio | debug
    };

    @Native
    @CppName(native_enum_flagset::Advance)
    fn Advance(value: State) -> State;

    @Native
    @CppName(native_enum_flagset::UnknownState)
    fn UnknownState() -> State;

    @Native
    @CppName(native_enum_flagset::HasFeature)
    fn HasFeature(value: Feature, mask: Feature) -> bool;
}

fn Entry() -> i32 {
    if (ffi::Advance(ffi::State::idle) != ffi::State::playing) {
        return 1;
    }

    if (not ffi::HasFeature(ffi::Feature::all, ffi::Feature::debug)) {
        return 2;
    }

    let unknown = ffi::UnknownState();
    assert::ExpectEqual(unknown.Value(), 99u8, "native unknown raw value");
    assert::Expect(not unknown.IsValid(), "native unknown value validity");
    assert::Expect(not reflect::IsValid(unknown), "generic native unknown validity");
    assert::ExpectEqual(unknown.Name(), "<unknown>", "native unknown name");
    assert::Expect(reflect::TryFromValue<ffi::State>(99u8).IsNone(), "unknown native TryFromValue");

    console::PrintLine("native-enum-flagset-ok");
    return 0;
}
