use std::console as console;

system HostedCounter {
    mut ticks: i32;

    on start {
        self.ticks = 0;
    }

    on update {
        self.ticks += 1;
    }

    on close {
        console::PrintLine("hosted-system-close");
    }
}

application HostedApplication {
    system counter: HostedCounter;

    on update {
        if (self.counter.ticks == 3) {
            self.Exit(17);
        }
    }

    on close {
        console::PrintLine("hosted-application-close");
    }
}
