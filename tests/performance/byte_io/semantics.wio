use std::console as console;
use std::io as io;

using cpp::header("probe.h");

[native, cpp::name(byte_io::Setup)]
fn Setup();

fn Entry(args: string[]) -> i32
{
    Setup();
    let modeFlags = io::OpenMode::read | io::OpenMode::share_read |
        io::OpenMode::sequential | io::OpenMode::binary;
    mut file = io::OpenRaw("payload.bin", modeFlags);
    if (args.Count() > 1usize)
    {
        if (args[1usize] == "partial")
        {
            io::ReadBytes(ref file, 65537usize);
            return 20;
        }

        if (args[1usize] == "reuse-partial")
        {
            mut destination: u8[] = [];
            destination.Reserve(65537usize);
            for (index in 0usize..<65537usize)
            {
                destination.Push(0u8);
            }
            io::ReadBytesInto(ref file, ref destination);
            return 22;
        }

        io::CloseRaw(ref file);
        if (args[1usize] == "reuse-closed")
        {
            mut destination: u8[] = [0u8];
            io::ReadSomeBytesInto(ref file, ref destination);
            return 23;
        }

        io::ReadSomeBytes(ref file, 1usize);
        return 21;
    }

    let first = io::ReadBytes(ref file, 256usize);
    if (first.Count() != 256usize) return 1;
    for (index in 0usize..<256usize)
    {
        let expected = ((index * 17usize + 3usize) & 255usize) fit u8;
        if (first[index] != expected) return 2;
    }

    io::Seek(ref file, 0i64);
    let second = io::ReadSomeBytes(ref file, 17usize);
    if (second.Count() != 17usize or first.Count() != 256usize) return 3;
    if (second[0usize] != 3u8 or first[255usize] != 242u8) return 4;
    io::Seek(ref file, 65530i64);
    let tail = io::ReadSomeBytes(ref file, 65536usize);
    if (tail.Count() != 6usize) return 5;
    if (io::ReadSomeBytes(ref file, 65536usize).Count() != 0usize) return 6;

    mut destination: u8[] = [];
    destination.Reserve(256usize);
    for (index in 0usize..<256usize)
    {
        destination.Push(0u8);
    }
    let capacity = destination.Capacity();
    io::Seek(ref file, 0i64);
    if (io::ReadBytesInto(ref file, ref destination) != 256usize) return 9;
    if (destination.Count() != 256usize or destination.Capacity() != capacity) return 10;
    for (index in 0usize..<256usize)
    {
        if (destination[index] != first[index]) return 11;
    }

    let snapshot = destination.Clone();
    destination[6usize] = 99u8;
    io::Seek(ref file, 65530i64);
    if (io::ReadSomeBytesInto(ref file, ref destination) != 6usize) return 12;
    if (destination.Count() != 256usize or destination[6usize] != 99u8) return 13;
    if (destination[0usize] != 157u8 or destination[5usize] != 242u8) return 14;
    if (snapshot[0usize] != 3u8 or snapshot[6usize] != 105u8) return 15;
    if (io::ReadSomeBytesInto(ref file, ref destination) != 0usize) return 16;
    if (destination[6usize] != 99u8) return 17;

    io::CloseRaw(ref file);
    mut empty: u8[] = [];
    empty.Reserve(1024usize);
    if (io::ReadBytesInto(ref file, ref empty) != 0usize) return 18;
    if (io::ReadSomeBytesInto(ref file, ref empty) != 0usize or empty.Count() != 0usize) return 19;
    if (io::ReadBytes(ref file, 0usize).Count() != 0usize) return 7;
    if (io::ReadSomeBytes(ref file, 0usize).Count() != 0usize) return 8;
    console::PrintLine("byte-io-ok");
    return 0;
}
