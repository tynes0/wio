// Values are materialized left-to-right before a later side-effecting operand.
// Native and VM must agree, without fusing the mutating RHS into local append.
fn Change(value: ref string) -> string
{
    value = "changed";
    return "tail";
}

fn Entry() -> i32
{
    mut value = "original";
    value = value + Change(ref value);
    if (value != "originaltail") return 1;
    return 0;
}
