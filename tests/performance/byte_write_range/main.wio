use std::benchmark as bench;
use std::console as console;
use std::convert as convert;
use std::io as io;
use std::json as json;

using cpp::header("probe.h");

[native, cpp::name(byte_write_range::Setup)]
fn Setup();

[native, cpp::name(byte_write_range::CheckOutput)]
fn CheckOutput() -> u64;

fn Work(file: ref io::File, buffer: view u8[], mode: i64, count: i64) -> u64
{
    mut written = 0u64;
    for (index in 0i64..<count)
    {
        io::Seek(file, 0i64);
        if (mode == 0)
        {
            written += io::WriteBytes(file, buffer.Slice(7usize, 65519usize)) fit u64;
        }
        else
        {
            written += io::WriteBytesRange(file, buffer, 7usize, 65519usize) fit u64;
        }
    }

    return written;
}

fn Entry(args: string[]) -> i32
{
    if (args.Count() < 3usize or args.Count() > 4usize) return 1;
    let modeResult = convert::ParseI64(args[1usize]);
    let countResult = convert::ParseI64(args[2usize]);
    if (modeResult.IsError() or countResult.IsError()) return 1;
    let mode = modeResult.Value();
    let count = countResult.Value();
    if (mode < 0 or mode > 1 or count < 1 or count > 100000) return 1;
    Setup();
    mut input = io::OpenRaw("payload.bin", io::OpenMode::read | io::OpenMode::binary);
    let buffer = io::ReadBytes(ref input, 65536usize);
    io::CloseRaw(ref input);
    mut output = io::OpenRaw("output.bin", io::OpenMode::write | io::OpenMode::create |
        io::OpenMode::truncate | io::OpenMode::binary);
    bench::Consume(Work(ref output, ref buffer, mode, bench::Input(count)));
    bench::Consume(Work(ref output, ref buffer, mode, bench::Input(count)));
    if (args.Count() == 4usize)
    {
        if (bench::BeginAllocations().IsError()) return 2;
        let written = Work(ref output, ref buffer, mode, bench::Input(count));
        let counters = bench::EndAllocations();
        io::CloseRaw(ref output);
        console::PrintLine(bench::Protocol(1i64, count fit u64, written ^ CheckOutput()));
        console::PrintLine(json::Write(bench::AllocationJson(counters)));
        if (counters.liveBlocks != 0u64 or counters.liveBytes != 0u64) return 3;
        return 0;
    }

    let start = bench::Now();
    let written = Work(ref output, ref buffer, mode, bench::Input(count));
    bench::Consume(written);
    let elapsed = bench::Now() - start;
    io::CloseRaw(ref output);
    console::PrintLine(bench::Protocol(elapsed, count fit u64, written ^ CheckOutput()));
    return 0;
}
