realm labels {
    const Product: string = "Wio" + " Module";
    const Greeting: text = u$"Selam ${u"🌍"}";

    component Named<const Label: string> {
        value: i32;
    }

    fn StringValue<const Value: string>() -> string {
        return Value;
    }

    fn TextValue<const Value: text>() -> text {
        return Value;
    }
}
