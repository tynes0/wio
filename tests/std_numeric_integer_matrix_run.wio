use std::assert as assert;
use std::console as console;
use std::numeric as numeric;

fn Entry() -> i32 {
    assert::ExpectEqual(numeric::CheckedAdd(120 fit i8, 7 fit i8).Value(), 127 fit i8, "i8 checked add");
    assert::Expect(numeric::CheckedAdd(127 fit i8, 1 fit i8).IsNone(), "i8 add overflow");
    assert::Expect(numeric::CheckedSub(-128 fit i8, 1 fit i8).IsNone(), "i8 sub overflow");
    assert::Expect(numeric::CheckedMul(64 fit i8, 2 fit i8).IsNone(), "i8 mul overflow");
    assert::ExpectEqual(numeric::SaturatingAdd(127 fit i8, 1 fit i8), 127 fit i8, "i8 saturating add");
    assert::ExpectEqual(numeric::SaturatingSub(-128 fit i8, 1 fit i8), -128 fit i8, "i8 saturating sub");
    let i8Max = 127 fit i8;
    let i8Min = -128 fit i8;
    assert::ExpectEqual(i8Max + (1 fit i8), i8Min, "ordinary i8 addition wraps");
    mut compound = i8Max;
    compound += 1 fit i8;
    assert::ExpectEqual(compound, i8Min, "compound i8 addition wraps");

    assert::ExpectEqual(numeric::CheckedAdd(32760 fit i16, 7 fit i16).Value(), 32767 fit i16, "i16 checked add");
    assert::Expect(numeric::CheckedAdd(32767 fit i16, 1 fit i16).IsNone(), "i16 add overflow");
    assert::Expect(numeric::CheckedSub(-32768 fit i16, 1 fit i16).IsNone(), "i16 sub overflow");
    assert::Expect(numeric::CheckedMul(16384 fit i16, 2 fit i16).IsNone(), "i16 mul overflow");
    assert::ExpectEqual(numeric::SaturatingMul(16384 fit i16, 2 fit i16), 32767 fit i16, "i16 saturating mul");

    assert::ExpectEqual(numeric::CheckedAdd(2147483640, 7).Value(), 2147483647, "i32 checked add");
    assert::Expect(numeric::CheckedAdd(2147483647, 1).IsNone(), "i32 add overflow");
    assert::Expect(numeric::CheckedSub(-2147483648, 1).IsNone(), "i32 sub overflow");
    assert::Expect(numeric::CheckedMul(1073741824, 2).IsNone(), "i32 mul overflow");
    assert::ExpectEqual(numeric::SaturatingMul(-1073741824, 3), (-2147483648i64) fit i32, "i32 saturating negative mul");

    assert::Expect(numeric::CheckedAdd(9223372036854775807i64, 1i64).IsNone(), "i64 add overflow");
    assert::Expect(numeric::CheckedSub(-9223372036854775808i64, 1i64).IsNone(), "i64 sub overflow");
    assert::Expect(numeric::CheckedMul(-9223372036854775808i64, -1i64).IsNone(), "i64 mul overflow");
    assert::ExpectEqual(numeric::SaturatingMul(-9223372036854775808i64, -1i64), 9223372036854775807i64, "i64 saturating mul");
    let i64Min = -9223372036854775808i64;
    assert::ExpectEqual(i64Min / -1i64, i64Min, "ordinary signed division overflow wraps");
    assert::ExpectEqual(i64Min % -1i64, 0i64, "ordinary signed remainder overflow");
    assert::ExpectEqual(-i64Min, i64Min, "ordinary unary negation wraps");

    let isizeMax = 9223372036854775807i64 fit isize;
    assert::Expect(numeric::CheckedAdd(isizeMax, 1 fit isize).IsNone(), "isize add overflow");
    assert::ExpectEqual(numeric::SaturatingAdd(isizeMax, 1 fit isize), isizeMax, "isize saturating add");

    assert::Expect(numeric::CheckedAdd(255u8, 1u8).IsNone(), "u8 add overflow");
    assert::Expect(numeric::CheckedSub(0u8, 1u8).IsNone(), "u8 sub overflow");
    assert::Expect(numeric::CheckedMul(128u8, 2u8).IsNone(), "u8 mul overflow");
    assert::ExpectEqual(numeric::SaturatingSub(0u8, 1u8), 0u8, "u8 saturating sub");
    assert::ExpectEqual(255u8 + 1u8, 0u8, "ordinary u8 addition wraps");

    let u16Max = 65535u32 fit u16;
    assert::Expect(numeric::CheckedAdd(u16Max, 1 fit u16).IsNone(), "u16 add overflow");
    assert::ExpectEqual(numeric::SaturatingMul(u16Max, 2 fit u16), u16Max, "u16 saturating mul");

    assert::Expect(numeric::CheckedAdd(4294967295u32, 1u32).IsNone(), "u32 add overflow");
    assert::Expect(numeric::CheckedSub(0u32, 1u32).IsNone(), "u32 sub overflow");
    assert::ExpectEqual(numeric::SaturatingAdd(4294967295u32, 1u32), 4294967295u32, "u32 saturating add");

    assert::Expect(numeric::CheckedAdd(18446744073709551615u64, 1u64).IsNone(), "u64 add overflow");
    assert::Expect(numeric::CheckedMul(18446744073709551615u64, 2u64).IsNone(), "u64 mul overflow");
    assert::ExpectEqual(numeric::SaturatingSub(0u64, 1u64), 0u64, "u64 saturating sub");

    let usizeMax = 18446744073709551615u64 fit usize;
    assert::Expect(numeric::CheckedAdd(usizeMax, 1usize).IsNone(), "usize add overflow");
    assert::ExpectEqual(numeric::SaturatingMul(usizeMax, 2usize), usizeMax, "usize saturating mul");

    console::PrintLine!("std-numeric-integer-matrix-ok");
    return 0;
}
