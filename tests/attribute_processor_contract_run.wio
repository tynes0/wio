use std::attribute as attr;
use std::console as console;

[From(attr::PreProcessor)]
object AliveGuardProcessor {
    public fn Before() {}
}

[attribute::Targets(fn)]
[attribute::Processor(AliveGuardProcessor)]
attribute AliveGuard();

[AliveGuard]
fn ProtectedWork() -> i32 {
    return 42;
}

fn Entry() -> i32 {
    console::PrintLine("attribute-processor-contract-ok");
    return ProtectedWork() == 42 ? 0 : 1;
}
