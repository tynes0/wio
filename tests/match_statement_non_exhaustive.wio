use std::console as console;

fn Entry() -> i32 {
    mut score = 0;

    match (2) {
        1: score += 100;
        2: score += 10;
    }

    match (3) {
        1: score += 1000;
        2: score += 10000;
    }

    match (1) {
        1:;
    }

    match (true) {
        true: score += 1;
    }

    console::Print($"Non-exhaustive statement match: ${score}");
    return 0;
}
